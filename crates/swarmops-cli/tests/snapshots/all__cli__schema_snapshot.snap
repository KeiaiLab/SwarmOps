      },
      "required": [
        "name",
        "target",
        "version"
      ],
      "title": "RefOut",
      "type": "object"
    },
    "RefSetReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref set`: move a ref, or create one, by compare-and-swap. Give exactly one of\n`expected_old` and `create`; both or neither is `E_INVALID_ARG`.",
      "oneOf": [
        {
          "properties": {
            "create": {
              "const": false
            },
            "expected_old": {
              "type": "string"
            }
          },
          "required": [
            "expected_old"
          ]
        },
        {
          "properties": {
            "create": {
              "const": true
            },
            "expected_old": {
              "type": "null"
            }
          },
          "required": [
            "create"
          ]
        }
      ],
      "properties": {
        "create": {
          "default": false,
          "description": "To create the ref. If it exists at another target, the move fails with `E_CAS_MISMATCH`;\nif it already holds `new`, nothing is written and the response is a replay\n(`already_applied`). Give this or `expected_old`, not both.",
          "type": "boolean"
        },
        "expected_old": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "To move an existing ref: the target the caller last saw, by its full changeset id; if the\nref holds another, the move fails with `E_CAS_MISMATCH`. A ref name or a relative\nrevision is read from the store when the move runs instead of pinning the id the caller\nread: the ref's own name always matches, so the compare-and-swap protects nothing, and\n`main~1` on `main` never matches. An id prefix pins the id the caller read only until\nanother changeset shares it; then it is `E_AMBIGUOUS_ID`. `swarmops mcp` refuses all\nthree (`E_INVALID_ARG`), and the CLI's `--expect` help warns against them. Give this or\n`create`, not both."
        },
        "name": {
          "description": "The ref: `main` or `release/<name>`.",
          "type": "string"
        },
        "new": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to point it at."
        }
      },
      "required": [
        "name",
        "new"
      ],
      "title": "RefSetReq",
      "type": "object"
    },
    "RefSetResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref set` and `ref delete`: the move that was made.",
      "properties": {
        "already_applied": {
          "description": "The ref was already in the requested state, so nothing changed and a replay is safe;\n`old` and `new` are then the request's `expected_old` and `new`, resolved to full ids.",
          "type": "boolean"
        },
        "name": {
          "description": "The ref.",
          "type": "string"
        },
        "new": {
          "description": "Its target after; omitted when the ref was deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "old": {
          "description": "What the ref held before a move that was applied. On a replay (`already_applied`) it is\n`expected_old` as resolved, which the ref need not have held; omitted when `create` was\ngiven.",
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "description": "Problems found after the move became durable, such as failed housekeeping; the move\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "already_applied"
      ],
      "title": "RefSetResp",
      "type": "object"
    },
    "RemoteAddReq": {
      "$defs": {
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
            {
              "const": "gitlinks",
              "description": "A submodule's entry (git mode 160000): dropped.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
              "type": "string"
            },
            {
              "const": "modes",
              "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
              "type": "string"
            },
            {
              "const": "tree_order",
              "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
              "type": "string"
            },
            {
              "const": "empty_trees",
              "description": "An entry naming an empty tree: dropped.",
              "type": "string"
            },
            {
              "const": "nonstandard",
              "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`remote add`: record a git remote in the store. It needs no identity: it writes the store's\nremote configuration and its mirror, no store object.",
      "properties": {
        "branch": {
          "description": "The remote branch `main` follows; by default the remote's default branch, which asks\nthe remote (a network call).",
          "type": [
            "string",
            "null"
          ]
        },
        "lossy": {
          "default": [],
          "description": "The classes of content the import of this remote's commits may drop or normalize.",
          "items": {
            "$ref": "#/$defs/LossyClass"
          },
          "type": "array"
        },
        "name": {
          "description": "The remote's name: lowercase letters, digits, `.`, `_` and `-`, 1 to 63 of them,\nstarting with a letter or a digit, not ending in `.`, and not `status`.",
          "type": "string"
        },
        "token_env": {
          "description": "The environment variable that holds a token for the remote, by its name.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The remote's URL, as a clone's `url` is.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "RemoteAddReq",
      "type": "object"
    },
    "RemoteHead": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A remote branch's head: its commit, and the changeset that commit is in the store.",
      "properties": {
        "changeset": {
          "description": "The changeset id of that commit in the store.",
          "type": "string"
        },
        "sha": {
          "description": "The commit's git id, 40 lowercase hex digits.",
          "type": "string"
        }
      },
      "required": [
        "sha",
        "changeset"
      ],
      "title": "RemoteHead",
      "type": "object"
    },
    "RemoteInfo": {
      "$defs": {
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
            {
              "const": "gitlinks",
              "description": "A submodule's entry (git mode 160000): dropped.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
              "type": "string"
            },
            {
              "const": "modes",
              "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
              "type": "string"
            },
            {
              "const": "tree_order",
              "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
              "type": "string"
            },
            {
              "const": "empty_trees",
              "description": "An entry naming an empty tree: dropped.",
              "type": "string"
            },
            {
              "const": "nonstandard",
              "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A remote the store records.",
      "properties": {
        "branch": {
          "description": "The remote branch `main` follows.",
          "type": "string"
        },
        "lossy": {
          "description": "The classes of content the import of this remote's commits may drop or normalize.",
          "items": {
            "$ref": "#/$defs/LossyClass"
          },
          "type": "array"
        },
        "name": {
          "description": "The remote's name.",
          "type": "string"
        },
        "token_env": {
          "description": "The environment variable that holds a token for the remote, by its name; omitted when\nthe remote names none.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The remote's URL, as it was given.",
          "type": "string"
        },
        "warnings": {
          "description": "What adding the remote has to say that did not stop it, such as\n`default_branch_unknown` (the remote named no default branch, so `branch` is `main`).\nOmitted when there is nothing.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "url",
        "branch",
        "lossy"
      ],
      "title": "RemoteInfo",
      "type": "object"
    },
    "RemoteList": {
      "$defs": {
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
