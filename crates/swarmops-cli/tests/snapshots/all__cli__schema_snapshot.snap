            "title"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`path_history` (CLI `history`): a page of a path's history, newest first.",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page continues. Opaque: pass it back as given, as the\nnext request's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "description": "The changesets that changed what it holds.",
          "items": {
            "$ref": "#/$defs/PathHistoryEntry"
          },
          "type": "array"
        },
        "path": {
          "description": "The path, without a trailing `/`.",
          "type": "string"
        },
        "truncated": {
          "description": "Whether an older changeset that changed it follows this page.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "entries",
        "truncated"
      ],
      "title": "PathHistoryPage",
      "type": "object"
    },
    "PathHistoryReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`path_history` (CLI `history`): the changesets that changed what a path holds, newest first,\nfollowing first parents, a page at a time.",
      "properties": {
        "cursor": {
          "description": "Resume a history: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page continues from the first parent of the\nchangeset it names, and `rev` is not used.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "The repository path: a file, whose history is that of its content and kind, or a\ndirectory, whose history is that of everything below it. One trailing `/` is taken.",
          "type": "string"
        },
        "rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to start; `main` when omitted."
        }
      },
      "required": [
        "path"
      ],
      "title": "PathHistoryReq",
      "type": "object"
    },
    "PublishedChange": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "An unpublished change a sync landed onto the remote's head.",
      "properties": {
        "changeset": {
          "description": "The change as `main` held it.",
          "type": "string"
        },
        "landed_as": {
          "description": "The changeset it was landed as, on the remote's head.",
          "type": "string"
        },
        "sha": {
          "description": "The commit `landed_as` exports to.",
          "type": "string"
        }
      },
      "required": [
        "changeset",
        "landed_as",
        "sha"
      ],
      "title": "PublishedChange",
      "type": "object"
    },
    "PushReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`push`: send a store ref to a remote branch by compare-and-swap, never forcing: the remote\nmoves only from the head the last fetch saw to a descendant of it. A push is an export, so\nit needs no identity.",
      "properties": {
        "branch": {
          "description": "The remote branch; by default the remote's followed branch for `main`, and the same\nname for `release/<name>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        },
        "source_ref": {
          "default": "main",
          "description": "The store ref to send: `main` (the default) or `release/<name>`.",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "title": "PushReq",
      "type": "object"
    },
    "PushResp": {
      "$defs": {
        "PushStatus": {
          "description": "What a push did to the remote branch.",
          "oneOf": [
            {
              "const": "pushed",
              "description": "The branch moved to the export of the ref's head.",
              "type": "string"
            },
            {
              "const": "up_to_date",
              "description": "The branch named it already: nothing was sent.",
              "type": "string"
            },
            {
              "const": "created",
              "description": "The branch did not exist, and the push created it.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`push`: where the remote branch stands.",
      "properties": {
        "branch": {
          "description": "The remote branch.",
          "type": "string"
        },
        "head_changeset": {
          "description": "The changeset at the store ref's head.",
          "type": "string"
        },
        "new": {
          "description": "The commit the branch names now: the export of `head_changeset`.",
          "type": "string"
        },
        "objects_written": {
          "description": "How many git objects the push's export wrote into the mirror.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old": {
          "description": "The commit the branch named before; omitted when it did not exist.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        },
        "rewritten": {
          "description": "How many of the exported commits have another id than the commit they were imported\nfrom, as `git export`'s `rewritten`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PushStatus",
          "description": "What the push did."
        },
        "warnings": {
          "description": "What the push has to say that did not stop it. Omitted when there is nothing.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "remote",
        "branch",
        "status",
        "new",
        "head_changeset",
        "objects_written",
        "rewritten"
      ],
      "title": "PushResp",
      "type": "object"
    },
    "PushStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a push did to the remote branch.",
      "oneOf": [
        {
          "const": "pushed",
          "description": "The branch moved to the export of the ref's head.",
          "type": "string"
        },
        {
          "const": "up_to_date",
          "description": "The branch named it already: nothing was sent.",
          "type": "string"
        },
        {
          "const": "created",
          "description": "The branch did not exist, and the push created it.",
          "type": "string"
        }
      ],
      "title": "PushStatus"
    },
    "ReadFileReq": {
      "$defs": {
        "LineRange": {
          "description": "A range of a file's lines, numbered from 1: `first` to `last`, both included.",
          "properties": {
            "first": {
              "description": "The range's first line: at least 1.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "last": {
              "description": "The range's last line: at least `first`.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_file` (CLI `cat`): read one file at a revision, without a checkout: from an offset, or\na range of its lines.",
      "properties": {
        "lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "Read these lines instead, numbered from 1, both ends included: a line ends after its\nnewline, and a last line without one is a line too. The lines of the range that exist\ncome back, none past the file's last. Give this or `offset`, not both (`E_INVALID_ARG`)."
        },
        "max_bytes": {
          "default": 1048576,
          "description": "The most content bytes to return: at least 1 (0 is `E_INVALID_ARG`); more comes back\ntruncated, with the `next_offset` to read on from.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Where to start reading, in bytes from the file's start: a truncated read's `next_offset`\nreads on from where it stopped. An offset past the end gives empty content. Give this or\n`lines`, not both (`E_INVALID_ARG`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "The file's repository path.",
          "type": "string"
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to read at."
        }
      },
      "required": [
        "rev",
        "path"
      ],
      "title": "ReadFileReq",
      "type": "object"
    },
    "ReadTreeReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_tree` (CLI `ls`): list one directory at a revision, without a checkout, a page at a\ntime; with `depth`, the directories below it too.",
      "properties": {
        "cursor": {
          "description": "Resume a listing: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page starts after the entry it names. It pins no\nrevision: list at the full id the first page resolved (the envelope's `meta.resolved`), or\na ref that moved since lists another tree, with no error.",
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "default": 1,
          "description": "How many levels to list: 1 for the directory's own entries, 2 for theirs too, and so on, up\nto 64 (0 or more than 64 is `E_INVALID_ARG`).",
          "format": "uint32",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "limit": {
          "default": 250,
          "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "The directory's repository path; omitted for the root.",
          "type": [
            "string",
            "null"
          ]
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to read at."
        }
      },
      "required": [
        "rev"
      ],
      "title": "ReadTreeReq",
      "type": "object"
    },
    "RebaseReq": {
      "$defs": {
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "ResolutionInput": {
          "description": "What a land makes of one path, and of every path below it: exactly one of `take`, `content`\nand `delete` (anything else is `E_INVALID_ARG`, a rule the server checks), the rest of the\nmerge as it merged.",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One file of new content, given as a commit's change gives it (inline, base64, a client\nfile, or a stored blob by id), within a commit's limits; nothing below it."
            },
            "delete": {
              "description": "Nothing there: no file at the path, nor below it.",
              "type": "boolean"
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModeInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The kind of the file `content` makes, only beside it; when omitted, the kind of the file\nours holds there, else theirs', else a regular file."
            },
            "take": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Side"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What one side holds there: `ours`, the change's head, or `theirs`, the target's head."
            }
          },
          "type": "object"
        },
        "ResolutionsInput": {
          "description": "A land's resolutions (`land --resolve`): what to make of some paths of the merge of the change\nonto the target, decided against one of the target's heads.",
          "properties": {
            "against": {
              "$ref": "#/$defs/Rev",
              "description": "The target's head the resolutions were decided against: the conflict report's `theirs`,\nby its full 64-hex id. A resolution applies while the target holds its path as this\nchangeset does (the same file, the same directory, or nothing)."
            },
            "files": {
              "additionalProperties": {
                "$ref": "#/$defs/ResolutionInput"
              },
              "description": "What to make of each path, by its repository path.",
              "type": "object"
            }
          },
          "required": [
            "against",
            "files"
          ],
          "type": "object"
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        },
        "Side": {
          "description": "One side of a land's merge.",
          "oneOf": [
            {
              "const": "ours",
              "description": "The change: its head.",
              "type": "string"
            },
            {
              "const": "theirs",
              "description": "The target: its head when the land merges.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`rebase` (M5): merge a change three-way onto a ref's head and record the result as one\nchangeset whose parent is that head, moving no ref. The merge, its conflicts and its\nresolutions are a land's (operations spec §3): a conflict is the error `E_CONFLICT`, with the\nreport in `details.report`, and nothing is recorded then.",
      "properties": {
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the change starts, as a land's `base`: a first-parent ancestor of `head`; when\nomitted, the merge base of `head` and the head of `onto`."
        },
        "head": {
          "$ref": "#/$defs/Rev",
          "description": "The changeset to rebase: the change's head."
        },
        "idempotency_key": {
          "description": "Makes a retry safe: a uuid v7, as a commit's key. The same request on the same head of\n`onto` is the same changeset, replayed without writing.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_conflict_bytes": {
          "default": 32768,
          "description": "The most bytes of hunk text an `E_CONFLICT` report carries, as a land's.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "description": "The recorded changeset's message; `head`'s when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "onto": {
          "default": "main",
          "description": "The ref to rebase onto: `main` or `release/<name>`, which must exist.",
          "type": "string"
        },
        "resolutions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionsInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "What to make of the paths a conflict report named, as a land's resolutions."
        }
      },
      "required": [
        "head"
      ],
      "title": "RebaseReq",
      "type": "object"
    },
    "RebaseResp": {
      "$defs": {
        "RebaseStatus": {
          "description": "How a rebase ended.",
          "oneOf": [
            {
              "const": "rebased",
              "description": "This request recorded the merged changeset.",
              "type": "string"
            },
            {
              "const": "replayed",
              "description": "The same keyed request had recorded it already; nothing was written.",
              "type": "string"
            },
            {
              "const": "up_to_date",
              "description": "The change already sits on the ref's head; nothing was written.",
              "type": "string"
            },
            {
              "const": "absorbed",
              "description": "The ref's head holds the change already; nothing was written.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`rebase`: the changeset that holds the change merged onto the ref's head. Ids are full.",
      "properties": {
        "auto_merged": {
          "description": "The paths both sides changed whose contents merged cleanly into a content neither side\nhad. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "base": {
          "description": "The changeset the change was taken from.",
          "type": "string"
        },
        "changeset": {
          "description": "The changeset that holds the result: the recorded one, `head` when it is up to date, the\nref's head when the change was absorbed.",
          "type": "string"
        },
        "files_changed": {
          "description": "How many paths `changeset` changes against `onto`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "onto": {
          "description": "The ref's head the change was merged onto: `changeset`'s parent when one was recorded.",
          "type": "string"
        },
        "root": {
          "description": "The root tree of `changeset`.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RebaseStatus",
          "description": "How the rebase ended."
        }
      },
      "required": [
        "status",
        "changeset",
        "root",
        "onto",
        "base",
        "files_changed"
      ],
      "title": "RebaseResp",
      "type": "object"
    },
    "RebaseStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How a rebase ended.",
      "oneOf": [
        {
          "const": "rebased",
          "description": "This request recorded the merged changeset.",
          "type": "string"
        },
        {
          "const": "replayed",
          "description": "The same keyed request had recorded it already; nothing was written.",
          "type": "string"
        },
        {
          "const": "up_to_date",
          "description": "The change already sits on the ref's head; nothing was written.",
          "type": "string"
        },
        {
          "const": "absorbed",
          "description": "The ref's head holds the change already; nothing was written.",
          "type": "string"
        }
      ],
      "title": "RebaseStatus"
    },
    "RecoveredOut": {
      "$defs": {
        "LogCutOut": {
          "description": "Where the journal was cut (`meta.recovered.log_cut`).",
          "properties": {
            "at": {
              "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "How many bytes were cut, to where the journal ended.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "at",
            "bytes"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a write's recovery repaired (`meta.recovered`), as offsets and counts in the store's\nmetadata files, with no paths: the storage spec (§2 rule 3, §3) says what each repair is.",
      "properties": {
        "frames_listed": {
          "description": "The journal frames listed that their writer never listed: transactions that committed,\ntheir writer having crashed between the frame's sync and its listing, or failed to list\nit (a warning then); and frames listed again whose entries a power loss zeroed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frames_rewritten": {
          "description": "Of those, the frames written to the journal afresh first, because the sync that would\nhave made them durable failed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "index_records_dropped": {
          "description": "The changeset index records cut, counted in its longest column: records a crash left torn,\nor a power loss emptied.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "log_cut": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogCutOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "The torn tail cut off the end of the journal, if there was one: the bytes of a transaction\nthat never reached its commit point; omitted when nothing was cut."
        },
        "off_bytes_dropped": {
          "description": "The bytes dropped from the end of the journal's list of frames: part of an entry, or\nentries a power loss zeroed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "records_replayed": {
          "description": "The changesets replayed from the journal into the index.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "refs_replayed": {
          "description": "The ref files replayed from the journal: replaced, or removed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "views_rebuilt": {
          "description": "Whether a compaction of the changeset index that a crash interrupted was finished.",
          "type": "boolean"
        }
      },
      "required": [
        "frames_listed",
        "frames_rewritten",
        "off_bytes_dropped",
        "index_records_dropped",
        "views_rebuilt",
        "records_replayed",
        "refs_replayed"
      ],
      "title": "RecoveredOut",
      "type": "object"
    },
    "RefDeleteReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref delete`: remove a ref by compare-and-swap. `main` is never deleted\n(`E_REF_PROTECTED`).",
      "properties": {
        "expected_old": {
          "$ref": "#/$defs/Rev",
          "description": "The target the caller last saw, by its full changeset id; if the ref holds another, the\ndelete fails with `E_CAS_MISMATCH`. A ref name or a relative revision is read from the\nstore when the delete runs instead of pinning the id the caller read: the ref's own name\nalways matches, so the compare-and-swap protects nothing, and `main~1` on `main` never\nmatches. An id prefix pins the id the caller read only until another changeset shares\nit; then it is `E_AMBIGUOUS_ID`. `swarmops mcp` refuses all three (`E_INVALID_ARG`), and\nthe CLI's `--expect` help warns against them."
        },
        "name": {
          "description": "The ref.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "expected_old"
      ],
      "title": "RefDeleteReq",
      "type": "object"
    },
    "RefKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a ref's name names.",
      "oneOf": [
        {
          "const": "main",
          "description": "`main`.",
          "type": "string"
        },
        {
          "const": "release",
          "description": "`release/<name>`.",
          "type": "string"
        },
        {
          "const": "branch",
          "description": "A free-form branch (FORMAT 2).",
          "type": "string"
        },
        {
          "const": "tag",
          "description": "`tags/<path>`: created and deleted, never moved (FORMAT 2).",
          "type": "string"
        },
        {
          "const": "remote_tracking",
          "description": "`remote/<remote>/<path>`: a remote's ref as a fetch last saw it (FORMAT 2).",
          "type": "string"
        }
      ],
      "title": "RefKind"
    },
    "RefListReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref list`: list every ref, or those whose names start with a prefix.",
      "properties": {
        "prefix": {
          "description": "Only the refs whose names start with these bytes (`release/`, `tags/`); omitted for\nevery ref.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "RefListReq",
      "type": "object"
    },
    "RefListResp": {
      "$defs": {
        "RefKind": {
          "description": "What a ref's name names.",
          "oneOf": [
            {
              "const": "main",
              "description": "`main`.",
              "type": "string"
            },
            {
              "const": "release",
              "description": "`release/<name>`.",
              "type": "string"
            },
            {
              "const": "branch",
              "description": "A free-form branch (FORMAT 2).",
              "type": "string"
            },
            {
              "const": "tag",
              "description": "`tags/<path>`: created and deleted, never moved (FORMAT 2).",
              "type": "string"
            },
            {
              "const": "remote_tracking",
              "description": "`remote/<remote>/<path>`: a remote's ref as a fetch last saw it (FORMAT 2).",
              "type": "string"
            }
          ]
        },
        "RefOut": {
          "description": "One ref.",
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RefKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What its name names; omitted by stores older than this field."
            },
            "name": {
              "description": "Its name: `main`, `release/<name>`, or in a FORMAT 2 store a branch, `tags/<path>` or\n`remote/<remote>/<path>`.",
              "type": "string"
            },
            "target": {
              "description": "The changeset it points at.",
              "type": "string"
            },
            "version": {
              "description": "How many committed moves changed its target.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "name",
            "target",
            "version"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref list`: every ref.",
      "properties": {
        "refs": {
          "description": "The refs.",
          "items": {
            "$ref": "#/$defs/RefOut"
          },
          "type": "array"
        }
      },
      "required": [
        "refs"
      ],
      "title": "RefListResp",
      "type": "object"
    },
    "RefMoveOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A move of a ref, as the journal recorded it.",
      "properties": {
        "actor": {
          "description": "Who moved it.",
          "type": "string"
        },
        "at": {
          "description": "When it moved, in Unix seconds, as its writer recorded it.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "description": "The ref.",
          "type": "string"
        },
        "new": {
          "description": "What it names after; omitted for the move that deleted it.",
          "type": [
            "string",
            "null"
          ]
        },
        "old": {
          "description": "What it named before; omitted for the move that created it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "actor",
        "at"
      ],
      "title": "RefMoveOut",
      "type": "object"
    },
    "RefOut": {
      "$defs": {
        "RefKind": {
          "description": "What a ref's name names.",
          "oneOf": [
            {
              "const": "main",
              "description": "`main`.",
              "type": "string"
            },
            {
              "const": "release",
              "description": "`release/<name>`.",
              "type": "string"
            },
            {
              "const": "branch",
              "description": "A free-form branch (FORMAT 2).",
              "type": "string"
            },
            {
              "const": "tag",
              "description": "`tags/<path>`: created and deleted, never moved (FORMAT 2).",
              "type": "string"
            },
            {
              "const": "remote_tracking",
              "description": "`remote/<remote>/<path>`: a remote's ref as a fetch last saw it (FORMAT 2).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One ref.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "What its name names; omitted by stores older than this field."
        },
        "name": {
          "description": "Its name: `main`, `release/<name>`, or in a FORMAT 2 store a branch, `tags/<path>` or\n`remote/<remote>/<path>`.",
          "type": "string"
        },
        "target": {
          "description": "The changeset it points at.",
          "type": "string"
        },
        "version": {
          "description": "How many committed moves changed its target.",
