        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "The changeset to commit on top of. An explicit `parent` always wins; when it is omitted,\nthe current head of `main` is used if `main` exists, and otherwise the commit is a root\ncommit. `null` is the same as omitting it. Once `main` exists, this API cannot express a\nroot commit (a known M1 limitation)."
        }
