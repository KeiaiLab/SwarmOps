      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`remote list`: every remote, in the order they were added.",
      "properties": {
        "remotes": {
          "description": "The remotes; empty when the store has none.",
          "items": {
            "$ref": "#/$defs/RemoteInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "remotes"
      ],
      "title": "RemoteList",
