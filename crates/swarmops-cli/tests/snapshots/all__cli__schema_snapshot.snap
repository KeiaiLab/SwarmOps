      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`remote list`: the remotes the store records.",
      "title": "RemoteListReq",
      "type": "object"
    },
    "RemoteRemoveReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`remote remove`: forget a remote, and the mirror's refs of it. No changeset is removed.",
      "properties": {
        "name": {
          "description": "The remote's name.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "RemoteRemoveReq",
      "type": "object"
    },
    "RemoteRemoveResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`remote remove`: the remote forgotten.",
      "properties": {
        "name": {
          "description": "The remote's name.",
          "type": "string"
        },
        "removed_refs": {
          "description": "How many of the mirror's refs of the remote were removed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "removed_refs"
      ],
      "title": "RemoteRemoveResp",
      "type": "object"
    },
    "RepairAction": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`repair`: one thing it did, or would do.",
      "properties": {
        "done": {
          "description": "Whether it was done: `false` for a dry run.",
          "type": "boolean"
        },
        "kind": {
          "description": "`rebuild_offsets`, `rebuild_index`, `rebuild_ref`, `quarantine_object`, `drop_derived`\nor `drop_external_id`. A string, so that a client can read kinds newer than its own list.",
          "type": "string"
        },
        "target": {
          "description": "On what: an object id, a ref name or a file class; never a path.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "done"
      ],
      "title": "RepairAction",
      "type": "object"
    },
    "RepairReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`repair`: rebuild what the journal can rebuild (`journal.off`, the index, the ref files),\nquarantine damaged objects and drop damaged cache entries. It never cuts the journal.",
      "properties": {
        "dry_run": {
          "default": false,
          "description": "List what it would do, each with `done: false`, and write nothing.",
          "type": "boolean"
        }
      },
      "title": "RepairReq",
      "type": "object"
    },
    "RepairResp": {
      "$defs": {
        "RepairAction": {
          "description": "`repair`: one thing it did, or would do.",
          "properties": {
            "done": {
              "description": "Whether it was done: `false` for a dry run.",
              "type": "boolean"
            },
            "kind": {
              "description": "`rebuild_offsets`, `rebuild_index`, `rebuild_ref`, `quarantine_object`, `drop_derived`\nor `drop_external_id`. A string, so that a client can read kinds newer than its own list.",
              "type": "string"
            },
            "target": {
              "description": "On what: an object id, a ref name or a file class; never a path.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "target",
            "done"
          ],
          "type": "object"
        },
        "VerifySummary": {
          "description": "What a verify found, in counts: `repair`'s `after`.",
          "properties": {
            "changesets_checked": {
              "description": "How many changesets were checked.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "found": {
              "description": "How many problems were found; 0 for a sound store.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "objects_checked": {
              "description": "How many objects were checked.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "objects_checked",
            "changesets_checked",
            "found"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`repair`: what it did, and what a verify after it found.",
      "properties": {
        "actions": {
          "description": "What it did, or would do, in order.",
          "items": {
            "$ref": "#/$defs/RepairAction"
          },
          "type": "array"
        },
        "after": {
          "$ref": "#/$defs/VerifySummary",
          "description": "The verify after it."
        }
      },
      "required": [
        "actions",
        "after"
      ],
      "title": "RepairResp",
      "type": "object"
    },
    "RepoInfo": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`init` and `info`: what the store is and holds.",
      "properties": {
        "changesets": {
          "description": "How many changesets the store holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "main": {
          "description": "The changeset `main` points at; omitted until `main` exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The name given at `init`.",
          "type": "string"
        },
        "refs": {
          "description": "How many refs the store holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repo_id": {
          "description": "The store's id, fixed at `init`.",
          "type": "string"
        },
        "store_version": {
          "description": "The store format version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "repo_id",
        "name",
        "store_version",
        "changesets",
        "refs"
      ],
      "title": "RepoInfo",
      "type": "object"
    },
    "ResolutionInput": {
      "$defs": {
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "Side": {
          "description": "One side of a land's merge.",
          "oneOf": [
            {
              "const": "ours",
              "description": "The change: its head.",
              "type": "string"
            },
            {
              "const": "theirs",
              "description": "The target: its head when the land merges.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a land makes of one path, and of every path below it: exactly one of `take`, `content`\nand `delete` (anything else is `E_INVALID_ARG`, a rule the server checks), the rest of the\nmerge as it merged.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "One file of new content, given as a commit's change gives it (inline, base64, a client\nfile, or a stored blob by id), within a commit's limits; nothing below it."
        },
        "delete": {
          "description": "Nothing there: no file at the path, nor below it.",
          "type": "boolean"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "The kind of the file `content` makes, only beside it; when omitted, the kind of the file\nours holds there, else theirs', else a regular file."
        },
        "take": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "description": "What one side holds there: `ours`, the change's head, or `theirs`, the target's head."
        }
      },
      "title": "ResolutionInput",
      "type": "object"
    },
    "ResolutionsInput": {
      "$defs": {
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "ResolutionInput": {
          "description": "What a land makes of one path, and of every path below it: exactly one of `take`, `content`\nand `delete` (anything else is `E_INVALID_ARG`, a rule the server checks), the rest of the\nmerge as it merged.",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One file of new content, given as a commit's change gives it (inline, base64, a client\nfile, or a stored blob by id), within a commit's limits; nothing below it."
            },
            "delete": {
              "description": "Nothing there: no file at the path, nor below it.",
              "type": "boolean"
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModeInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The kind of the file `content` makes, only beside it; when omitted, the kind of the file\nours holds there, else theirs', else a regular file."
            },
            "take": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Side"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What one side holds there: `ours`, the change's head, or `theirs`, the target's head."
            }
          },
          "type": "object"
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        },
        "Side": {
          "description": "One side of a land's merge.",
          "oneOf": [
            {
              "const": "ours",
              "description": "The change: its head.",
              "type": "string"
            },
            {
              "const": "theirs",
              "description": "The target: its head when the land merges.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A land's resolutions (`land --resolve`): what to make of some paths of the merge of the change\nonto the target, decided against one of the target's heads.",
      "properties": {
        "against": {
          "$ref": "#/$defs/Rev",
          "description": "The target's head the resolutions were decided against: the conflict report's `theirs`,\nby its full 64-hex id. A resolution applies while the target holds its path as this\nchangeset does (the same file, the same directory, or nothing)."
        },
        "files": {
          "additionalProperties": {
            "$ref": "#/$defs/ResolutionInput"
          },
          "description": "What to make of each path, by its repository path.",
          "type": "object"
        }
      },
      "required": [
        "against",
        "files"
      ],
      "title": "ResolutionsInput",
      "type": "object"
    },
    "ResolveRevReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`resolve_rev` (CLI `resolve`): the changeset a revision names, as every operation resolves it.",
      "properties": {
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to resolve."
        }
      },
      "required": [
        "rev"
      ],
      "title": "ResolveRevReq",
      "type": "object"
    },
    "ResolvedRev": {
      "$defs": {
        "RevKind": {
          "description": "What kind of revision `resolve_rev` resolved.",
          "oneOf": [
            {
              "const": "ref",
              "description": "Exactly a ref's name (`main`, `release/<name>`): `id` is what the ref names now, and moves\nwhen the ref does.",
              "type": "string"
            },
            {
              "const": "changeset",
              "description": "Any other revision: a full changeset id, a unique prefix of one, or a revision followed by\n`~N` suffixes, a ref's name among them.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`resolve_rev` (CLI `resolve`): the changeset a revision names, and what kind of revision it is.",
      "properties": {
        "id": {
          "description": "The full id of the changeset the revision names.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RevKind",
          "description": "What the revision is: `ref` when it is exactly a ref's name, `changeset` otherwise."
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ResolvedRev",
      "type": "object"
    },
    "Rev": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
      "title": "Rev",
      "type": "string"
    },
    "RevKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What kind of revision `resolve_rev` resolved.",
      "oneOf": [
        {
          "const": "ref",
          "description": "Exactly a ref's name (`main`, `release/<name>`): `id` is what the ref names now, and moves\nwhen the ref does.",
          "type": "string"
        },
        {
          "const": "changeset",
          "description": "Any other revision: a full changeset id, a unique prefix of one, or a revision followed by\n`~N` suffixes, a ref's name among them.",
          "type": "string"
        }
      ],
      "title": "RevKind"
    },
    "ShowReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`show`: one changeset in full.",
      "properties": {
        "max_changes": {
          "default": 400,
          "description": "The most entries of `changes` to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The changeset to show."
        }
      },
      "required": [
        "rev"
      ],
      "title": "ShowReq",
      "type": "object"
    },
    "Side": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One side of a land's merge.",
      "oneOf": [
        {
          "const": "ours",
          "description": "The change: its head.",
          "type": "string"
        },
        {
          "const": "theirs",
          "description": "The target: its head when the land merges.",
          "type": "string"
        }
      ],
      "title": "Side"
    },
    "SignatureOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A git signature: who, and when.",
      "properties": {
        "email": {
          "description": "The email.",
          "type": "string"
        },
        "name": {
          "description": "The name; the agent name for a native changeset.",
          "type": "string"
        },
        "offset_secs": {
          "description": "The UTC offset in seconds.",
          "format": "int32",
          "type": "integer"
        },
        "secs": {
          "description": "Unix time in seconds.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "email",
        "secs",
        "offset_secs"
      ],
      "title": "SignatureOut",
      "type": "object"
    },
    "Signatures": {
      "$defs": {
        "SignatureOut": {
          "description": "A git signature: who, and when.",
          "properties": {
            "email": {
              "description": "The email.",
              "type": "string"
            },
            "name": {
              "description": "The name; the agent name for a native changeset.",
              "type": "string"
            },
            "offset_secs": {
              "description": "The UTC offset in seconds.",
              "format": "int32",
              "type": "integer"
            },
            "secs": {
              "description": "Unix time in seconds.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "name",
            "email",
            "secs",
            "offset_secs"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A changeset's git signatures: git-fidelity data for import and export.",
      "properties": {
        "author": {
          "$ref": "#/$defs/SignatureOut",
          "description": "The git author."
        },
        "committer": {
          "$ref": "#/$defs/SignatureOut",
          "description": "The git committer; its time is `created_at`."
        }
      },
      "required": [
        "author",
        "committer"
      ],
      "title": "Signatures",
      "type": "object"
    },
    "StatusAfter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Whether a workspace mutation's response carries the workspace's status after it.",
      "oneOf": [
        {
          "const": "page",
          "description": "The first page of the status, up to 100 changes.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No status.",
          "type": "string"
        }
      ],
      "title": "StatusAfter"
    },
    "SyncMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Whether `sync` sends what it landed.",
      "oneOf": [
        {
          "const": "publish",
          "description": "Land onto the remote's head, move `main`, and push it.",
          "type": "string"
        },
        {
          "const": "local",
          "description": "The same without the push: for a branch that takes pull requests only.",
          "type": "string"
        }
      ],
      "title": "SyncMode"
    },
    "SyncReq": {
      "$defs": {
        "SyncMode": {
          "description": "Whether `sync` sends what it landed.",
          "oneOf": [
            {
              "const": "publish",
              "description": "Land onto the remote's head, move `main`, and push it.",
              "type": "string"
            },
            {
              "const": "local",
              "description": "The same without the push: for a branch that takes pull requests only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`sync`: fetch a remote, land `main`'s unpublished changes onto the remote's head, move\n`main` there and push it. It moves `main`, so it needs an identity.",
      "properties": {
        "max_attempts": {
          "default": 8,
          "description": "How many times to fetch and land again when the remote or `main` moved meanwhile: 1 to\n32.",
          "format": "uint32",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/SyncMode",
          "default": "publish",
          "description": "`publish` (the default) pushes; `local` stops before the push."
        },
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "title": "SyncReq",
      "type": "object"
    },
    "SyncResp": {
      "$defs": {
        "DropReason": {
          "description": "How a sync found that the remote holds a change already.",
          "oneOf": [
            {
              "const": "trailer",
              "description": "A commit the remote's head reaches names it in a `SwarmOps-Changeset`,\n`SwarmOps-Squashed-From` or `SwarmOps-Land-Key` line.",
              "type": "string"
            },
            {
              "const": "no_op",
              "description": "It merges onto the remote's head as no change.",
              "type": "string"
            }
          ]
        },
        "DroppedChange": {
          "description": "An unpublished change a sync dropped, since the remote holds it already. It stays in the\nstore; `main` moves only forward, so to bring it back there, land a change that restores it.",
          "properties": {
            "by": {
              "$ref": "#/$defs/DropReason",
              "description": "How the sync found it on the remote."
            },
            "changeset": {
              "description": "The change.",
              "type": "string"
            }
          },
          "required": [
            "changeset",
            "by"
          ],
          "type": "object"
        },
        "HeadMove": {
          "description": "A head before and after a sync.",
          "properties": {
            "new": {
              "description": "What it names now.",
              "type": "string"
            },
            "old": {
              "description": "What it named before; omitted when it did not exist.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "new"
          ],
          "type": "object"
        },
        "PublishedChange": {
          "description": "An unpublished change a sync landed onto the remote's head.",
          "properties": {
            "changeset": {
              "description": "The change as `main` held it.",
              "type": "string"
            },
            "landed_as": {
              "description": "The changeset it was landed as, on the remote's head.",
              "type": "string"
            },
            "sha": {
              "description": "The commit `landed_as` exports to.",
              "type": "string"
            }
          },
          "required": [
            "changeset",
            "landed_as",
            "sha"
          ],
          "type": "object"
        },
        "SyncStatusKind": {
          "description": "What a sync did.",
          "oneOf": [
            {
              "const": "up_to_date",
              "description": "`main` and the remote held the same: nothing moved.",
              "type": "string"
            },
            {
              "const": "pushed",
              "description": "The landed changes were pushed.",
              "type": "string"
            },
            {
              "const": "fast_forwarded",
              "description": "`main` had nothing unpublished and moved to the remote's head.",
              "type": "string"
            },
            {
              "const": "landed_locally",
              "description": "`main` moved onto the remote's head and nothing was pushed (`mode: local`).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`sync`: what it landed, dropped and sent, and where `main` and the remote stand.",
      "properties": {
        "attempts": {
          "description": "How many attempts it took.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "description": "The followed branch.",
          "type": "string"
        },
        "dropped": {
          "description": "The changes the remote held already.",
          "items": {
            "$ref": "#/$defs/DroppedChange"
          },
          "type": "array"
        },
        "main": {
          "$ref": "#/$defs/HeadMove",
          "description": "`main`'s changeset before and after."
        },
        "published": {
          "description": "The changes landed onto the remote's head, oldest first.",
          "items": {
            "$ref": "#/$defs/PublishedChange"
          },
          "type": "array"
        },
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        },
        "remote_head": {
          "$ref": "#/$defs/HeadMove",
          "description": "The remote branch's commit before and after."
        },
        "status": {
          "$ref": "#/$defs/SyncStatusKind",
          "description": "What the sync did."
        },
        "warnings": {
          "description": "What the sync has to say that did not stop it. Omitted when there is nothing.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "remote",
        "branch",
        "status",
        "attempts",
        "published",
        "dropped",
        "main",
        "remote_head"
      ],
      "title": "SyncResp",
      "type": "object"
    },
    "SyncStatus": {
      "$defs": {
        "ChangesetSummary": {
          "description": "One changeset of a log.",
          "properties": {
            "author_agent": {
              "description": "The agent that wrote it, as `show` gives `author.agent`.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "The changeset's id.",
              "type": "string"
            },
            "parents": {
              "description": "The parents' ids, mainline parent first.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "description": "The message's first line.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "parents",
            "author_agent",
            "created_at",
            "title"
          ],
          "type": "object"
        },
        "RemoteHead": {
          "description": "A remote branch's head: its commit, and the changeset that commit is in the store.",
          "properties": {
            "changeset": {
              "description": "The changeset id of that commit in the store.",
              "type": "string"
            },
            "sha": {
              "description": "The commit's git id, 40 lowercase hex digits.",
              "type": "string"
            }
          },
          "required": [
            "sha",
            "changeset"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`sync status`: what is unpublished, and how far behind `main` is.",
      "properties": {
        "ahead": {
          "description": "How many changes on `main` are above the base: unpublished.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "base": {
          "description": "The newest changeset on `main`'s first-parent chain that the remote's head reaches;\nomitted when there is none.",
          "type": [
            "string",
            "null"
          ]
        },
        "behind": {
          "description": "How many changesets on the remote's first-parent chain are above the base.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "description": "The followed branch.",
          "type": "string"
        },
        "fetched": {
          "description": "Whether a fetch ever saw the followed branch.",
          "type": "boolean"
        },
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        },
        "remote_head": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteHead"
            },
            {
              "type": "null"
            }
          ],
          "description": "The followed branch's head as the last fetch saw it; omitted when none did."
        },
        "truncated": {
          "description": "Whether a count or the list stopped at its bound.",
          "type": "boolean"
        },
        "unpublished": {
          "description": "The unpublished changes, newest first, at most `limit`.",
          "items": {
            "$ref": "#/$defs/ChangesetSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "remote",
        "branch",
        "fetched",
        "ahead",
        "behind",
        "unpublished",
        "truncated"
      ],
      "title": "SyncStatus",
      "type": "object"
    },
    "SyncStatusKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a sync did.",
      "oneOf": [
        {
          "const": "up_to_date",
          "description": "`main` and the remote held the same: nothing moved.",
          "type": "string"
        },
        {
          "const": "pushed",
          "description": "The landed changes were pushed.",
          "type": "string"
        },
        {
          "const": "fast_forwarded",
          "description": "`main` had nothing unpublished and moved to the remote's head.",
          "type": "string"
        },
        {
          "const": "landed_locally",
          "description": "`main` moved onto the remote's head and nothing was pushed (`mode: local`).",
          "type": "string"
        }
      ],
      "title": "SyncStatusKind"
    },
    "SyncStatusReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`sync status`: how `main` and a remote's followed branch stand, as the last fetch saw the\nremote. It reads only the store and its mirror: no network, no lock.",
      "properties": {
        "limit": {
          "default": 50,
          "description": "The most unpublished changesets to list.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "title": "SyncStatusReq",
      "type": "object"
    },
    "TreeEntryOut": {
      "$defs": {
        "EntryKindOut": {
          "description": "What a tree entry is.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            },
            {
              "const": "dir",
              "description": "A directory.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One entry of a listing.",
      "properties": {
        "id": {
          "description": "A blob id for a file, an executable or a symlink; a tree id for a directory.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntryKindOut",
          "description": "What the entry is."
        },
        "name": {
          "description": "The entry's name: one path component.",
          "type": "string"
        },
        "path": {
          "description": "Its path below the listed directory, given when the request's `depth` is more than 1: its\nname, for one of the directory's own entries.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "For a file, an executable or a symlink: its content's size in bytes; omitted for a\ndirectory.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "id"
      ],
      "title": "TreeEntryOut",
      "type": "object"
    },
    "TreeListing": {
      "$defs": {
        "EntryKindOut": {
          "description": "What a tree entry is.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            },
            {
              "const": "dir",
              "description": "A directory.",
              "type": "string"
            }
          ]
        },
        "TreeEntryOut": {
          "description": "One entry of a listing.",
          "properties": {
            "id": {
              "description": "A blob id for a file, an executable or a symlink; a tree id for a directory.",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/EntryKindOut",
              "description": "What the entry is."
            },
            "name": {
              "description": "The entry's name: one path component.",
              "type": "string"
            },
            "path": {
              "description": "Its path below the listed directory, given when the request's `depth` is more than 1: its\nname, for one of the directory's own entries.",
              "type": [
                "string",
                "null"
              ]
            },
            "size": {
              "description": "For a file, an executable or a symlink: its content's size in bytes; omitted for a\ndirectory.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_tree` (CLI `ls`): a page of a directory's entries, in pre-order: a directory, then the\nentries below it to the request's `depth`, each directory's entries by name bytes (at `depth`\n1, the tree's order).",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page starts. Opaque: pass it back as given, as the next\nrequest's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "description": "The entries.",
          "items": {
            "$ref": "#/$defs/TreeEntryOut"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Whether more entries follow this page.",
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "truncated"
      ],
      "title": "TreeListing",
      "type": "object"
    },
    "UndoReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`undo` (CLI `op undo`): restore every ref an operation moved to what it named before, by\ncompare-and-swap, in one transaction: all of them or none. Changesets are never removed.",
      "properties": {
        "id": {
          "description": "The operation to undo: its `id` in the operation log, `<op>:<crc>` (`4:[crc]`). A bare\nnumber, upper case or any other form is `E_INVALID_ARG`; an id whose number is past the\nlast operation, or whose crc is not the frame's at that number, is `E_OP_NOT_FOUND`.",
          "pattern": "^[0-9]{1,20}:[0-9a-f]{8}$",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "UndoReq",
      "type": "object"
    },
    "UndoResp": {
      "$defs": {
        "RefMoveOut": {
          "description": "A move of a ref, as the journal recorded it.",
          "properties": {
            "actor": {
              "description": "Who moved it.",
              "type": "string"
            },
            "at": {
              "description": "When it moved, in Unix seconds, as its writer recorded it.",
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "The ref.",
              "type": "string"
            },
            "new": {
              "description": "What it names after; omitted for the move that deleted it.",
              "type": [
                "string",
                "null"
              ]
            },
            "old": {
              "description": "What it named before; omitted for the move that created it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "actor",
            "at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`undo` (CLI `op undo`): the moves that restored the refs.",
      "properties": {
        "already_applied": {
          "description": "Every ref the operation moved already names what it named before, so nothing was written:\nan undo run again is a replay, and safe.",
          "type": "boolean"
        },
        "id": {
          "description": "The id of the operation this undo recorded, which another undo takes; omitted exactly when\n`op` is.",
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "description": "The number of the operation this undo recorded; omitted when it wrote nothing\n(`already_applied`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ref_moves": {
          "description": "The moves it made: each ref from what the operation set back to what it named before.",
          "items": {
            "$ref": "#/$defs/RefMoveOut"
          },
          "type": "array"
        },
        "undone": {
          "description": "The operation undone.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "description": "Problems found after the undo became durable, such as failed housekeeping; the undo\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "undone",
        "ref_moves",
        "already_applied"
      ],
      "title": "UndoResp",
      "type": "object"
    },
    "UpgradeReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`upgrade`: move the store to the latest format this build writes. It cannot be undone:\nolder releases do not open the store afterwards.",
      "title": "UpgradeReq",
      "type": "object"
    },
    "UpgradeResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`upgrade`: the formats before and after.",
      "properties": {
        "from": {
          "description": "The format the store had.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "description": "The format it has now.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "upgraded": {
          "description": "Whether it changed: `false` for a store of the latest format already.",
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to",
        "upgraded"
      ],
      "title": "UpgradeResp",
      "type": "object"
    },
    "VerifyFinding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One problem `verify` found, as a program reads it: what kind of damage it is, and what it\nnames. The keys its kind does not use are omitted; the line at the same index of `problems`\nsays the same for a reader. Ids are lowercase hex.",
      "properties": {
        "cause": {
          "description": "What disagrees with the record (`index_mismatch`), which says what mends it: `journal`\n(rebuild the index from the journal), `sorted_view` (rebuild the sorted views from the\nindex columns) or `object` (derive the record from its object again).",
          "type": [
            "string",
            "null"
          ]
        },
        "changeset": {
          "description": "The changeset: the first, in seq order, that references the missing object\n(`missing_object`), the one that names a missing parent (`missing_parent`), the one whose\nroot is not its first parent's root with its delta applied (`root_mismatch`), the one\nan external id's entry names: not in the store (`external_id_dangling`), or with a\n`git.oid` that is another oid than the entry's key, or, found by a deep verify, with none\nand exporting to another commit (`external_id_mismatch`), or the one a derived value is\nabout (`derived_mismatch`).",
          "type": [
            "string",
            "null"
          ]
        },
        "derivation": {
          "description": "The derivation whose stored value is not the one the objects give: `first_parent_skip_list`,\n`last_modified`, or a git export oid memo `git_tree_oid`, `git_blob_oid` or `git_oid`, or\none of them under a memo key, `git_tree_oid_mac`, `git_blob_oid_mac` or `git_oid_mac`,\nwhose value, or under the store's key whose MAC, does not check (`derived_mismatch`, which\na deep verify finds; `git_oid` and `git_oid_mac` name their `changeset`, the tree and blob\nmemos their `object`). Removing the value's file under `meta/derived/<derivation>/`, or all\nof `meta/derived/`, has it derived again.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "The key, in lowercase hex: the external id whose entry it is, a git commit's oid for\nsystem `git` (`external_id_corrupt`, `external_id_dangling`, `external_id_mismatch`); or a\nderived value's key, its postcard bytes, omitted for a derivation whose key is `()`\n(`derived_mismatch`: a path's for `last_modified`; for a memo under a memo key, a `_mac`\nderivation, the id of the key it was made under).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "What is damaged: `corrupt_object`, `missing_object`, `missing_parent`, `root_mismatch`,\n`dangling_ref`, `corrupt_ref`, `index_mismatch`, `journal_corrupt`, `meta_corrupt`,\n`external_id_corrupt`, `external_id_dangling`, `external_id_mismatch` or\n`derived_mismatch`. A string, as `OpError.code` is, so that a client can read kinds newer\nthan its own list.",
          "type": "string"
        },
        "object": {
          "description": "The object: one whose content does not hash to its id or does not decode\n(`corrupt_object`), one a changeset references that the store lacks, or holds as\nanother kind (`missing_object`), or the tree or blob a git export oid memo\n(`git_tree_oid`, `git_blob_oid`, `git_tree_oid_mac`, `git_blob_oid_mac`) is about\n(`derived_mismatch`).",
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "description": "Where the corrupt frame starts in `journal.log` (`journal_corrupt`); nothing after it\nis read.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parent": {
          "description": "The parent the changeset names, which the store does not hold (`missing_parent`).",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "The ref: one that names no changeset in the store (`dangling_ref`), or whose file does\nnot read as a ref (`corrupt_ref`).",
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "description": "The changeset record's place in the index, from 0 (`index_mismatch`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "system": {
          "description": "The system of the external id index whose entry it is: `git`, whose keys are git commit\noids, or another (`external_id_corrupt`, `external_id_dangling`, `external_id_mismatch`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "title": "VerifyFinding",
      "type": "object"
    },
    "VerifyReport": {
      "$defs": {
        "VerifyFinding": {
          "description": "One problem `verify` found, as a program reads it: what kind of damage it is, and what it\nnames. The keys its kind does not use are omitted; the line at the same index of `problems`\nsays the same for a reader. Ids are lowercase hex.",
          "properties": {
            "cause": {
              "description": "What disagrees with the record (`index_mismatch`), which says what mends it: `journal`\n(rebuild the index from the journal), `sorted_view` (rebuild the sorted views from the\nindex columns) or `object` (derive the record from its object again).",
              "type": [
                "string",
                "null"
              ]
            },
            "changeset": {
              "description": "The changeset: the first, in seq order, that references the missing object\n(`missing_object`), the one that names a missing parent (`missing_parent`), the one whose\nroot is not its first parent's root with its delta applied (`root_mismatch`), the one\nan external id's entry names: not in the store (`external_id_dangling`), or with a\n`git.oid` that is another oid than the entry's key, or, found by a deep verify, with none\nand exporting to another commit (`external_id_mismatch`), or the one a derived value is\nabout (`derived_mismatch`).",
              "type": [
                "string",
                "null"
              ]
            },
            "derivation": {
              "description": "The derivation whose stored value is not the one the objects give: `first_parent_skip_list`,\n`last_modified`, or a git export oid memo `git_tree_oid`, `git_blob_oid` or `git_oid`, or\none of them under a memo key, `git_tree_oid_mac`, `git_blob_oid_mac` or `git_oid_mac`,\nwhose value, or under the store's key whose MAC, does not check (`derived_mismatch`, which\na deep verify finds; `git_oid` and `git_oid_mac` name their `changeset`, the tree and blob\nmemos their `object`). Removing the value's file under `meta/derived/<derivation>/`, or all\nof `meta/derived/`, has it derived again.",
              "type": [
                "string",
                "null"
              ]
            },
            "key": {
              "description": "The key, in lowercase hex: the external id whose entry it is, a git commit's oid for\nsystem `git` (`external_id_corrupt`, `external_id_dangling`, `external_id_mismatch`); or a\nderived value's key, its postcard bytes, omitted for a derivation whose key is `()`\n(`derived_mismatch`: a path's for `last_modified`; for a memo under a memo key, a `_mac`\nderivation, the id of the key it was made under).",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "description": "What is damaged: `corrupt_object`, `missing_object`, `missing_parent`, `root_mismatch`,\n`dangling_ref`, `corrupt_ref`, `index_mismatch`, `journal_corrupt`, `meta_corrupt`,\n`external_id_corrupt`, `external_id_dangling`, `external_id_mismatch` or\n`derived_mismatch`. A string, as `OpError.code` is, so that a client can read kinds newer\nthan its own list.",
              "type": "string"
            },
            "object": {
              "description": "The object: one whose content does not hash to its id or does not decode\n(`corrupt_object`), one a changeset references that the store lacks, or holds as\nanother kind (`missing_object`), or the tree or blob a git export oid memo\n(`git_tree_oid`, `git_blob_oid`, `git_tree_oid_mac`, `git_blob_oid_mac`) is about\n(`derived_mismatch`).",
              "type": [
                "string",
                "null"
              ]
            },
            "offset": {
              "description": "Where the corrupt frame starts in `journal.log` (`journal_corrupt`); nothing after it\nis read.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "parent": {
              "description": "The parent the changeset names, which the store does not hold (`missing_parent`).",
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "description": "The ref: one that names no changeset in the store (`dangling_ref`), or whose file does\nnot read as a ref (`corrupt_ref`).",
              "type": [
                "string",
                "null"
              ]
            },
            "seq": {
              "description": "The changeset record's place in the index, from 0 (`index_mismatch`).",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "system": {
              "description": "The system of the external id index whose entry it is: `git`, whose keys are git commit\noids, or another (`external_id_corrupt`, `external_id_dangling`, `external_id_mismatch`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`verify`: what the consistency check found.",
      "properties": {
        "changesets_checked": {
          "description": "How many changesets were checked.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "findings": {
          "default": [],
          "description": "One finding per problem found, for a program to act on: `findings[i]` is the problem\nthat the line `problems[i]` describes. Empty for a clean store; a report without it\nreads as having none.",
          "items": {
            "$ref": "#/$defs/VerifyFinding"
          },
          "type": "array"
        },
        "found": {
          "default": 0,
          "description": "How many problems were found, listed or not; 0 from a store older than this field.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objects_checked": {
          "description": "How many objects were checked.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "problems": {
          "description": "One line per problem found, for a reader of lines; empty for a clean store. `findings`\nholds the same problems, at the same indexes, for a program.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "truncated": {
          "default": false,
          "description": "The report lists the first `max_findings` problems only; `found` counts them all.",
          "type": "boolean"
        }
      },
      "required": [
        "objects_checked",
        "changesets_checked",
        "problems"
      ],
      "title": "VerifyReport",
      "type": "object"
    },
    "VerifyReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`verify`: check the whole store's consistency.",
      "properties": {
        "deep": {
          "default": false,
          "description": "Re-hash every object, and check every derived value of the built-in derivations (the\nfirst-parent skip lists, the last touches of paths) against the objects. When `false`,\nverify checks structure only: parents, that referenced objects exist, the index against\nthe journal, and refs.",
          "type": "boolean"
        },
        "max_findings": {
          "description": "The most problems the report lists, 1 to 1,000, also the default; `found` counts them\nall.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "VerifyReq",
      "type": "object"
    },
    "VerifySummary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a verify found, in counts: `repair`'s `after`.",
      "properties": {
        "changesets_checked": {
          "description": "How many changesets were checked.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "found": {
          "description": "How many problems were found; 0 for a sound store.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objects_checked": {
          "description": "How many objects were checked.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "objects_checked",
        "changesets_checked",
        "found"
      ],
      "title": "VerifySummary",
      "type": "object"
    },
    "WsChange": {
      "$defs": {
        "WsChangeKind": {
          "description": "What changed at a workspace path.",
          "oneOf": [
            {
              "const": "added",
              "description": "A file the head does not hold.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content changed.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is gone.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A file became a symlink, or the other way round.",
              "type": "string"
            },
            {
              "const": "mode_changed",
              "description": "Its executable bit changed.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One changed path of a workspace.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/WsChangeKind",
          "description": "What changed."
        },
        "path": {
          "description": "The repository path.",
          "type": "string"
        },
        "size": {
          "description": "The file's size now; omitted for a deleted path.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "WsChange",
      "type": "object"
    },
    "WsChangeKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What changed at a workspace path.",
      "oneOf": [
        {
          "const": "added",
          "description": "A file the head does not hold.",
          "type": "string"
        },
        {
          "const": "modified",
          "description": "Its content changed.",
          "type": "string"
        },
        {
          "const": "deleted",
          "description": "It is gone.",
          "type": "string"
        },
        {
          "const": "type_changed",
          "description": "A file became a symlink, or the other way round.",
          "type": "string"
        },
        {
          "const": "mode_changed",
          "description": "Its executable bit changed.",
          "type": "string"
        }
      ],
      "title": "WsChangeKind"
    },
    "WsCheckInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The check a workspace's land runs.",
      "properties": {
        "argv": {
          "description": "The command and its arguments, run without a shell in the workspace; when omitted, the\nrepository's `.swarmops/workspaces.json` `check.argv`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timeout_s": {
          "default": 900,
          "description": "The most seconds the command runs before it is killed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "WsCheckInput",
      "type": "object"
    },
    "WsCommitReq": {
      "$defs": {
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "StatusAfter": {
          "description": "Whether a workspace mutation's response carries the workspace's status after it.",
          "oneOf": [
            {
              "const": "page",
              "description": "The first page of the status, up to 100 changes.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No status.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_commit` (client-side): record a workspace's edits as one changeset on its head.",
      "properties": {
        "message": {
          "description": "The changeset's message.",
          "type": "string"
        },
        "modes": {
          "additionalProperties": {
            "$ref": "#/$defs/ModeInput"
          },
          "description": "A kind to record for a path, where the volume cannot hold the executable bit.",
          "type": "object"
        },
        "paths": {
          "description": "Only these repository paths; one outside the prefixes is `E_WS_OUTSIDE_PREFIXES`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status_after": {
          "$ref": "#/$defs/StatusAfter",
          "default": "page",
          "description": "Whether the response carries the status after the mutation."
        },
        "workspace": {
          "description": "The workspace, by name.",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "message"
      ],
      "title": "WsCommitReq",
      "type": "object"
    },
    "WsCommitResp": {
      "$defs": {
        "WsChange": {
          "description": "One changed path of a workspace.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/WsChangeKind",
              "description": "What changed."
            },
            "path": {
              "description": "The repository path.",
              "type": "string"
            },
            "size": {
              "description": "The file's size now; omitted for a deleted path.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "kind"
          ],
          "type": "object"
        },
        "WsChangeKind": {
          "description": "What changed at a workspace path.",
          "oneOf": [
            {
              "const": "added",
              "description": "A file the head does not hold.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content changed.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is gone.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A file became a symlink, or the other way round.",
              "type": "string"
            },
            {
              "const": "mode_changed",
              "description": "Its executable bit changed.",
              "type": "string"
            }
          ]
        },
        "WsRebasing": {
          "description": "A workspace's rebase in progress.",
          "properties": {
            "conflicts": {
              "description": "The paths that still conflict.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "onto": {
              "description": "The target's head it rebases onto.",
              "type": "string"
            }
          },
          "required": [
            "onto",
            "conflicts"
          ],
          "type": "object"
        },
        "WsState": {
          "description": "A workspace's state.",
          "oneOf": [
            {
              "const": "clean",
              "description": "No rebase in progress.",
              "type": "string"
            },
            {
              "const": "rebasing",
              "description": "A rebase stopped on conflicts.",
              "type": "string"
            }
          ]
        },
        "WsStatus": {
          "description": "A workspace's status: its changes against its head, a page at a time, and how far its target\nhas moved since its base.",
          "properties": {
            "base": {
              "description": "The target's changeset its chain starts from.",
              "type": "string"
            },
            "behind_by": {
              "description": "How many changesets the target's first-parent history holds that `base`'s lacks: those\npast `base` when it is on that history; otherwise (a sync dropped it, or the target moved\nback) those before where the two histories meet, 0 when the target head is on `base`'s\nfirst-parent history fewer than 10,000 changesets behind `base`. At most 10,000.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "changes": {
              "description": "The changes, by path.",
              "items": {
                "$ref": "#/$defs/WsChange"
              },
              "type": "array"
            },
            "cursor": {
              "description": "Where this page stopped.",
              "type": [
                "string",
                "null"
              ]
            },
            "head": {
              "description": "Its chain's last changeset.",
              "type": "string"
            },
            "main": {
              "description": "The head of the workspace's target ref (`main`, or `release/<name>`), read first.",
              "type": "string"
            },
            "name": {
              "description": "The workspace's name.",
              "type": "string"
            },
            "rebasing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WsRebasing"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The rebase in progress, when `state` is `rebasing`."
            },
            "state": {
              "$ref": "#/$defs/WsState",
              "description": "Whether the workspace is rebasing."
            },
            "truncated": {
              "description": "Whether more changes follow: give `cursor` to read them.",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "base",
            "head",
            "main",
            "behind_by",
            "state",
            "changes",
            "truncated"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_commit`: the changeset recorded.",
      "properties": {
        "blobs_written": {
          "description": "How many blobs the store did not hold and got.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "changeset": {
          "description": "The new changeset: the workspace's head now.",
          "type": "string"
        },
        "files_changed": {
          "description": "How many paths it changes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "description": "Its parent: the head before.",
          "type": "string"
        },
        "replayed": {
          "description": "A crashed commit's key replayed: the changeset was recorded before.",
          "type": "boolean"
        },
        "status_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/WsStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "The status after the mutation; omitted when the request said `none`."
        }
      },
      "required": [
        "changeset",
        "parent",
        "files_changed",
        "blobs_written",
        "replayed"
      ],
      "title": "WsCommitResp",
      "type": "object"
    },
    "WsCreateReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        },
        "StatusAfter": {
          "description": "Whether a workspace mutation's response carries the workspace's status after it.",
          "oneOf": [
            {
              "const": "page",
              "description": "The first page of the status, up to 100 changes.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No status.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_create` (M5, client-side): make a workspace, a directory holding a sparse copy of a\nchangeset's tree. The same request again is the same workspace (`created` false).",
      "properties": {
        "all": {
          "description": "The whole tree instead of `prefixes`.",
          "type": "boolean"
        },
        "base": {
          "$ref": "#/$defs/Rev",
          "default": "main",
          "description": "The changeset whose tree it holds."
        },
        "from": {
          "description": "A directory on the caller's host whose `.worktreeinclude` names files to copy in; when\nomitted, nothing is copied.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The workspace's name: 1 to 64 of `a-z`, `0-9`, `.`, `_` and `-`, not starting with `.`.",
          "type": "string"
        },
        "path": {
          "description": "The directory to make it in, on the caller's host; when omitted, one named after it in the\nworking directory of the process that serves the call.",
          "type": [
            "string",
            "null"
          ]
        },
        "prefixes": {
          "description": "The repository paths whose subtrees are written out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session": {
          "description": "The hook's session, 16 hex digits; set by the Claude Code hook only.",
          "type": [
            "string",
            "null"
          ]
        },
        "status_after": {
          "$ref": "#/$defs/StatusAfter",
          "default": "page",
          "description": "Whether the response carries the status after the mutation."
        }
      },
      "required": [
        "name"
      ],
      "title": "WsCreateReq",
      "type": "object"
    },
    "WsDeleteReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_delete` (client-side, CLI only): remove a workspace's directory, then its entry.",
      "properties": {
        "force": {
          "description": "Delete it even with edits or unlanded commits.",
          "type": "boolean"
        },
        "rescue": {
          "description": "Commit its edits as a rescue changeset first.",
          "type": "boolean"
        },
        "workspace": {
          "description": "The workspace, by name.",
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "title": "WsDeleteReq",
      "type": "object"
    },
    "WsDeleteResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_delete`: what the deleted workspace left in the store.",
      "properties": {
        "deleted": {
          "description": "The workspace's name.",
          "type": "string"
        },
        "head": {
          "description": "Its head when it was deleted.",
          "type": "string"
        },
        "rescued": {
          "description": "The rescue changeset of its edits, when there were some.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "deleted",
        "head"
      ],
      "title": "WsDeleteResp",
      "type": "object"
    },
    "WsDiffReq": {
      "$defs": {
        "DiffFormat": {
          "description": "What `diff` says of each file.",
          "oneOf": [
            {
              "const": "names",
              "description": "Its path and status.",
              "type": "string"
            },
            {
              "const": "stat",
              "description": "Also whether it is binary and, for text, the lines it inserts and deletes.",
              "type": "string"
            },
            {
              "const": "unified",
              "description": "Also its kinds, its blobs and, for text, its hunks.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_diff` (client-side): a workspace's edits against its head, as the store's diff gives a\ndiff (`from` the head, `to` `ws:<name>`).",
      "properties": {
        "context": {
          "default": 3,
          "description": "Unchanged lines around each change.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cursor": {
          "description": "Where the previous page stopped.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "$ref": "#/$defs/DiffFormat",
          "default": "names",
          "description": "How much each file says: as the store's diff."
        },
        "limit": {
          "default": 500,
          "description": "The most files to return: at least 1.",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_bytes": {
          "default": 32768,
          "description": "The most bytes of a `unified` page's files.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "paths": {
          "description": "Only these repository paths, and what is below them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "description": "The workspace, by name.",
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "title": "WsDiffReq",
      "type": "object"
    },
    "WsDiscardReq": {
      "$defs": {
        "StatusAfter": {
          "description": "Whether a workspace mutation's response carries the workspace's status after it.",
          "oneOf": [
            {
              "const": "page",
              "description": "The first page of the status, up to 100 changes.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No status.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_discard` (client-side): restore paths from the workspace's head.",
      "properties": {
        "paths": {
          "description": "The repository paths to restore; every changed one when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status_after": {
          "$ref": "#/$defs/StatusAfter",
          "default": "page",
          "description": "Whether the response carries the status after the mutation."
        },
        "workspace": {
          "description": "The workspace, by name.",
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "title": "WsDiscardReq",
      "type": "object"
    },
    "WsDiscardResp": {
      "$defs": {
        "WsChange": {
          "description": "One changed path of a workspace.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/WsChangeKind",
              "description": "What changed."
            },
            "path": {
              "description": "The repository path.",
              "type": "string"
            },
            "size": {
              "description": "The file's size now; omitted for a deleted path.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "kind"
          ],
          "type": "object"
        },
        "WsChangeKind": {
          "description": "What changed at a workspace path.",
          "oneOf": [
            {
              "const": "added",
              "description": "A file the head does not hold.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content changed.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is gone.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A file became a symlink, or the other way round.",
              "type": "string"
            },
            {
              "const": "mode_changed",
              "description": "Its executable bit changed.",
              "type": "string"
            }
          ]
        },
        "WsRebasing": {
          "description": "A workspace's rebase in progress.",
          "properties": {
            "conflicts": {
              "description": "The paths that still conflict.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "onto": {
              "description": "The target's head it rebases onto.",
              "type": "string"
            }
          },
          "required": [
            "onto",
            "conflicts"
          ],
          "type": "object"
        },
        "WsState": {
          "description": "A workspace's state.",
          "oneOf": [
            {
              "const": "clean",
              "description": "No rebase in progress.",
              "type": "string"
            },
            {
              "const": "rebasing",
              "description": "A rebase stopped on conflicts.",
              "type": "string"
            }
          ]
        },
        "WsStatus": {
          "description": "A workspace's status: its changes against its head, a page at a time, and how far its target\nhas moved since its base.",
          "properties": {
            "base": {
              "description": "The target's changeset its chain starts from.",
              "type": "string"
            },
            "behind_by": {
              "description": "How many changesets the target's first-parent history holds that `base`'s lacks: those\npast `base` when it is on that history; otherwise (a sync dropped it, or the target moved\nback) those before where the two histories meet, 0 when the target head is on `base`'s\nfirst-parent history fewer than 10,000 changesets behind `base`. At most 10,000.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "changes": {
              "description": "The changes, by path.",
              "items": {
                "$ref": "#/$defs/WsChange"
              },
              "type": "array"
            },
            "cursor": {
              "description": "Where this page stopped.",
              "type": [
                "string",
                "null"
              ]
            },
            "head": {
              "description": "Its chain's last changeset.",
              "type": "string"
            },
            "main": {
              "description": "The head of the workspace's target ref (`main`, or `release/<name>`), read first.",
              "type": "string"
            },
            "name": {
              "description": "The workspace's name.",
              "type": "string"
            },
            "rebasing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WsRebasing"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The rebase in progress, when `state` is `rebasing`."
            },
            "state": {
              "$ref": "#/$defs/WsState",
