          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`commit`: record a changeset from an explicit change list. It moves no ref.",
      "properties": {
        "allow_empty": {
          "default": false,
          "description": "Record the changeset even if it changes nothing.",
          "type": "boolean"
