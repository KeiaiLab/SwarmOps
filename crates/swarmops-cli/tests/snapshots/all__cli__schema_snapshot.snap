      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`show`: a changeset's header, changes and metadata. Byte strings are decoded as UTF-8, with\ninvalid bytes replaced, except metadata values (see `metadata`).",
      "properties": {
        "author": {
          "$ref": "#/$defs/Attribution",
          "description": "Who wrote the change."
        },
        "changes": {
          "description": "What changed relative to the first parent, ordered by path: at most `max_changes`\nentries.",
          "items": {
            "$ref": "#/$defs/ChangeOut"
          },
          "type": "array"
        },
        "changes_truncated": {
          "description": "Whether `changes` stops before the changeset's last change.",
          "type": "boolean"
        },
        "created_at": {
          "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_changed": {
          "description": "How many paths the changeset changes in all, also when `changes` is truncated.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "The changeset's id.",
          "type": "string"
        },
        "land_key": {
          "description": "The idempotency key of the land that made it (its `land_key` metadata), when it had one.",
          "type": [
            "string",
            "null"
          ]
        },
        "lander": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who landed it, for a changeset a `land` made: its `lander` and `lander_run_id` metadata.\nOmitted for any other changeset."
        },
        "message": {
          "description": "The message.",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "SwarmOps metadata, such as `agent` and `run_id`. A value that is not UTF-8 is given in\nstandard, padded base64, under its key with `:b64` appended. A commit refuses a key that\nends in `:b64`, so `k:b64` is always the base64 of `k`'s value, which is not UTF-8.",
          "type": "object"
        },
        "parents": {
          "description": "The parents' ids; the first is the mainline parent that `changes` are relative to.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "description": "The root tree's id.",
          "type": "string"
        },
        "seq": {
          "description": "Its position in the store's changeset index, in commit order.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "signatures": {
          "$ref": "#/$defs/Signatures",
          "description": "The git author and committer signatures, kept for git fidelity."
        },
        "squashed_from": {
          "description": "The changesets a land squashed into it, oldest first: the landed head's first-parent chain\nafter the land's base, ending at that head (its `squashed_from` metadata). Omitted for a\nchangeset no land made.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "seq",
        "parents",
        "root",
        "author",
        "created_at",
        "message",
        "changes",
        "files_changed",
        "changes_truncated",
        "metadata",
        "signatures"
      ],
