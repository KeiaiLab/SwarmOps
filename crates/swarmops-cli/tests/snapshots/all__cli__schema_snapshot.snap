      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`commit`: record a changeset from an explicit change list. It moves no ref, unless\n`advance` names one.",
      "properties": {
        "advance": {
          "description": "Also move this ref (`main` or `release/<name>`) to the new changeset, in the same\ntransaction as the changeset itself, so that both are recorded or neither. The move\nhappens only if the ref still names the changeset's parent (for a root commit, only if the\nref does not exist yet): it is always a one-step fast-forward. Otherwise nothing is\nrecorded and the commit fails with `E_CAS_MISMATCH` (`details.committed: false`,\n`details.actual` what the ref names). Give as `parent` the full id the ref held when you\nread it: without `parent` the commit builds on the ref's head when it runs, so the move\ncatches a race from there on, not a change made since you read the ref (M1 has no\nmerge). `swarmops mcp` refuses `advance` without a full 64-hex `parent` (`E_INVALID_ARG`).\nA store that does not know this field ignores it and moves no ref: its response has no\n`advanced`.",
          "type": [
            "string",
            "null"
          ]
        },
        "allow_empty": {
          "default": false,
          "description": "Record the changeset even if it changes nothing.",
          "type": "boolean"
        },
        "changes": {
          "description": "What to change, relative to the parent. The contents hold at most 1 GiB together, by the\nsizes they declare (inline text's length, the bytes base64 decodes to, a client file's\nlength; a `blob` named by id counts nothing): more is `E_TOO_LARGE` with `scope`\n`commit`, refused before any content is read. Store large contents with `blob_put` first,\nand name them by id.",
          "items": {
            "$ref": "#/$defs/ChangeInput"
          },
          "type": "array"
        },
        "idempotency_key": {
          "description": "Makes a retry of this commit safe: a uuid v7 (anything else is `E_INVALID_ARG`). The\ncommit takes the key's time, to the second, as its signature time and records the key as\n`commit_key` metadata, so the same request on the same parent makes the same changeset,\nwhich the store holds already: the response says `replayed`, and nothing is written.\nWith `advance`, a ref whose head carries the key is a replay too. Give `parent` by its full\nid: without it, a retry after the head moved commits again, on the new head.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "The commit message.",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "The changeset to commit on top of. An explicit `parent` always wins; when it is omitted,\nthe current head of the ref `advance` names is used, else of `main`, if that ref exists,\nand otherwise the commit is a root commit. `null` is the same as omitting it. Once `main`\nexists, a root commit needs an `advance` naming a ref that does not exist yet (a known M1\nlimitation)."
        }
      },
      "required": [
        "changes",
        "message"
      ],
      "title": "CommitReq",
      "type": "object"
    },
    "CommitResp": {
      "$defs": {
        "Advanced": {
          "description": "`commit` with `advance`: the ref's move, made in the commit's own transaction.",
          "properties": {
            "already_applied": {
              "description": "The ref held the changeset already, from an identical request before, so nothing was\nwritten and a replay is safe.",
              "type": "boolean"
            },
            "name": {
              "description": "The ref.",
              "type": "string"
            },
            "new": {
              "description": "What it holds now: the changeset.",
              "type": "string"
            },
            "old": {
              "description": "What the ref held before: the changeset's parent; omitted for a root commit, whose move\ncreated the ref.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "new",
            "already_applied"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`commit`: the changeset that was recorded.",
      "properties": {
        "advanced": {
          "anyOf": [
            {
              "$ref": "#/$defs/Advanced"
            },
            {
              "type": "null"
            }
          ],
          "description": "The move of the ref the request's `advance` named: present exactly when the ref names\n`changeset` because of this request, or of an identical one before it\n(`already_applied`). A request with `advance` whose response lacks it went to a store\nthat ignores the field, and moved no ref."
        },
        "blobs_written": {
          "description": "How many blobs this commit's own writes placed in the object store; blobs that were there\nalready, or that a concurrent writer placed first, count 0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "changeset": {
          "description": "The new changeset's id.",
          "type": "string"
        },
        "files_changed": {
          "description": "How many paths the changeset changes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "description": "The changeset it was committed on top of; omitted for a root commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "replayed": {
          "default": false,
          "description": "The store held the changeset already, from an identical request before (a retry with the\nsame `idempotency_key`), so nothing was written. Always written; a response from a store\nthat does not know the field reads as `false`.",
          "type": "boolean"
        },
        "root": {
          "description": "The new root tree's id.",
          "type": "string"
        },
        "warnings": {
          "description": "Problems found after the commit became durable, such as failed housekeeping; the commit\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "changeset",
        "root",
        "files_changed",
        "blobs_written"
      ],
      "title": "CommitResp",
      "type": "object"
    },
    "ConflictKindOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What kind of conflict a file has. `ours` is the change, `theirs` the target.",
      "oneOf": [
        {
          "const": "content",
          "description": "Both sides edited the same lines of a text file, or lines next to each other.",
          "type": "string"
        },
        {
          "const": "binary",
          "description": "Both sides changed the content of a file that is not text, or of a symlink, differently.",
          "type": "string"
        },
        {
          "const": "delete_modify",
          "description": "The change deleted the file, and the target changed it.",
          "type": "string"
        },
        {
          "const": "modify_delete",
          "description": "The change changed the file, and the target deleted it.",
          "type": "string"
        },
        {
          "const": "add_add",
          "description": "Both sides added the file, with contents that do not merge.",
          "type": "string"
        },
        {
          "const": "mode",
          "description": "Both sides changed the file's kind (file, executable or symlink), differently.",
          "type": "string"
        },
        {
          "const": "type_change",
          "description": "One side has a file where the other has a directory.",
          "type": "string"
        }
      ],
      "title": "ConflictKindOut"
    },
    "ConflictReport": {
      "$defs": {
        "ConflictKindOut": {
          "description": "What kind of conflict a file has. `ours` is the change, `theirs` the target.",
          "oneOf": [
            {
              "const": "content",
              "description": "Both sides edited the same lines of a text file, or lines next to each other.",
              "type": "string"
            },
            {
              "const": "binary",
              "description": "Both sides changed the content of a file that is not text, or of a symlink, differently.",
              "type": "string"
            },
            {
              "const": "delete_modify",
              "description": "The change deleted the file, and the target changed it.",
              "type": "string"
            },
            {
              "const": "modify_delete",
              "description": "The change changed the file, and the target deleted it.",
              "type": "string"
            },
            {
              "const": "add_add",
              "description": "Both sides added the file, with contents that do not merge.",
              "type": "string"
            },
            {
              "const": "mode",
              "description": "Both sides changed the file's kind (file, executable or symlink), differently.",
              "type": "string"
            },
            {
              "const": "type_change",
              "description": "One side has a file where the other has a directory.",
              "type": "string"
            }
          ]
        },
        "FileConflictOut": {
          "description": "One conflicting file. Its blobs are the file's content on each side, which `read_file` reads\nat that side's changeset; a side without a file at the path (deleted, never added, or a\ndirectory there) has none.",
          "properties": {
            "base_blob": {
              "description": "Its blob at the merge base.",
              "type": [
                "string",
                "null"
              ]
            },
            "hunks": {
              "description": "The places where the two sides' edits of its lines meet, in file order: for a text file\nboth sides edited (`content`, and `add_add` of two texts). Omitted when there are none.",
              "items": {
                "$ref": "#/$defs/HunkOut"
              },
              "type": "array"
            },
            "kind": {
              "$ref": "#/$defs/ConflictKindOut",
              "description": "What kind of conflict it is."
            },
            "ours_blob": {
              "description": "Its blob in the change.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "The file's repository path.",
              "type": "string"
            },
            "theirs_agent": {
              "description": "The agent that wrote `theirs_changeset`.",
              "type": [
                "string",
                "null"
              ]
            },
            "theirs_blob": {
              "description": "Its blob on the target.",
              "type": [
                "string",
                "null"
              ]
            },
            "theirs_changeset": {
              "description": "The newest changeset on the target since the merge base that changed this path: what to\nread for the other side's edit.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "kind"
          ],
          "type": "object"
        },
        "HunkOut": {
          "description": "One place where the two sides' edits of a text file meet: each side's lines there. The lines\nare numbered from 1, and each side's range includes both ends, as `read_file` takes a range\nof lines.",
          "properties": {
            "base": {
              "$ref": "#/$defs/LinesOut",
              "description": "The lines at the merge base."
            },
            "id": {
              "description": "Its number in the file, from 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "ours": {
              "$ref": "#/$defs/LinesOut",
              "description": "The change's lines."
            },
            "theirs": {
              "$ref": "#/$defs/LinesOut",
              "description": "The target's lines."
            }
          },
          "required": [
            "id",
            "base",
            "ours",
            "theirs"
          ],
          "type": "object"
        },
        "LinesOut": {
          "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
          "properties": {
            "first": {
              "description": "The first line.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "last": {
              "description": "The last line; `first` minus one when the side has none.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "The lines' text; omitted when the report would pass its `max_conflict_bytes`\n(`truncated`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Why a land could not merge its change onto the target, file by file, or could not apply its\nresolutions to it (operations spec §3): the report `E_CONFLICT` carries in `details.report`.\n`ours` is the change, `theirs` the target. Ids are full.",
      "properties": {
        "auto_merged": {
          "description": "The paths both sides changed that merged cleanly. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "base": {
          "description": "The merge base: the changeset the change starts from.",
          "type": "string"
        },
        "files": {
          "description": "The files that conflict, by path.",
          "items": {
            "$ref": "#/$defs/FileConflictOut"
          },
          "type": "array"
        },
        "kinds": {
          "description": "The kinds of conflict in `files`, each once.",
          "items": {
            "$ref": "#/$defs/ConflictKindOut"
          },
          "type": "array"
        },
        "ours": {
          "description": "The change's head.",
          "type": "string"
        },
        "stale": {
          "description": "The paths whose resolutions did not apply, since the target holds there what their\n`against` did not: the target changed them after the report the resolutions answered.\nRead them at `theirs` and resolve them again, against it. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "theirs": {
          "description": "The target's head the change was merged with.",
          "type": "string"
        },
        "truncated": {
          "description": "Whether hunk texts were left out to keep the report within the request's\n`max_conflict_bytes`; the line positions and blob ids are always there.",
          "type": "boolean"
        }
      },
      "required": [
        "base",
        "ours",
        "theirs",
        "files",
        "kinds",
        "truncated"
      ],
      "title": "ConflictReport",
      "type": "object"
    },
    "ContentEncoding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How `FileContent.content` encodes bytes.",
      "oneOf": [
        {
          "const": "utf8",
          "description": "The bytes are UTF-8 text, and `content` is that text.",
          "type": "string"
        },
        {
          "const": "base64",
          "description": "`content` is the bytes in standard, padded base64.",
          "type": "string"
        }
      ],
      "title": "ContentEncoding"
    },
    "ContentInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A `put`'s content, as an object with one key.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "UTF-8 text, verbatim.",
          "properties": {
            "inline": {
              "type": "string"
            }
          },
          "required": [
            "inline"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Bytes in standard, padded base64.",
          "properties": {
            "base64": {
              "type": "string"
            }
          },
          "required": [
            "base64"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
          "properties": {
            "blob": {
              "type": "string"
            }
          },
          "required": [
            "blob"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      ],
      "title": "ContentInput"
    },
    "DeriveReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`derive`: derive ahead of any reader the eager derived values (storage spec §5: each\nchangeset's first-parent skip list) of the changesets the journal records after a frame, so\nthat reads find them stored. It writes only the store's cache of derived values, so it takes\nno identity.",
      "properties": {
        "after": {
          "description": "Go on after this journal frame: a previous call's `next`. From the journal's first frame\nwhen omitted.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "default": 1000,
          "description": "The most journal frames to read; a frame is one transaction, a commit or a ref's move. 0\nreads none and derives nothing: `next` is then the journal's last frame, from where the\nnext calls derive only what is recorded later.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "DeriveReq",
      "type": "object"
    },
    "DeriveResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`derive`: how many values one call derived, how many the store held already, and where to\ngo on.",
      "properties": {
        "cached": {
          "description": "How many of those values the store held already.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "derived": {
          "description": "How many values it derived: of each eager derivation, one for each changeset its frames\nrecord whose value the store lacked. Values those needed on the way, an older\nchangeset's, are derived too and not counted.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "next": {
          "description": "The last frame it read: pass it as the next call's `after` to go on, through a journal\nlonger than `limit` frames or through the frames recorded since. Omitted when it read no\nframe, as none follows `after`: it is at the journal's end. With `limit` 0, the journal's\nlast frame, omitted while the journal holds none.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "derived",
        "cached"
      ],
      "title": "DeriveResp",
      "type": "object"
    },
    "Diff": {
      "$defs": {
        "DiffHunk": {
          "description": "A hunk of a unified diff: one or more changes and the unchanged lines around them, with the\nnumbers of its header, `@@ -old_start,old_lines +new_start,new_lines @@`.",
          "properties": {
            "lines": {
              "description": "Its lines, in order; each change's removed lines come before its added lines.",
              "items": {
                "$ref": "#/$defs/DiffLineOut"
              },
              "type": "array"
            },
            "new_lines": {
              "description": "How many new lines it holds: its context and added lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "new_start": {
              "description": "The first new line it holds, counted as `old_start` is.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_lines": {
              "description": "How many old lines it holds: its context and removed lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_start": {
              "description": "The first old line it holds, counted from 1; when it holds none, the line before where\nthey would be (0 at the top), as git prints it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "old_start",
            "old_lines",
            "new_start",
            "new_lines",
            "lines"
          ],
          "type": "object"
        },
        "DiffLineOut": {
          "description": "One line of a hunk.",
          "properties": {
            "op": {
              "$ref": "#/$defs/LineOp",
              "description": "Whether both sides have it, only the new one, or only the old one."
            },
            "text": {
              "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ],
          "type": "object"
        },
        "DiffStatus": {
          "description": "What happened to a file between the two revisions.",
          "oneOf": [
            {
              "const": "added",
              "description": "It is in `to` only: in `from`, nothing or a directory is there.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is in `from` only.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content or its exec bit changed: a file or an executable on both sides, or a\nsymlink on both sides.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A symlink on one side, a file or an executable on the other.",
              "type": "string"
            }
          ]
        },
        "FileDiff": {
          "description": "One file that differs: a file, an executable or a symlink whose content or kind changed, or\nthat is on one side only. A directory never is one: a file that becomes a directory is that\nfile deleted and the directory's files added. No rename is detected: a file that moved is\none deleted and one added. Which fields follow `status` depends on the request's `format`,\nand a field that says nothing is omitted.",
          "properties": {
            "binary": {
              "description": "`stat` and `unified`: whether it is binary, which gets no line counts and no hunks: a side\nthat is not UTF-8, or holds a NUL in its first 8,000 bytes.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "deletions": {
              "description": "`stat` and `unified`, for text: the lines the change deletes.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "hunks": {
              "description": "`unified`, for text: the hunks, in order; empty when only the exec bit or the kind\nchanged.",
              "items": {
                "$ref": "#/$defs/DiffHunk"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "hunks_truncated": {
              "description": "`unified`: true when `hunks` stops before the file's last hunk, to keep the page within\n`max_bytes`; omitted otherwise. `insertions` and `deletions` count every line all the\nsame.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "insertions": {
              "description": "`stat` and `unified`, for text: the lines the change inserts.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "new_blob": {
              "description": "`unified`: its blob id in `to`; omitted for a deleted file.",
              "type": [
                "string",
                "null"
              ]
            },
            "new_kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FileKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`unified`: its kind in `to`; omitted for a deleted file."
            },
            "old_blob": {
              "description": "`unified`: its blob id in `from`; omitted for an added file.",
              "type": [
                "string",
                "null"
              ]
            },
            "old_kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FileKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`unified`: its kind in `from`; omitted for an added file."
            },
            "path": {
              "description": "The repository path.",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/DiffStatus",
              "description": "What happened to it."
            }
          },
          "required": [
            "path",
            "status"
          ],
          "type": "object"
        },
        "FileKind": {
          "description": "What a file is; never a directory.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            }
          ]
        },
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`diff`: a page of the files that differ between two revisions, in path order (by bytes).",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page starts. Opaque: pass it back as given, as the next\nrequest's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "The files.",
          "items": {
            "$ref": "#/$defs/FileDiff"
          },
          "type": "array"
        },
        "from": {
          "description": "The changeset `from` named.",
          "type": "string"
        },
        "to": {
          "description": "The changeset `to` named.",
          "type": "string"
        },
        "truncated": {
          "description": "Whether more files follow this page.",
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to",
        "files",
        "truncated"
      ],
      "title": "Diff",
      "type": "object"
    },
    "DiffFormat": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What `diff` says of each file.",
      "oneOf": [
        {
          "const": "names",
          "description": "Its path and status.",
          "type": "string"
        },
        {
          "const": "stat",
          "description": "Also whether it is binary and, for text, the lines it inserts and deletes.",
          "type": "string"
        },
        {
          "const": "unified",
          "description": "Also its kinds, its blobs and, for text, its hunks.",
          "type": "string"
        }
      ],
      "title": "DiffFormat"
    },
    "DiffHunk": {
      "$defs": {
        "DiffLineOut": {
          "description": "One line of a hunk.",
          "properties": {
            "op": {
              "$ref": "#/$defs/LineOp",
              "description": "Whether both sides have it, only the new one, or only the old one."
            },
            "text": {
              "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ],
          "type": "object"
        },
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A hunk of a unified diff: one or more changes and the unchanged lines around them, with the\nnumbers of its header, `@@ -old_start,old_lines +new_start,new_lines @@`.",
      "properties": {
        "lines": {
          "description": "Its lines, in order; each change's removed lines come before its added lines.",
          "items": {
            "$ref": "#/$defs/DiffLineOut"
          },
          "type": "array"
        },
        "new_lines": {
          "description": "How many new lines it holds: its context and added lines.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "new_start": {
          "description": "The first new line it holds, counted as `old_start` is.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_lines": {
          "description": "How many old lines it holds: its context and removed lines.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_start": {
          "description": "The first old line it holds, counted from 1; when it holds none, the line before where\nthey would be (0 at the top), as git prints it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "old_start",
        "old_lines",
        "new_start",
        "new_lines",
        "lines"
      ],
      "title": "DiffHunk",
      "type": "object"
    },
    "DiffLineOut": {
      "$defs": {
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One line of a hunk.",
      "properties": {
        "op": {
          "$ref": "#/$defs/LineOp",
          "description": "Whether both sides have it, only the new one, or only the old one."
        },
        "text": {
          "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
          "type": "string"
        }
      },
      "required": [
        "op",
        "text"
      ],
      "title": "DiffLineOut",
      "type": "object"
    },
    "DiffReq": {
      "$defs": {
        "DiffFormat": {
          "description": "What `diff` says of each file.",
          "oneOf": [
            {
              "const": "names",
              "description": "Its path and status.",
              "type": "string"
            },
            {
              "const": "stat",
              "description": "Also whether it is binary and, for text, the lines it inserts and deletes.",
              "type": "string"
            },
            {
              "const": "unified",
              "description": "Also its kinds, its blobs and, for text, its hunks.",
              "type": "string"
            }
          ]
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`diff`: the files that differ between two revisions, in path order, a page at a time.",
      "properties": {
        "context": {
          "default": 3,
          "description": "The unchanged lines around each change in a `unified` hunk.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cursor": {
          "description": "Resume a diff: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page starts after the file it names.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "$ref": "#/$defs/DiffFormat",
          "default": "names",
          "description": "What to say of each file: `names` its path and status; `stat` also whether it is binary\nand, for text, the lines it inserts and deletes; `unified` also its kinds, its blobs and,\nfor text, its hunks."
        },
        "from": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to diff from: the old side."
        },
        "limit": {
          "default": 500,
          "description": "The most files to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_bytes": {
          "default": 32768,
          "description": "The most bytes a `unified` page's files take, as the JSON array `files` they print as: at\nleast 1 (0 is `E_INVALID_ARG`). The page stops before the first file that would take it\npast this, but always holds one file, whose hunks are cut to the first ones that fit\n(`hunks_truncated`) when they alone would pass it. A `names` or `stat` page is held by\n`limit` alone.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "paths": {
          "description": "Only the files at or below these repository paths (a file's path takes that file; one\ntrailing `/` is taken); every file when empty or omitted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "to": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to diff to: the new side."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DiffReq",
      "type": "object"
    },
    "DiffStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What happened to a file between the two revisions.",
      "oneOf": [
        {
          "const": "added",
          "description": "It is in `to` only: in `from`, nothing or a directory is there.",
          "type": "string"
        },
        {
          "const": "deleted",
          "description": "It is in `from` only.",
          "type": "string"
        },
        {
          "const": "modified",
          "description": "Its content or its exec bit changed: a file or an executable on both sides, or a\nsymlink on both sides.",
          "type": "string"
        },
        {
          "const": "type_changed",
          "description": "A symlink on one side, a file or an executable on the other.",
          "type": "string"
        }
      ],
      "title": "DiffStatus"
    },
    "EntryKindOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a tree entry is.",
      "oneOf": [
        {
          "const": "file",
          "description": "A regular file.",
          "type": "string"
        },
        {
          "const": "exec",
          "description": "An executable file.",
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink.",
          "type": "string"
        },
        {
          "const": "dir",
          "description": "A directory.",
          "type": "string"
        }
      ],
      "title": "EntryKindOut"
    },
    "Envelope": {
      "$defs": {
        "LogCutOut": {
          "description": "Where the journal was cut (`meta.recovered.log_cut`).",
          "properties": {
            "at": {
              "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "How many bytes were cut, to where the journal ended.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "at",
            "bytes"
          ],
          "type": "object"
        },
        "Meta": {
          "description": "What the envelope reports besides the outcome.",
          "properties": {
            "auth": {
              "description": "The store's authentication mode (`trust` in M1), not how this caller was identified.",
              "type": "string"
            },
            "elapsed_ms": {
              "description": "How long the command took, in milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "recovered": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RecoveredOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the command's write repaired before its own work, of what earlier writers left when\nthey crashed or failed after their commit point; omitted when there was nothing to repair,\nand for a command that writes nothing. `commit`, `ref_set` and `ref_delete` report it on\nsuccess and on `E_CAS_MISMATCH` alike, and lose it when they fail otherwise. Whoever\nwrites next gets it, not the agent whose process crashed, and it is no failure: `warnings`\nstill names only the steps after this command's own commit point that failed."
            },
            "repo": {
              "description": "The store as the user named it, for display; omitted when the command used no store.",
              "type": [
                "string",
                "null"
              ]
            },
            "resolved": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Every revision the command resolved: the string given and the full changeset id it named.",
              "type": "object"
            }
          },
          "required": [
            "elapsed_ms",
            "resolved",
            "auth"
          ],
          "type": "object"
        },
        "OpError": {
          "description": "A failed operation: the envelope's `error` object.\n\n`code`, `exit` and `retryable` come from one `ErrorCode`. `code` stays a string so a client\ncan read codes newer than its own table.",
          "properties": {
            "code": {
              "description": "The `E_*` code.",
              "type": "string"
            },
            "details": {
              "additionalProperties": true,
              "default": {},
              "description": "Machine-readable context, such as `actual` for `E_CAS_MISMATCH`; `{}` when there is none.",
              "type": "object"
            },
            "exit": {
              "description": "The exit code of the CLI.",
              "format": "int32",
              "type": "integer"
            },
            "hint": {
              "description": "The next command to run when there is an obvious one, else null.",
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "description": "What went wrong.",
              "type": "string"
            },
            "retryable": {
              "description": "Whether the operation can succeed when it is run again: as it is after a transient\nfailure, or, after a lost compare-and-swap, with what the error names re-read (the\nmessage says how; the `hint` reads it).",
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "exit",
            "details",
            "hint"
          ],
          "type": "object"
        },
        "RecoveredOut": {
          "description": "What a write's recovery repaired (`meta.recovered`), as offsets and counts in the store's\nmetadata files, with no paths: the storage spec (§2 rule 3, §3) says what each repair is.",
          "properties": {
            "frames_listed": {
              "description": "The journal frames listed that their writer never listed: transactions that committed,\ntheir writer having crashed between the frame's sync and its listing, or failed to list\nit (a warning then); and frames listed again whose entries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "frames_rewritten": {
              "description": "Of those, the frames written to the journal afresh first, because the sync that would\nhave made them durable failed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "index_records_dropped": {
              "description": "The changeset index records cut, counted in its longest column: records a crash left torn,\nor a power loss emptied.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "log_cut": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LogCutOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The torn tail cut off the end of the journal, if there was one: the bytes of a transaction\nthat never reached its commit point; omitted when nothing was cut."
            },
            "off_bytes_dropped": {
              "description": "The bytes dropped from the end of the journal's list of frames: part of an entry, or\nentries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "records_replayed": {
              "description": "The changesets replayed from the journal into the index.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "refs_replayed": {
              "description": "The ref files replayed from the journal: replaced, or removed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "views_rebuilt": {
              "description": "Whether a compaction of the changeset index that a crash interrupted was finished.",
              "type": "boolean"
            }
          },
          "required": [
            "frames_listed",
            "frames_rewritten",
            "off_bytes_dropped",
            "index_records_dropped",
            "views_rebuilt",
            "records_replayed",
            "refs_replayed"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One command's output: `result` on success, `error` on failure, `meta` either way.\n\nExactly one of `result` and `error` is present; the other is omitted, never written as null.",
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "properties": {
        "api": {
          "description": "The API version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "$ref": "#/$defs/OpError",
          "description": "The failure; present exactly when not `ok`."
        },
        "meta": {
          "$ref": "#/$defs/Meta",
          "description": "Context for either outcome."
        },
        "ok": {
          "description": "Whether the operation succeeded.",
          "type": "boolean"
        },
        "op": {
          "description": "The operation's name, such as `commit`.",
          "type": "string"
        },
        "result": {
          "description": "The operation's response; present exactly when `ok`."
        }
      },
      "required": [
        "ok",
        "op",
        "api",
        "meta"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "ErrorCode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Why an operation failed: a stable code with a fixed exit code and retry advice.\n\nSerialized as its `E_*` string, which `OpError.code` carries too, so a client can read\ncodes newer than its copy of this enum.",
      "oneOf": [
        {
          "const": "E_EXISTS",
          "description": "`init` found a store at the target path already.",
          "type": "string"
        },
        {
          "const": "E_NOT_A_REPO",
          "description": "No store at the given path, or no store was named.",
          "type": "string"
        },
        {
          "const": "E_IDENTITY_REQUIRED",
          "description": "A mutation was asked for without an identity.",
          "type": "string"
        },
        {
          "const": "E_REV_NOT_FOUND",
          "description": "A revision names no changeset.",
          "type": "string"
        },
        {
          "const": "E_AMBIGUOUS_ID",
          "description": "An id prefix matches more than one changeset; give more digits.",
          "type": "string"
        },
        {
          "const": "E_PATH_NOT_FOUND",
          "description": "The path does not exist at that revision.",
          "type": "string"
        },
        {
          "const": "E_IS_DIR",
          "description": "A file operation named a directory.",
          "type": "string"
        },
        {
          "const": "E_TOO_LARGE",
          "description": "The content is larger than the operation allows.",
          "type": "string"
        },
        {
          "const": "E_EMPTY_COMMIT",
          "description": "The commit changes nothing and `allow_empty` is off.",
          "type": "string"
        },
        {
          "const": "E_TYPE_CONFLICT",
          "description": "A change puts an entry below a file, or a file onto a directory.",
          "type": "string"
        },
        {
          "const": "E_UNKNOWN_PARENT",
          "description": "The parent changeset is not in the store.",
          "type": "string"
        },
        {
          "const": "E_CAS_MISMATCH",
          "description": "The ref no longer holds the expected target (or, with `create`, exists at another one);\n`details.actual` holds what it does, `null` when the ref does not exist.",
          "type": "string"
        },
        {
          "const": "E_REF_NOT_FOUND",
          "description": "No ref by that name.",
          "type": "string"
        },
        {
          "const": "E_REF_NAME_INVALID",
          "description": "The ref name is not `main` or `release/<name>`.",
          "type": "string"
        },
        {
          "const": "E_STORE_CORRUPT",
          "description": "Stored data failed verification. A metadata file that does not parse also names\n`details.fs_op` and `details.store_file`.",
          "type": "string"
        },
        {
          "const": "E_INVALID_ARG",
          "description": "A malformed argument or request, including a command-line usage error.",
          "type": "string"
        },
        {
          "const": "E_UNSUPPORTED_FS",
          "description": "The store path is not on a native Linux filesystem (for example WSL's `/mnt/*`).",
          "type": "string"
        },
        {
          "const": "E_IO",
          "description": "The filesystem refused an operation: `details.fs_op` names it, and `details.store_file`\nthe file of the store it was on, relative to the store's root. A journal append it\nrefused for want of permission or as a read-only filesystem also says\n`details.committed: false`: nothing was committed, and running the same operation again\nfails the same way until the hint's cause is fixed.",
          "type": "string"
        },
        {
          "const": "E_IO_TRANSIENT",
          "description": "A journal append failed, and the store cut what it wrote back off the journal\n(`details.committed` is `false`): nothing was committed, so running the same operation\nagain is safe. A failure after the commit point is no error: the operation succeeds,\nwith a warning. `details.fs_op` and `details.store_file` name the append that failed.",
          "type": "string"
        },
        {
          "const": "E_BUSY",
          "description": "Another writer held the store's metadata lock for the whole wait, or commits landed during\nevery one of a read's attempts to take a snapshot; nothing was committed (a commit's\nflushed objects may remain, for GC), and running the operation again can succeed.",
          "type": "string"
        },
        {
          "const": "E_INTERNAL",
          "description": "A bug in SwarmOps, such as a caught panic.",
          "type": "string"
        },
        {
          "const": "E_CONFLICT",
          "description": "The change conflicts with the target: `details.report` lists each conflicting file with\nits kind, its hunks and who changed it on the target. Nothing was recorded; resolve the\nconflicts, then land again (the `hint` says how).",
          "type": "string"
        },
        {
          "const": "E_CAS_RETRY_EXHAUSTED",
          "description": "The target moved before every one of the land's attempts could publish; nothing was\nrecorded, and running the land again can succeed.",
          "type": "string"
        },
        {
          "const": "E_NOTHING_TO_LAND",
          "description": "The land has nothing to add to the target: its head is on the target already, or its\nchange is (`details.reason` says which).",
          "type": "string"
        },
        {
          "const": "E_NOTHING_TO_UNDO",
          "description": "The operation moved no ref, so there is nothing to restore.",
          "type": "string"
        },
        {
          "const": "E_OP_NOT_FOUND",
          "description": "The store has no operation by that number.",
          "type": "string"
        },
        {
          "const": "E_AUTH",
          "description": "The caller's token failed verification.",
          "type": "string"
        },
        {
          "const": "E_POLICY_DENIED",
          "description": "A policy refused the operation for this identity.",
          "type": "string"
        },
        {
          "const": "E_MAINTENANCE_BUSY",
          "description": "Maintenance (gc or verify) holds the store's maintenance lease.",
          "type": "string"
        }
      ],
      "title": "ErrorCode"
    },
    "FileConflictOut": {
      "$defs": {
        "ConflictKindOut": {
          "description": "What kind of conflict a file has. `ours` is the change, `theirs` the target.",
          "oneOf": [
            {
              "const": "content",
              "description": "Both sides edited the same lines of a text file, or lines next to each other.",
              "type": "string"
            },
            {
              "const": "binary",
              "description": "Both sides changed the content of a file that is not text, or of a symlink, differently.",
              "type": "string"
            },
            {
              "const": "delete_modify",
              "description": "The change deleted the file, and the target changed it.",
              "type": "string"
            },
            {
              "const": "modify_delete",
              "description": "The change changed the file, and the target deleted it.",
              "type": "string"
            },
            {
              "const": "add_add",
              "description": "Both sides added the file, with contents that do not merge.",
              "type": "string"
            },
            {
              "const": "mode",
              "description": "Both sides changed the file's kind (file, executable or symlink), differently.",
              "type": "string"
            },
            {
              "const": "type_change",
              "description": "One side has a file where the other has a directory.",
              "type": "string"
            }
          ]
        },
        "HunkOut": {
          "description": "One place where the two sides' edits of a text file meet: each side's lines there. The lines\nare numbered from 1, and each side's range includes both ends, as `read_file` takes a range\nof lines.",
          "properties": {
            "base": {
              "$ref": "#/$defs/LinesOut",
              "description": "The lines at the merge base."
            },
            "id": {
              "description": "Its number in the file, from 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "ours": {
              "$ref": "#/$defs/LinesOut",
              "description": "The change's lines."
            },
            "theirs": {
              "$ref": "#/$defs/LinesOut",
              "description": "The target's lines."
            }
          },
          "required": [
            "id",
            "base",
            "ours",
            "theirs"
          ],
          "type": "object"
        },
        "LinesOut": {
          "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
          "properties": {
            "first": {
              "description": "The first line.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "last": {
              "description": "The last line; `first` minus one when the side has none.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "The lines' text; omitted when the report would pass its `max_conflict_bytes`\n(`truncated`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One conflicting file. Its blobs are the file's content on each side, which `read_file` reads\nat that side's changeset; a side without a file at the path (deleted, never added, or a\ndirectory there) has none.",
      "properties": {
        "base_blob": {
          "description": "Its blob at the merge base.",
          "type": [
            "string",
            "null"
          ]
        },
        "hunks": {
          "description": "The places where the two sides' edits of its lines meet, in file order: for a text file\nboth sides edited (`content`, and `add_add` of two texts). Omitted when there are none.",
          "items": {
            "$ref": "#/$defs/HunkOut"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ConflictKindOut",
          "description": "What kind of conflict it is."
        },
        "ours_blob": {
          "description": "Its blob in the change.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The file's repository path.",
          "type": "string"
        },
        "theirs_agent": {
          "description": "The agent that wrote `theirs_changeset`.",
          "type": [
            "string",
            "null"
          ]
        },
        "theirs_blob": {
          "description": "Its blob on the target.",
          "type": [
            "string",
            "null"
          ]
        },
        "theirs_changeset": {
          "description": "The newest changeset on the target since the merge base that changed this path: what to\nread for the other side's edit.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "FileConflictOut",
      "type": "object"
    },
    "FileContent": {
      "$defs": {
        "ContentEncoding": {
          "description": "How `FileContent.content` encodes bytes.",
          "oneOf": [
            {
              "const": "utf8",
              "description": "The bytes are UTF-8 text, and `content` is that text.",
              "type": "string"
            },
            {
              "const": "base64",
              "description": "`content` is the bytes in standard, padded base64.",
              "type": "string"
            }
          ]
        },
        "FileKind": {
          "description": "What a file is; never a directory.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            }
          ]
        },
        "LineRange": {
          "description": "A range of a file's lines, numbered from 1: `first` to `last`, both included.",
          "properties": {
            "first": {
              "description": "The range's first line: at least 1.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "last": {
              "description": "The range's last line: at least `first`.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_file` (CLI `cat`): a file's content, or the part of it the request names.",
      "properties": {
        "blob": {
          "description": "The blob's id.",
          "type": "string"
        },
        "content": {
          "description": "The bytes returned: those from `offset`, or the requested lines, at most `max_bytes` of\nthem. A cut keeps text as text: it falls where a character starts, so text may stop up to\n3 bytes short of `max_bytes`, while bytes that are not text stop at exactly `max_bytes`.",
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "description": "How `content` encodes the bytes it returns: `utf8` when they are text, `base64` when they\nare not (as when `offset` falls inside a character)."
        },
        "kind": {
          "$ref": "#/$defs/FileKind",
          "description": "The file's kind."
        },
        "lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a request by `lines`: the lines of its range that exist, which `content` holds (the\nstart of them when `truncated`); omitted when none does."
        },
        "next_offset": {
          "description": "When `truncated`: where `content` stops, the `offset` that reads on from there. A cut text\nholds whole characters, so a `max_bytes` under 4 can stop before a longer character at\nthe `offset` it started from.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "description": "Where `content` starts in the file, in bytes: the request's `offset`, or where the first\nof its `lines` that exists starts (the file's size when none does); omitted when that is\nthe file's start.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "description": "The whole blob's size in bytes, also when `content` is part of it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Whether `content` stops before the end of what was asked for: the file, from `offset`; or\nthe requested lines that exist.",
          "type": "boolean"
        }
      },
      "required": [
        "blob",
        "size",
        "kind",
        "encoding",
        "content",
        "truncated"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "FileDiff": {
      "$defs": {
        "DiffHunk": {
          "description": "A hunk of a unified diff: one or more changes and the unchanged lines around them, with the\nnumbers of its header, `@@ -old_start,old_lines +new_start,new_lines @@`.",
          "properties": {
            "lines": {
              "description": "Its lines, in order; each change's removed lines come before its added lines.",
              "items": {
                "$ref": "#/$defs/DiffLineOut"
              },
              "type": "array"
            },
            "new_lines": {
              "description": "How many new lines it holds: its context and added lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "new_start": {
              "description": "The first new line it holds, counted as `old_start` is.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_lines": {
              "description": "How many old lines it holds: its context and removed lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_start": {
              "description": "The first old line it holds, counted from 1; when it holds none, the line before where\nthey would be (0 at the top), as git prints it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "old_start",
            "old_lines",
            "new_start",
            "new_lines",
            "lines"
          ],
          "type": "object"
        },
        "DiffLineOut": {
          "description": "One line of a hunk.",
          "properties": {
            "op": {
              "$ref": "#/$defs/LineOp",
              "description": "Whether both sides have it, only the new one, or only the old one."
            },
            "text": {
              "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ],
          "type": "object"
        },
        "DiffStatus": {
          "description": "What happened to a file between the two revisions.",
          "oneOf": [
            {
              "const": "added",
              "description": "It is in `to` only: in `from`, nothing or a directory is there.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is in `from` only.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content or its exec bit changed: a file or an executable on both sides, or a\nsymlink on both sides.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A symlink on one side, a file or an executable on the other.",
              "type": "string"
            }
          ]
        },
        "FileKind": {
          "description": "What a file is; never a directory.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            }
          ]
        },
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One file that differs: a file, an executable or a symlink whose content or kind changed, or\nthat is on one side only. A directory never is one: a file that becomes a directory is that\nfile deleted and the directory's files added. No rename is detected: a file that moved is\none deleted and one added. Which fields follow `status` depends on the request's `format`,\nand a field that says nothing is omitted.",
      "properties": {
        "binary": {
          "description": "`stat` and `unified`: whether it is binary, which gets no line counts and no hunks: a side\nthat is not UTF-8, or holds a NUL in its first 8,000 bytes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "deletions": {
          "description": "`stat` and `unified`, for text: the lines the change deletes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hunks": {
          "description": "`unified`, for text: the hunks, in order; empty when only the exec bit or the kind\nchanged.",
          "items": {
            "$ref": "#/$defs/DiffHunk"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "hunks_truncated": {
          "description": "`unified`: true when `hunks` stops before the file's last hunk, to keep the page within\n`max_bytes`; omitted otherwise. `insertions` and `deletions` count every line all the\nsame.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "insertions": {
          "description": "`stat` and `unified`, for text: the lines the change inserts.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "new_blob": {
          "description": "`unified`: its blob id in `to`; omitted for a deleted file.",
          "type": [
            "string",
            "null"
          ]
        },
        "new_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "`unified`: its kind in `to`; omitted for a deleted file."
        },
        "old_blob": {
          "description": "`unified`: its blob id in `from`; omitted for an added file.",
          "type": [
            "string",
            "null"
          ]
        },
        "old_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "`unified`: its kind in `from`; omitted for an added file."
        },
        "path": {
          "description": "The repository path.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DiffStatus",
          "description": "What happened to it."
        }
      },
      "required": [
        "path",
        "status"
      ],
      "title": "FileDiff",
      "type": "object"
    },
    "FileKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a file is; never a directory.",
      "oneOf": [
        {
          "const": "file",
          "description": "A regular file.",
          "type": "string"
        },
        {
          "const": "exec",
          "description": "An executable file.",
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink.",
          "type": "string"
        }
      ],
      "title": "FileKind"
    },
    "HunkOut": {
      "$defs": {
        "LinesOut": {
          "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
          "properties": {
            "first": {
              "description": "The first line.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "last": {
              "description": "The last line; `first` minus one when the side has none.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "The lines' text; omitted when the report would pass its `max_conflict_bytes`\n(`truncated`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One place where the two sides' edits of a text file meet: each side's lines there. The lines\nare numbered from 1, and each side's range includes both ends, as `read_file` takes a range\nof lines.",
      "properties": {
        "base": {
          "$ref": "#/$defs/LinesOut",
          "description": "The lines at the merge base."
        },
        "id": {
          "description": "Its number in the file, from 0.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ours": {
          "$ref": "#/$defs/LinesOut",
          "description": "The change's lines."
        },
        "theirs": {
          "$ref": "#/$defs/LinesOut",
          "description": "The target's lines."
        }
      },
      "required": [
        "id",
        "base",
        "ours",
        "theirs"
      ],
      "title": "HunkOut",
      "type": "object"
    },
    "Identity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The caller of a mutation: an agent name `<family>/<instance>` (`agent/worker-17`,\n`human/purple`) and an optional run id. M1 trusts the name as claimed.\n\nThe agent name always follows the grammar below, also in an identity read from JSON.",
      "properties": {
        "agent": {
          "description": "`<family>/<instance>`, exactly as the schema's `pattern` and `maxLength` give it.",
          "maxLength": 255,
          "pattern": "^[a-z0-9-]+/[A-Za-z0-9_-][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "run_id": {
          "description": "The run the agent acts in, when it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent"
      ],
      "title": "Identity",
      "type": "object"
    },
    "IdentityInfo": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`whoami`: the identity the caller's mutations carry.",
      "properties": {
        "agent": {
          "description": "`<family>/<instance>`; omitted for an anonymous caller.",
          "type": [
            "string",
            "null"
          ]
        },
        "auth": {
          "description": "How this caller's identity was established: `trust` (claimed, not verified) or\n`anonymous`.",
          "type": "string"
        },
        "run_id": {
          "description": "The run the agent acts in, when it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "auth"
      ],
      "title": "IdentityInfo",
      "type": "object"
    },
    "InfoReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`info`: describe the store. It has no options yet.",
      "title": "InfoReq",
      "type": "object"
    },
    "InitReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`init`: create a store.",
      "properties": {
        "name": {
          "description": "The repository's name: at most 255 bytes of UTF-8.",
          "type": "string"
        },
        "path": {
          "description": "The directory to create the store in.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "name"
      ],
      "title": "InitReq",
      "type": "object"
    },
    "LandReq": {
      "$defs": {
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "ResolutionInput": {
          "description": "What a land makes of one path, and of every path below it: exactly one of `take`, `content`\nand `delete` (anything else is `E_INVALID_ARG`, a rule the server checks), the rest of the\nmerge as it merged.",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One file of new content, given as a commit's change gives it (inline, base64, a client\nfile, or a stored blob by id), within a commit's limits; nothing below it."
            },
            "delete": {
              "description": "Nothing there: no file at the path, nor below it.",
              "type": "boolean"
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModeInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The kind of the file `content` makes, only beside it; when omitted, the kind of the file\nours holds there, else theirs', else a regular file."
            },
            "take": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Side"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What one side holds there: `ours`, the change's head, or `theirs`, the target's head."
            }
          },
          "type": "object"
        },
        "ResolutionsInput": {
          "description": "A land's resolutions (`land --resolve`): what to make of some paths of the merge of the change\nonto the target, decided against one of the target's heads.",
          "properties": {
            "against": {
              "$ref": "#/$defs/Rev",
              "description": "The target's head the resolutions were decided against: the conflict report's `theirs`,\nby its full 64-hex id. A resolution applies while the target holds its path as this\nchangeset does (the same file, the same directory, or nothing)."
            },
            "files": {
              "additionalProperties": {
                "$ref": "#/$defs/ResolutionInput"
              },
              "description": "What to make of each path, by its repository path.",
              "type": "object"
            }
          },
          "required": [
            "against",
            "files"
          ],
          "type": "object"
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        },
        "Side": {
          "description": "One side of a land's merge.",
          "oneOf": [
            {
              "const": "ours",
              "description": "The change: its head.",
              "type": "string"
            },
            {
              "const": "theirs",
              "description": "The target: its head when the land merges.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`land`: merge a change three-way onto a target ref and publish it there as one new\nchangeset, in one transaction (operations spec §3). The change is `head` with its\nfirst-parent chain after `base`, squashed: the landed changeset's parent is the target's\nhead, so the target stays linear. A conflict is the error `E_CONFLICT`, with the report in\n`details.report`; nothing is recorded then.",
      "properties": {
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the change starts: a first-parent ancestor of `head`, whose own changes are not part\nof it (anything else is `E_INVALID_ARG`). It need not be on the target. When omitted, the\nmerge base of `head` and the target's head, along first parents."
        },
        "head": {
          "$ref": "#/$defs/Rev",
          "description": "The changeset to land: the change's head."
        },
        "idempotency_key": {
          "description": "Makes a retry of this land safe: 1 to 64 letters, digits and `-`, such as a uuid v7. A land\nwith a key first looks down the target's first parents, to `base`, for a changeset that\nlanded with the same key: one squashed from this `head` is the replay, which writes\nnothing (`status` is `replayed`); one from another head is `E_INVALID_ARG`, a key used\nfor another change.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_attempts": {
          "default": 8,
          "description": "How many times to try to publish before failing with `E_CAS_RETRY_EXHAUSTED`: 1 to 32.",
          "format": "uint32",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        },
        "max_conflict_bytes": {
          "default": 32768,
          "description": "The most bytes of hunk text an `E_CONFLICT` report carries: past it, the texts are left\nout (`truncated`), and the line positions and blob ids stay.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "description": "The landed changeset's message; `head`'s when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolutions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionsInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "What to make of the paths an `E_CONFLICT` report named, decided without a checkout\n(operations spec §3, resolution path (b)). Each resolution applies to its path while the\ntarget holds there what `against` held, whether the path conflicts or not; a path the\ntarget changed since is stale, and the land fails `E_CONFLICT` again, with a fresh report\nthat names it in `stale`. Conflicts left unresolved fail it too. `swarmops mcp` refuses\nan `against` that is not a full 64-hex id (`E_INVALID_ARG`)."
        },
        "target": {
          "default": "main",
          "description": "The ref to land on: `main` or `release/<name>`, which must exist.",
          "type": "string"
        }
      },
      "required": [
        "head"
      ],
      "title": "LandReq",
      "type": "object"
    },
    "LandResp": {
      "$defs": {
        "LandStatus": {
          "description": "How a land ended.",
          "oneOf": [
            {
              "const": "landed",
              "description": "This request landed the change.",
              "type": "string"
            },
            {
              "const": "replayed",
              "description": "A land with the same `idempotency_key` had landed it already; nothing was written.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`land`: where the change landed. Ids are full.",
      "properties": {
        "attempts": {
          "description": "How many times the land tried to publish.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "auto_merged": {
          "description": "The paths both sides changed that merged cleanly. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "base": {
          "description": "The changeset the change was taken from: what `head`'s first-parent chain added after it\nis what landed.",
          "type": "string"
        },
        "files_changed": {
          "description": "How many paths the landed changeset changes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "landed": {
          "description": "The landed changeset: the change squashed into one changeset on the target.",
          "type": "string"
        },
        "rebased_onto": {
          "description": "The target's head the change landed on: `landed`'s parent.",
          "type": "string"
        },
        "relocated": {
          "description": "The target moved after the land read it, and the publish put the change on the new head\nitself, without another attempt.",
          "type": "boolean"
        },
        "squashed_from": {
          "description": "The changesets the land squashed, oldest first: `head`'s first-parent chain after `base`,\nending at `head`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/LandStatus",
          "description": "`landed`, or `replayed` when a land with the same `idempotency_key` had landed the change\nalready."
        },
        "target": {
          "description": "The ref it landed on.",
          "type": "string"
        },
        "warnings": {
          "description": "Problems found after the land became durable, such as failed housekeeping; the land\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "landed",
        "rebased_onto",
        "target",
        "base",
        "attempts",
        "relocated",
        "files_changed",
        "squashed_from"
      ],
      "title": "LandResp",
      "type": "object"
    },
    "LandStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How a land ended.",
      "oneOf": [
        {
          "const": "landed",
          "description": "This request landed the change.",
          "type": "string"
        },
        {
          "const": "replayed",
          "description": "A land with the same `idempotency_key` had landed it already; nothing was written.",
          "type": "string"
        }
      ],
      "title": "LandStatus"
    },
    "LineOp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Which side of a diff a hunk's line is on.",
      "oneOf": [
        {
          "const": "context",
          "description": "Both: an unchanged line around a change.",
          "type": "string"
        },
        {
          "const": "add",
          "description": "The new side only.",
          "type": "string"
        },
        {
          "const": "remove",
          "description": "The old side only.",
          "type": "string"
        }
      ],
      "title": "LineOp"
    },
    "LineRange": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A range of a file's lines, numbered from 1: `first` to `last`, both included.",
      "properties": {
        "first": {
          "description": "The range's first line: at least 1.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "last": {
          "description": "The range's last line: at least `first`.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "first",
        "last"
      ],
      "title": "LineRange",
      "type": "object"
    },
    "LinesOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
      "properties": {
        "first": {
          "description": "The first line.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "last": {
          "description": "The last line; `first` minus one when the side has none.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "The lines' text; omitted when the report would pass its `max_conflict_bytes`\n(`truncated`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "first",
        "last"
      ],
      "title": "LinesOut",
      "type": "object"
    },
    "LogCutOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Where the journal was cut (`meta.recovered.log_cut`).",
      "properties": {
        "at": {
          "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bytes": {
          "description": "How many bytes were cut, to where the journal ended.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "bytes"
      ],
      "title": "LogCutOut",
      "type": "object"
    },
    "LogPage": {
      "$defs": {
        "ChangesetSummary": {
          "description": "One changeset of a log.",
          "properties": {
            "author_agent": {
              "description": "The agent that wrote it, as `show` gives `author.agent`.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "The changeset's id.",
              "type": "string"
            },
            "parents": {
              "description": "The parents' ids, mainline parent first.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "description": "The message's first line.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "parents",
            "author_agent",
            "created_at",
            "title"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`log`: a page of changesets, newest first, following first parents.",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page continues. Opaque: pass it back as given, as the\nnext request's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "description": "The changesets.",
          "items": {
            "$ref": "#/$defs/ChangesetSummary"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Whether older history follows this page.",
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "truncated"
      ],
      "title": "LogPage",
      "type": "object"
    },
    "LogReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`log`: history along first parents, a page at a time.",
      "properties": {
        "cursor": {
          "description": "Resume a log: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page continues from the first parent of the\nchangeset it names, and `rev` is not used.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "paths": {
          "description": "Only the changesets that change one of these paths: a file (its content or kind, or\nwhether it is there), or a directory and anything below it; one trailing `/` is taken.\nOmitted or empty for every changeset.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to start; `main` when omitted."
        }
      },
      "title": "LogReq",
      "type": "object"
    },
    "Meta": {
      "$defs": {
        "LogCutOut": {
          "description": "Where the journal was cut (`meta.recovered.log_cut`).",
          "properties": {
            "at": {
              "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "How many bytes were cut, to where the journal ended.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "at",
            "bytes"
          ],
          "type": "object"
        },
        "RecoveredOut": {
          "description": "What a write's recovery repaired (`meta.recovered`), as offsets and counts in the store's\nmetadata files, with no paths: the storage spec (§2 rule 3, §3) says what each repair is.",
          "properties": {
            "frames_listed": {
              "description": "The journal frames listed that their writer never listed: transactions that committed,\ntheir writer having crashed between the frame's sync and its listing, or failed to list\nit (a warning then); and frames listed again whose entries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "frames_rewritten": {
              "description": "Of those, the frames written to the journal afresh first, because the sync that would\nhave made them durable failed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "index_records_dropped": {
              "description": "The changeset index records cut, counted in its longest column: records a crash left torn,\nor a power loss emptied.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "log_cut": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LogCutOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The torn tail cut off the end of the journal, if there was one: the bytes of a transaction\nthat never reached its commit point; omitted when nothing was cut."
            },
            "off_bytes_dropped": {
              "description": "The bytes dropped from the end of the journal's list of frames: part of an entry, or\nentries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "records_replayed": {
              "description": "The changesets replayed from the journal into the index.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "refs_replayed": {
              "description": "The ref files replayed from the journal: replaced, or removed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "views_rebuilt": {
              "description": "Whether a compaction of the changeset index that a crash interrupted was finished.",
              "type": "boolean"
            }
          },
          "required": [
            "frames_listed",
            "frames_rewritten",
            "off_bytes_dropped",
            "index_records_dropped",
            "views_rebuilt",
            "records_replayed",
            "refs_replayed"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What the envelope reports besides the outcome.",
      "properties": {
        "auth": {
          "description": "The store's authentication mode (`trust` in M1), not how this caller was identified.",
          "type": "string"
        },
        "elapsed_ms": {
          "description": "How long the command took, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recovered": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveredOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the command's write repaired before its own work, of what earlier writers left when\nthey crashed or failed after their commit point; omitted when there was nothing to repair,\nand for a command that writes nothing. `commit`, `ref_set` and `ref_delete` report it on\nsuccess and on `E_CAS_MISMATCH` alike, and lose it when they fail otherwise. Whoever\nwrites next gets it, not the agent whose process crashed, and it is no failure: `warnings`\nstill names only the steps after this command's own commit point that failed."
        },
        "repo": {
          "description": "The store as the user named it, for display; omitted when the command used no store.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolved": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Every revision the command resolved: the string given and the full changeset id it named.",
          "type": "object"
        }
      },
      "required": [
        "elapsed_ms",
        "resolved",
        "auth"
      ],
      "title": "Meta",
      "type": "object"
    },
    "ModeInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The kind of entry a `put` writes.",
      "oneOf": [
        {
          "const": "file",
          "description": "A regular file (git mode 100644).",
          "type": "string"
        },
        {
          "const": "exec",
          "description": "An executable file (git mode 100755).",
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink; the content is the link's target.",
          "type": "string"
        }
      ],
      "title": "ModeInput"
    },
    "OpChangesetOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A changeset an operation recorded.",
      "properties": {
        "agent": {
          "description": "The agent that wrote it, as `show` gives `author.agent`.",
          "type": "string"
        },
        "created_at": {
          "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Its id.",
          "type": "string"
        },
        "land_key": {
          "description": "The idempotency key of the land that made it, when it had one.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "The message's first line.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent",
        "created_at",
        "title"
      ],
      "title": "OpChangesetOut",
      "type": "object"
    },
    "OpError": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A failed operation: the envelope's `error` object.\n\n`code`, `exit` and `retryable` come from one `ErrorCode`. `code` stays a string so a client\ncan read codes newer than its own table.",
      "properties": {
        "code": {
          "description": "The `E_*` code.",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "description": "Machine-readable context, such as `actual` for `E_CAS_MISMATCH`; `{}` when there is none.",
          "type": "object"
        },
        "exit": {
          "description": "The exit code of the CLI.",
          "format": "int32",
          "type": "integer"
        },
        "hint": {
          "description": "The next command to run when there is an obvious one, else null.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "What went wrong.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the operation can succeed when it is run again: as it is after a transient\nfailure, or, after a lost compare-and-swap, with what the error names re-read (the\nmessage says how; the `hint` reads it).",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "exit",
        "details",
        "hint"
      ],
      "title": "OpError",
      "type": "object"
    },
    "OpLogPage": {
      "$defs": {
        "OpChangesetOut": {
          "description": "A changeset an operation recorded.",
          "properties": {
            "agent": {
              "description": "The agent that wrote it, as `show` gives `author.agent`.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "Its id.",
              "type": "string"
            },
            "land_key": {
              "description": "The idempotency key of the land that made it, when it had one.",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "description": "The message's first line.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "agent",
            "created_at",
            "title"
          ],
          "type": "object"
        },
        "OperationKind": {
          "description": "What an operation did, read from what it recorded.",
          "oneOf": [
            {
              "const": "commit",
              "description": "It recorded changesets and moved no ref (`commit`).",
              "type": "string"
            },
            {
              "const": "publish",
              "description": "It recorded one changeset and moved a ref to it (`commit` with `advance`).",
              "type": "string"
            },
            {
              "const": "land",
              "description": "It recorded one changeset that names a lander and moved a ref to it (`land`).",
              "type": "string"
            },
            {
              "const": "ref_move",
              "description": "It moved refs and recorded no changeset (`ref set`, `ref delete`, `undo`).",
              "type": "string"
            },
            {
              "const": "compaction",
              "description": "It recorded a compaction of the changeset index, and nothing else.",
              "type": "string"
            },
            {
              "const": "mixed",
              "description": "Any other mix of changesets, ref moves and compactions.",
              "type": "string"
            }
          ]
        },
        "OperationOut": {
          "description": "One operation: a write transaction, as the journal recorded it.",
          "properties": {
            "changesets": {
              "description": "The changesets it recorded, in its order: at most the request's `max_changesets`.",
              "items": {
                "$ref": "#/$defs/OpChangesetOut"
              },
              "type": "array"
            },
            "changesets_total": {
              "description": "How many changesets it recorded in all, also past `max_changesets`.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "$ref": "#/$defs/OperationKind",
              "description": "What it did, read from what it recorded."
            },
            "op": {
              "description": "Its number: its journal frame's, from 0 in commit order. `undo` takes it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "ref_moves": {
              "description": "The ref moves it made, in its order.",
              "items": {
                "$ref": "#/$defs/RefMoveOut"
              },
              "type": "array"
            }
          },
          "required": [
            "op",
            "kind",
            "changesets",
            "changesets_total",
            "ref_moves"
          ],
          "type": "object"
        },
        "RefMoveOut": {
          "description": "A move of a ref, as the journal recorded it.",
          "properties": {
            "actor": {
              "description": "Who moved it.",
              "type": "string"
            },
            "at": {
              "description": "When it moved, in Unix seconds, as its writer recorded it.",
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "The ref.",
              "type": "string"
            },
            "new": {
              "description": "What it names after; omitted for the move that deleted it.",
              "type": [
                "string",
                "null"
              ]
            },
            "old": {
              "description": "What it named before; omitted for the move that created it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "actor",
            "at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`op_log` (CLI `op log`): a page of operations, newest first.",
      "properties": {
        "ops": {
          "description": "The operations.",
          "items": {
            "$ref": "#/$defs/OperationOut"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Whether older operations follow this page: give the last one's `op` as `before` to read\nthem.",
          "type": "boolean"
        }
      },
      "required": [
        "ops",
        "truncated"
      ],
      "title": "OpLogPage",
      "type": "object"
    },
    "OpLogReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`op_log` (CLI `op log`): the store's operations, newest first, a page at a time. An operation\nis one write transaction: a frame of the journal, numbered from 0 in commit order.",
      "properties": {
        "before": {
          "description": "Start below this operation: the page holds the ones numbered less than it, so the last\n`op` of a page reads on from there. When omitted, from the newest.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "description": "The most operations to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_changesets": {
          "default": 20,
          "description": "The most changesets to list for each operation; `changesets_total` counts them all.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "OpLogReq",
      "type": "object"
    },
    "OperationKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What an operation did, read from what it recorded.",
      "oneOf": [
        {
          "const": "commit",
          "description": "It recorded changesets and moved no ref (`commit`).",
          "type": "string"
        },
        {
          "const": "publish",
          "description": "It recorded one changeset and moved a ref to it (`commit` with `advance`).",
          "type": "string"
        },
        {
          "const": "land",
          "description": "It recorded one changeset that names a lander and moved a ref to it (`land`).",
          "type": "string"
        },
        {
          "const": "ref_move",
          "description": "It moved refs and recorded no changeset (`ref set`, `ref delete`, `undo`).",
          "type": "string"
        },
        {
          "const": "compaction",
          "description": "It recorded a compaction of the changeset index, and nothing else.",
          "type": "string"
        },
        {
          "const": "mixed",
          "description": "Any other mix of changesets, ref moves and compactions.",
          "type": "string"
        }
      ],
      "title": "OperationKind"
    },
    "OperationOut": {
      "$defs": {
        "OpChangesetOut": {
          "description": "A changeset an operation recorded.",
          "properties": {
            "agent": {
              "description": "The agent that wrote it, as `show` gives `author.agent`.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "Its id.",
              "type": "string"
            },
            "land_key": {
              "description": "The idempotency key of the land that made it, when it had one.",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "description": "The message's first line.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "agent",
            "created_at",
            "title"
          ],
          "type": "object"
        },
        "OperationKind": {
          "description": "What an operation did, read from what it recorded.",
          "oneOf": [
            {
              "const": "commit",
              "description": "It recorded changesets and moved no ref (`commit`).",
              "type": "string"
            },
            {
              "const": "publish",
              "description": "It recorded one changeset and moved a ref to it (`commit` with `advance`).",
              "type": "string"
            },
            {
              "const": "land",
              "description": "It recorded one changeset that names a lander and moved a ref to it (`land`).",
              "type": "string"
            },
            {
              "const": "ref_move",
              "description": "It moved refs and recorded no changeset (`ref set`, `ref delete`, `undo`).",
              "type": "string"
            },
            {
              "const": "compaction",
              "description": "It recorded a compaction of the changeset index, and nothing else.",
              "type": "string"
            },
            {
              "const": "mixed",
              "description": "Any other mix of changesets, ref moves and compactions.",
              "type": "string"
            }
          ]
        },
        "RefMoveOut": {
          "description": "A move of a ref, as the journal recorded it.",
          "properties": {
            "actor": {
              "description": "Who moved it.",
              "type": "string"
            },
            "at": {
              "description": "When it moved, in Unix seconds, as its writer recorded it.",
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "The ref.",
              "type": "string"
            },
            "new": {
              "description": "What it names after; omitted for the move that deleted it.",
              "type": [
                "string",
                "null"
              ]
            },
            "old": {
              "description": "What it named before; omitted for the move that created it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "actor",
            "at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One operation: a write transaction, as the journal recorded it.",
      "properties": {
        "changesets": {
          "description": "The changesets it recorded, in its order: at most the request's `max_changesets`.",
          "items": {
            "$ref": "#/$defs/OpChangesetOut"
          },
          "type": "array"
        },
        "changesets_total": {
          "description": "How many changesets it recorded in all, also past `max_changesets`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/OperationKind",
          "description": "What it did, read from what it recorded."
        },
        "op": {
          "description": "Its number: its journal frame's, from 0 in commit order. `undo` takes it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "ref_moves": {
          "description": "The ref moves it made, in its order.",
          "items": {
            "$ref": "#/$defs/RefMoveOut"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "kind",
        "changesets",
        "changesets_total",
        "ref_moves"
      ],
      "title": "OperationOut",
      "type": "object"
    },
    "PathHistoryEntry": {
      "$defs": {
        "ChangeOp": {
          "description": "What a change does to its path, in a commit's change list and a changeset's changes alike.",
          "oneOf": [
            {
              "const": "put",
              "description": "Write the content at the path, creating or replacing the entry.",
              "type": "string"
            },
            {
              "const": "delete",
              "description": "Remove the path.",
              "type": "string"
            }
          ]
        },
        "EntryKindOut": {
          "description": "What a tree entry is.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            },
            {
              "const": "dir",
              "description": "A directory.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One changeset of a path's history, and what the path holds after it.",
      "properties": {
        "author_agent": {
          "description": "The agent that wrote the changeset, as `log` gives it.",
          "type": "string"
        },
        "changeset": {
          "description": "The changeset's id.",
          "type": "string"
        },
        "created_at": {
          "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "A blob id for a file, an executable or a symlink; a tree id for a directory; omitted after\na `delete`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntryKindOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "What is at the path after it; omitted after a `delete`."
        },
        "op": {
          "$ref": "#/$defs/ChangeOp",
          "description": "`put` when something is at the path after the changeset, `delete` when nothing is."
        },
        "title": {
          "description": "The message's first line.",
          "type": "string"
        }
      },
      "required": [
        "changeset",
        "op",
        "author_agent",
        "created_at",
        "title"
      ],
      "title": "PathHistoryEntry",
      "type": "object"
    },
    "PathHistoryPage": {
      "$defs": {
        "ChangeOp": {
          "description": "What a change does to its path, in a commit's change list and a changeset's changes alike.",
          "oneOf": [
            {
              "const": "put",
              "description": "Write the content at the path, creating or replacing the entry.",
              "type": "string"
            },
            {
              "const": "delete",
              "description": "Remove the path.",
              "type": "string"
            }
          ]
        },
        "EntryKindOut": {
          "description": "What a tree entry is.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            },
            {
              "const": "dir",
              "description": "A directory.",
              "type": "string"
            }
          ]
        },
        "PathHistoryEntry": {
          "description": "One changeset of a path's history, and what the path holds after it.",
          "properties": {
            "author_agent": {
              "description": "The agent that wrote the changeset, as `log` gives it.",
              "type": "string"
            },
            "changeset": {
              "description": "The changeset's id.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "A blob id for a file, an executable or a symlink; a tree id for a directory; omitted after\na `delete`.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EntryKindOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What is at the path after it; omitted after a `delete`."
            },
            "op": {
              "$ref": "#/$defs/ChangeOp",
              "description": "`put` when something is at the path after the changeset, `delete` when nothing is."
            },
            "title": {
              "description": "The message's first line.",
              "type": "string"
            }
          },
          "required": [
            "changeset",
            "op",
            "author_agent",
            "created_at",
            "title"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`path_history` (CLI `history`): a page of a path's history, newest first.",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page continues. Opaque: pass it back as given, as the\nnext request's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "description": "The changesets that changed what it holds.",
          "items": {
            "$ref": "#/$defs/PathHistoryEntry"
          },
          "type": "array"
        },
        "path": {
          "description": "The path, without a trailing `/`.",
          "type": "string"
        },
        "truncated": {
          "description": "Whether an older changeset that changed it follows this page.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "entries",
        "truncated"
      ],
      "title": "PathHistoryPage",
      "type": "object"
    },
    "PathHistoryReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`path_history` (CLI `history`): the changesets that changed what a path holds, newest first,\nfollowing first parents, a page at a time.",
      "properties": {
        "cursor": {
          "description": "Resume a history: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page continues from the first parent of the\nchangeset it names, and `rev` is not used.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "The repository path: a file, whose history is that of its content and kind, or a\ndirectory, whose history is that of everything below it. One trailing `/` is taken.",
          "type": "string"
        },
        "rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to start; `main` when omitted."
        }
      },
      "required": [
        "path"
      ],
      "title": "PathHistoryReq",
      "type": "object"
    },
    "ReadFileReq": {
      "$defs": {
        "LineRange": {
          "description": "A range of a file's lines, numbered from 1: `first` to `last`, both included.",
          "properties": {
            "first": {
              "description": "The range's first line: at least 1.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "last": {
              "description": "The range's last line: at least `first`.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_file` (CLI `cat`): read one file at a revision, without a checkout: from an offset, or\na range of its lines.",
      "properties": {
        "lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "Read these lines instead, numbered from 1, both ends included: a line ends after its\nnewline, and a last line without one is a line too. The lines of the range that exist\ncome back, none past the file's last. Give this or `offset`, not both (`E_INVALID_ARG`)."
        },
        "max_bytes": {
          "default": 1048576,
          "description": "The most content bytes to return; more comes back truncated, with the `next_offset` to\nread on from.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Where to start reading, in bytes from the file's start: a truncated read's `next_offset`\nreads on from where it stopped. An offset past the end gives empty content. Give this or\n`lines`, not both (`E_INVALID_ARG`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "The file's repository path.",
          "type": "string"
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to read at."
        }
      },
      "required": [
        "rev",
        "path"
      ],
      "title": "ReadFileReq",
      "type": "object"
    },
    "ReadTreeReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_tree` (CLI `ls`): list one directory at a revision, without a checkout, a page at a\ntime; with `depth`, the directories below it too.",
      "properties": {
        "cursor": {
          "description": "Resume a listing: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page starts after the entry it names.",
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "default": 1,
          "description": "How many levels to list: 1 for the directory's own entries, 2 for theirs too, and so on, up\nto 64 (0 or more than 64 is `E_INVALID_ARG`).",
          "format": "uint32",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "limit": {
          "default": 250,
          "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "The directory's repository path; omitted for the root.",
          "type": [
            "string",
            "null"
          ]
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to read at."
        }
      },
      "required": [
        "rev"
      ],
      "title": "ReadTreeReq",
      "type": "object"
    },
    "RecoveredOut": {
      "$defs": {
        "LogCutOut": {
          "description": "Where the journal was cut (`meta.recovered.log_cut`).",
          "properties": {
            "at": {
              "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "How many bytes were cut, to where the journal ended.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "at",
            "bytes"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a write's recovery repaired (`meta.recovered`), as offsets and counts in the store's\nmetadata files, with no paths: the storage spec (§2 rule 3, §3) says what each repair is.",
      "properties": {
        "frames_listed": {
          "description": "The journal frames listed that their writer never listed: transactions that committed,\ntheir writer having crashed between the frame's sync and its listing, or failed to list\nit (a warning then); and frames listed again whose entries a power loss zeroed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frames_rewritten": {
          "description": "Of those, the frames written to the journal afresh first, because the sync that would\nhave made them durable failed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "index_records_dropped": {
          "description": "The changeset index records cut, counted in its longest column: records a crash left torn,\nor a power loss emptied.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "log_cut": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogCutOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "The torn tail cut off the end of the journal, if there was one: the bytes of a transaction\nthat never reached its commit point; omitted when nothing was cut."
        },
        "off_bytes_dropped": {
          "description": "The bytes dropped from the end of the journal's list of frames: part of an entry, or\nentries a power loss zeroed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "records_replayed": {
          "description": "The changesets replayed from the journal into the index.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "refs_replayed": {
          "description": "The ref files replayed from the journal: replaced, or removed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "views_rebuilt": {
          "description": "Whether a compaction of the changeset index that a crash interrupted was finished.",
          "type": "boolean"
        }
      },
      "required": [
        "frames_listed",
        "frames_rewritten",
        "off_bytes_dropped",
        "index_records_dropped",
        "views_rebuilt",
        "records_replayed",
        "refs_replayed"
      ],
      "title": "RecoveredOut",
      "type": "object"
    },
    "RefDeleteReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref delete`: remove a ref by compare-and-swap.",
      "properties": {
        "expected_old": {
          "$ref": "#/$defs/Rev",
          "description": "The target the caller last saw, by its full changeset id; if the ref holds another, the\ndelete fails with `E_CAS_MISMATCH`. A ref name or a relative revision is read from the\nstore when the delete runs instead of pinning the id the caller read: the ref's own name\nalways matches, so the compare-and-swap protects nothing, and `main~1` on `main` never\nmatches. An id prefix pins the id the caller read only until another changeset shares\nit; then it is `E_AMBIGUOUS_ID`. `swarmops mcp` refuses all three (`E_INVALID_ARG`), and\nthe CLI's `--expect` help warns against them."
        },
        "name": {
          "description": "The ref.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "expected_old"
      ],
      "title": "RefDeleteReq",
      "type": "object"
    },
    "RefListReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref list`: list every ref. It has no options yet.",
      "title": "RefListReq",
      "type": "object"
    },
    "RefListResp": {
      "$defs": {
        "RefOut": {
          "description": "One ref.",
          "properties": {
            "name": {
              "description": "`main` or `release/<name>`.",
              "type": "string"
            },
            "target": {
              "description": "The changeset it points at.",
              "type": "string"
            },
            "version": {
              "description": "How many committed moves changed its target.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "name",
            "target",
            "version"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref list`: every ref.",
      "properties": {
        "refs": {
          "description": "The refs.",
          "items": {
            "$ref": "#/$defs/RefOut"
          },
          "type": "array"
        }
      },
      "required": [
        "refs"
      ],
      "title": "RefListResp",
      "type": "object"
    },
    "RefMoveOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A move of a ref, as the journal recorded it.",
      "properties": {
        "actor": {
          "description": "Who moved it.",
          "type": "string"
        },
        "at": {
          "description": "When it moved, in Unix seconds, as its writer recorded it.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "description": "The ref.",
          "type": "string"
        },
        "new": {
          "description": "What it names after; omitted for the move that deleted it.",
          "type": [
            "string",
            "null"
          ]
        },
        "old": {
          "description": "What it named before; omitted for the move that created it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "actor",
        "at"
      ],
      "title": "RefMoveOut",
      "type": "object"
    },
    "RefOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One ref.",
      "properties": {
        "name": {
          "description": "`main` or `release/<name>`.",
          "type": "string"
        },
        "target": {
          "description": "The changeset it points at.",
          "type": "string"
        },
        "version": {
          "description": "How many committed moves changed its target.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "target",
        "version"
      ],
      "title": "RefOut",
      "type": "object"
    },
    "RefSetReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref set`: move a ref, or create one, by compare-and-swap. Give exactly one of\n`expected_old` and `create`; both or neither is `E_INVALID_ARG`.",
      "oneOf": [
        {
          "properties": {
            "create": {
              "const": false
            },
            "expected_old": {
              "type": "string"
            }
          },
          "required": [
            "expected_old"
          ]
        },
        {
          "properties": {
            "create": {
              "const": true
            },
            "expected_old": {
              "type": "null"
            }
          },
          "required": [
            "create"
          ]
        }
      ],
      "properties": {
        "create": {
          "default": false,
          "description": "To create the ref. If it exists at another target, the move fails with `E_CAS_MISMATCH`;\nif it already holds `new`, nothing is written and the response is a replay\n(`already_applied`). Give this or `expected_old`, not both.",
          "type": "boolean"
        },
        "expected_old": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "To move an existing ref: the target the caller last saw, by its full changeset id; if the\nref holds another, the move fails with `E_CAS_MISMATCH`. A ref name or a relative\nrevision is read from the store when the move runs instead of pinning the id the caller\nread: the ref's own name always matches, so the compare-and-swap protects nothing, and\n`main~1` on `main` never matches. An id prefix pins the id the caller read only until\nanother changeset shares it; then it is `E_AMBIGUOUS_ID`. `swarmops mcp` refuses all\nthree (`E_INVALID_ARG`), and the CLI's `--expect` help warns against them. Give this or\n`create`, not both."
        },
        "name": {
          "description": "The ref: `main` or `release/<name>`.",
          "type": "string"
        },
        "new": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to point it at."
        }
      },
      "required": [
        "name",
        "new"
      ],
      "title": "RefSetReq",
      "type": "object"
    },
    "RefSetResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ref set` and `ref delete`: the move that was made.",
      "properties": {
        "already_applied": {
          "description": "The ref was already in the requested state, so nothing changed and a replay is safe;\n`old` and `new` are then the request's `expected_old` and `new`, resolved to full ids.",
          "type": "boolean"
        },
        "name": {
          "description": "The ref.",
          "type": "string"
        },
        "new": {
          "description": "Its target after; omitted when the ref was deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "old": {
          "description": "What the ref held before a move that was applied. On a replay (`already_applied`) it is\n`expected_old` as resolved, which the ref need not have held; omitted when `create` was\ngiven.",
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "description": "Problems found after the move became durable, such as failed housekeeping; the move\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "already_applied"
      ],
      "title": "RefSetResp",
      "type": "object"
    },
    "RepoInfo": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`init` and `info`: what the store is and holds.",
      "properties": {
        "changesets": {
          "description": "How many changesets the store holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "main": {
          "description": "The changeset `main` points at; omitted until `main` exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The name given at `init`.",
          "type": "string"
        },
        "refs": {
          "description": "How many refs the store holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repo_id": {
          "description": "The store's id, fixed at `init`.",
          "type": "string"
        },
        "store_version": {
          "description": "The store format version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "repo_id",
        "name",
        "store_version",
        "changesets",
        "refs"
      ],
      "title": "RepoInfo",
      "type": "object"
    },
    "ResolutionInput": {
      "$defs": {
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "Side": {
          "description": "One side of a land's merge.",
          "oneOf": [
            {
              "const": "ours",
              "description": "The change: its head.",
              "type": "string"
            },
            {
              "const": "theirs",
              "description": "The target: its head when the land merges.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a land makes of one path, and of every path below it: exactly one of `take`, `content`\nand `delete` (anything else is `E_INVALID_ARG`, a rule the server checks), the rest of the\nmerge as it merged.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "One file of new content, given as a commit's change gives it (inline, base64, a client\nfile, or a stored blob by id), within a commit's limits; nothing below it."
        },
        "delete": {
          "description": "Nothing there: no file at the path, nor below it.",
          "type": "boolean"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "The kind of the file `content` makes, only beside it; when omitted, the kind of the file\nours holds there, else theirs', else a regular file."
        },
        "take": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "description": "What one side holds there: `ours`, the change's head, or `theirs`, the target's head."
        }
      },
      "title": "ResolutionInput",
      "type": "object"
    },
    "ResolutionsInput": {
      "$defs": {
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "ResolutionInput": {
          "description": "What a land makes of one path, and of every path below it: exactly one of `take`, `content`\nand `delete` (anything else is `E_INVALID_ARG`, a rule the server checks), the rest of the\nmerge as it merged.",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One file of new content, given as a commit's change gives it (inline, base64, a client\nfile, or a stored blob by id), within a commit's limits; nothing below it."
            },
            "delete": {
              "description": "Nothing there: no file at the path, nor below it.",
              "type": "boolean"
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModeInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The kind of the file `content` makes, only beside it; when omitted, the kind of the file\nours holds there, else theirs', else a regular file."
            },
            "take": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Side"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What one side holds there: `ours`, the change's head, or `theirs`, the target's head."
            }
          },
          "type": "object"
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        },
        "Side": {
          "description": "One side of a land's merge.",
          "oneOf": [
            {
              "const": "ours",
              "description": "The change: its head.",
              "type": "string"
            },
            {
              "const": "theirs",
              "description": "The target: its head when the land merges.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A land's resolutions (`land --resolve`): what to make of some paths of the merge of the change\nonto the target, decided against one of the target's heads.",
      "properties": {
        "against": {
          "$ref": "#/$defs/Rev",
          "description": "The target's head the resolutions were decided against: the conflict report's `theirs`,\nby its full 64-hex id. A resolution applies while the target holds its path as this\nchangeset does (the same file, the same directory, or nothing)."
        },
        "files": {
          "additionalProperties": {
            "$ref": "#/$defs/ResolutionInput"
          },
          "description": "What to make of each path, by its repository path.",
          "type": "object"
        }
      },
      "required": [
        "against",
        "files"
      ],
      "title": "ResolutionsInput",
      "type": "object"
    },
    "ResolveRevReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`resolve_rev` (CLI `resolve`): the changeset a revision names, as every operation resolves it.",
      "properties": {
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to resolve."
        }
      },
      "required": [
        "rev"
      ],
      "title": "ResolveRevReq",
      "type": "object"
    },
    "ResolvedRev": {
      "$defs": {
        "RevKind": {
          "description": "What kind of revision `resolve_rev` resolved. M5 adds `workspace`, for a workspace's head and\nthe edits not committed yet (`ws:<name>`).",
          "oneOf": [
            {
              "const": "ref",
              "description": "Exactly a ref's name (`main`, `release/<name>`): `id` is what the ref names now, and moves\nwhen the ref does.",
              "type": "string"
            },
            {
              "const": "changeset",
              "description": "Any other revision: a full changeset id, a unique prefix of one, or a revision followed by\n`~N` suffixes, a ref's name among them.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`resolve_rev` (CLI `resolve`): the changeset a revision names, and what kind of revision it is.",
      "properties": {
        "id": {
          "description": "The full id of the changeset the revision names.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RevKind",
          "description": "What the revision is: `ref` when it is exactly a ref's name, `changeset` otherwise."
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ResolvedRev",
      "type": "object"
    },
    "Rev": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
      "title": "Rev",
      "type": "string"
    },
    "RevKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What kind of revision `resolve_rev` resolved. M5 adds `workspace`, for a workspace's head and\nthe edits not committed yet (`ws:<name>`).",
      "oneOf": [
        {
          "const": "ref",
          "description": "Exactly a ref's name (`main`, `release/<name>`): `id` is what the ref names now, and moves\nwhen the ref does.",
          "type": "string"
        },
        {
          "const": "changeset",
          "description": "Any other revision: a full changeset id, a unique prefix of one, or a revision followed by\n`~N` suffixes, a ref's name among them.",
          "type": "string"
        }
      ],
      "title": "RevKind"
    },
    "ShowReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`show`: one changeset in full.",
      "properties": {
        "max_changes": {
          "default": 400,
          "description": "The most entries of `changes` to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The changeset to show."
        }
      },
      "required": [
        "rev"
      ],
      "title": "ShowReq",
      "type": "object"
    },
    "Side": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One side of a land's merge.",
      "oneOf": [
        {
          "const": "ours",
          "description": "The change: its head.",
          "type": "string"
        },
        {
          "const": "theirs",
          "description": "The target: its head when the land merges.",
          "type": "string"
        }
      ],
      "title": "Side"
    },
    "SignatureOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A git signature: who, and when.",
      "properties": {
        "email": {
          "description": "The email.",
          "type": "string"
        },
        "name": {
          "description": "The name; the agent name for a native changeset.",
          "type": "string"
        },
        "offset_secs": {
          "description": "The UTC offset in seconds.",
          "format": "int32",
          "type": "integer"
        },
        "secs": {
          "description": "Unix time in seconds.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "email",
        "secs",
        "offset_secs"
      ],
      "title": "SignatureOut",
      "type": "object"
    },
    "Signatures": {
      "$defs": {
        "SignatureOut": {
          "description": "A git signature: who, and when.",
          "properties": {
            "email": {
              "description": "The email.",
              "type": "string"
            },
            "name": {
              "description": "The name; the agent name for a native changeset.",
              "type": "string"
            },
            "offset_secs": {
              "description": "The UTC offset in seconds.",
              "format": "int32",
              "type": "integer"
            },
            "secs": {
              "description": "Unix time in seconds.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "name",
            "email",
            "secs",
            "offset_secs"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A changeset's git signatures: git-fidelity data for import and export.",
      "properties": {
        "author": {
          "$ref": "#/$defs/SignatureOut",
          "description": "The git author."
        },
        "committer": {
          "$ref": "#/$defs/SignatureOut",
          "description": "The git committer; its time is `created_at`."
        }
      },
      "required": [
        "author",
        "committer"
      ],
      "title": "Signatures",
      "type": "object"
    },
    "TreeEntryOut": {
      "$defs": {
        "EntryKindOut": {
          "description": "What a tree entry is.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            },
            {
              "const": "dir",
              "description": "A directory.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One entry of a listing.",
      "properties": {
        "id": {
          "description": "A blob id for a file, an executable or a symlink; a tree id for a directory.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntryKindOut",
          "description": "What the entry is."
        },
        "name": {
          "description": "The entry's name: one path component.",
          "type": "string"
        },
        "path": {
          "description": "Its path below the listed directory, given when the request's `depth` is more than 1: its\nname, for one of the directory's own entries.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "For a file, an executable or a symlink: its content's size in bytes; omitted for a\ndirectory.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "id"
      ],
      "title": "TreeEntryOut",
      "type": "object"
    },
    "TreeListing": {
      "$defs": {
        "EntryKindOut": {
          "description": "What a tree entry is.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            },
            {
              "const": "dir",
              "description": "A directory.",
              "type": "string"
            }
          ]
        },
        "TreeEntryOut": {
          "description": "One entry of a listing.",
          "properties": {
            "id": {
              "description": "A blob id for a file, an executable or a symlink; a tree id for a directory.",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/EntryKindOut",
              "description": "What the entry is."
            },
            "name": {
              "description": "The entry's name: one path component.",
              "type": "string"
            },
            "path": {
              "description": "Its path below the listed directory, given when the request's `depth` is more than 1: its\nname, for one of the directory's own entries.",
              "type": [
                "string",
                "null"
              ]
            },
            "size": {
              "description": "For a file, an executable or a symlink: its content's size in bytes; omitted for a\ndirectory.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_tree` (CLI `ls`): a page of a directory's entries, in pre-order: a directory, then the\nentries below it to the request's `depth`, each directory's entries by name bytes (at `depth`\n1, the tree's order).",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page starts. Opaque: pass it back as given, as the next\nrequest's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "description": "The entries.",
          "items": {
            "$ref": "#/$defs/TreeEntryOut"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Whether more entries follow this page.",
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "truncated"
      ],
      "title": "TreeListing",
      "type": "object"
    },
    "UndoReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`undo` (CLI `op undo`): restore every ref an operation moved to what it named before, by\ncompare-and-swap, in one transaction: all of them or none. Changesets are never removed.",
      "properties": {
        "op": {
          "description": "The operation to undo: its `op` in the operation log.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "op"
      ],
      "title": "UndoReq",
      "type": "object"
    },
    "UndoResp": {
      "$defs": {
        "RefMoveOut": {
          "description": "A move of a ref, as the journal recorded it.",
          "properties": {
            "actor": {
              "description": "Who moved it.",
              "type": "string"
            },
            "at": {
              "description": "When it moved, in Unix seconds, as its writer recorded it.",
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "The ref.",
              "type": "string"
            },
            "new": {
              "description": "What it names after; omitted for the move that deleted it.",
              "type": [
                "string",
                "null"
              ]
            },
            "old": {
              "description": "What it named before; omitted for the move that created it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "actor",
            "at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`undo` (CLI `op undo`): the moves that restored the refs.",
      "properties": {
        "already_applied": {
          "description": "Every ref the operation moved already names what it named before, so nothing was written:\nan undo run again is a replay, and safe.",
          "type": "boolean"
        },
        "op": {
          "description": "The operation this undo recorded, which another undo can take; omitted when it wrote\nnothing (`already_applied`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ref_moves": {
          "description": "The moves it made: each ref from what the operation set back to what it named before.",
          "items": {
            "$ref": "#/$defs/RefMoveOut"
          },
          "type": "array"
        },
        "undone": {
          "description": "The operation undone.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "description": "Problems found after the undo became durable, such as failed housekeeping; the undo\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "undone",
        "ref_moves",
        "already_applied"
      ],
      "title": "UndoResp",
      "type": "object"
    },
    "VerifyFinding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One problem `verify` found, as a program reads it: what kind of damage it is, and what it\nnames. The keys its kind does not use are omitted; the line at the same index of `problems`\nsays the same for a reader. Ids are lowercase hex.",
      "properties": {
        "cause": {
          "description": "What disagrees with the record (`index_mismatch`), which says what mends it: `journal`\n(rebuild the index from the journal), `sorted_view` (rebuild the sorted views from the\nindex columns) or `object` (derive the record from its object again).",
          "type": [
            "string",
            "null"
          ]
        },
        "changeset": {
          "description": "The changeset: the first, in seq order, that references the missing object\n(`missing_object`), the one that names a missing parent (`missing_parent`), or the one\nwhose root is not its first parent's root with its delta applied (`root_mismatch`).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "What is damaged: `corrupt_object`, `missing_object`, `missing_parent`, `root_mismatch`,\n`dangling_ref`, `corrupt_ref`, `index_mismatch`, `journal_corrupt` or `meta_corrupt`. A\nstring, as `OpError.code` is, so that a client can read kinds newer than its own list.",
          "type": "string"
        },
        "object": {
          "description": "The object: one whose content does not hash to its id or does not decode\n(`corrupt_object`), or one a changeset references that the store lacks, or holds as\nanother kind (`missing_object`).",
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "description": "Where the corrupt frame starts in `journal.log` (`journal_corrupt`); nothing after it\nis read.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parent": {
          "description": "The parent the changeset names, which the store does not hold (`missing_parent`).",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "The ref: one that names no changeset in the store (`dangling_ref`), or whose file does\nnot read as a ref (`corrupt_ref`).",
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "description": "The changeset record's place in the index, from 0 (`index_mismatch`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "title": "VerifyFinding",
      "type": "object"
    },
    "VerifyReport": {
      "$defs": {
        "VerifyFinding": {
          "description": "One problem `verify` found, as a program reads it: what kind of damage it is, and what it\nnames. The keys its kind does not use are omitted; the line at the same index of `problems`\nsays the same for a reader. Ids are lowercase hex.",
          "properties": {
            "cause": {
              "description": "What disagrees with the record (`index_mismatch`), which says what mends it: `journal`\n(rebuild the index from the journal), `sorted_view` (rebuild the sorted views from the\nindex columns) or `object` (derive the record from its object again).",
              "type": [
                "string",
                "null"
              ]
            },
            "changeset": {
              "description": "The changeset: the first, in seq order, that references the missing object\n(`missing_object`), the one that names a missing parent (`missing_parent`), or the one\nwhose root is not its first parent's root with its delta applied (`root_mismatch`).",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "description": "What is damaged: `corrupt_object`, `missing_object`, `missing_parent`, `root_mismatch`,\n`dangling_ref`, `corrupt_ref`, `index_mismatch`, `journal_corrupt` or `meta_corrupt`. A\nstring, as `OpError.code` is, so that a client can read kinds newer than its own list.",
              "type": "string"
            },
            "object": {
              "description": "The object: one whose content does not hash to its id or does not decode\n(`corrupt_object`), or one a changeset references that the store lacks, or holds as\nanother kind (`missing_object`).",
              "type": [
                "string",
                "null"
              ]
            },
            "offset": {
              "description": "Where the corrupt frame starts in `journal.log` (`journal_corrupt`); nothing after it\nis read.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "parent": {
              "description": "The parent the changeset names, which the store does not hold (`missing_parent`).",
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "description": "The ref: one that names no changeset in the store (`dangling_ref`), or whose file does\nnot read as a ref (`corrupt_ref`).",
              "type": [
                "string",
                "null"
              ]
            },
            "seq": {
              "description": "The changeset record's place in the index, from 0 (`index_mismatch`).",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`verify`: what the consistency check found.",
      "properties": {
        "changesets_checked": {
          "description": "How many changesets were checked.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "findings": {
          "default": [],
          "description": "One finding per problem found, for a program to act on: `findings[i]` is the problem\nthat the line `problems[i]` describes. Empty for a clean store; a report without it\nreads as having none.",
          "items": {
            "$ref": "#/$defs/VerifyFinding"
          },
          "type": "array"
        },
        "objects_checked": {
          "description": "How many objects were checked.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "problems": {
          "description": "One line per problem found, for a reader of lines; empty for a clean store. `findings`\nholds the same problems, at the same indexes, for a program.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "objects_checked",
        "changesets_checked",
        "problems"
      ],
      "title": "VerifyReport",
      "type": "object"
    },
    "VerifyReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`verify`: check the whole store's consistency.",
      "properties": {
        "deep": {
          "default": false,
          "description": "Re-hash every object. When `false`, verify checks structure only: parents, that\nreferenced objects exist, the index against the journal, and refs.",
          "type": "boolean"
        }
      },
      "title": "VerifyReq",
      "type": "object"
    }
  },
  "meta": {
    "elapsed_ms": "[elapsed_ms]",
    "resolved": {},
    "auth": "trust"
  }
}
