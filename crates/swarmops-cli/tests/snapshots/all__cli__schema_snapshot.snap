          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_discard`: the paths restored.",
      "properties": {
        "discarded": {
          "description": "The paths restored.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/WsStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "The status after the mutation; omitted when the request said `none`."
        }
      },
      "required": [
        "discarded"
      ],
      "title": "WsDiscardResp",
      "type": "object"
    },
    "WsInfo": {
      "$defs": {
        "WsChange": {
          "description": "One changed path of a workspace.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/WsChangeKind",
              "description": "What changed."
            },
            "path": {
              "description": "The repository path.",
              "type": "string"
            },
            "size": {
              "description": "The file's size now; omitted for a deleted path.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "kind"
          ],
          "type": "object"
        },
        "WsChangeKind": {
          "description": "What changed at a workspace path.",
          "oneOf": [
            {
              "const": "added",
              "description": "A file the head does not hold.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content changed.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is gone.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A file became a symlink, or the other way round.",
              "type": "string"
            },
            {
              "const": "mode_changed",
              "description": "Its executable bit changed.",
              "type": "string"
            }
          ]
        },
        "WsRebasing": {
          "description": "A workspace's rebase in progress.",
          "properties": {
            "conflicts": {
              "description": "The paths that still conflict.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "onto": {
              "description": "The target's head it rebases onto.",
              "type": "string"
            }
          },
          "required": [
            "onto",
            "conflicts"
          ],
          "type": "object"
        },
        "WsState": {
          "description": "A workspace's state.",
          "oneOf": [
            {
              "const": "clean",
              "description": "No rebase in progress.",
              "type": "string"
            },
            {
              "const": "rebasing",
              "description": "A rebase stopped on conflicts.",
              "type": "string"
            }
          ]
        },
        "WsStatus": {
          "description": "A workspace's status: its changes against its head, a page at a time, and how far its target\nhas moved since its base.",
          "properties": {
            "base": {
              "description": "The target's changeset its chain starts from.",
              "type": "string"
            },
            "behind_by": {
              "description": "How many changesets the target's first-parent history holds that `base`'s lacks: those\npast `base` when it is on that history; otherwise (a sync dropped it, or the target moved\nback) those before where the two histories meet, 0 when the target head is on `base`'s\nfirst-parent history fewer than 10,000 changesets behind `base`. At most 10,000.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "changes": {
              "description": "The changes, by path.",
              "items": {
                "$ref": "#/$defs/WsChange"
              },
              "type": "array"
            },
            "cursor": {
              "description": "Where this page stopped.",
              "type": [
                "string",
                "null"
              ]
            },
            "head": {
              "description": "Its chain's last changeset.",
              "type": "string"
            },
            "main": {
              "description": "The head of the workspace's target ref (`main`, or `release/<name>`), read first.",
              "type": "string"
            },
            "name": {
              "description": "The workspace's name.",
              "type": "string"
            },
            "rebasing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WsRebasing"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The rebase in progress, when `state` is `rebasing`."
            },
            "state": {
              "$ref": "#/$defs/WsState",
              "description": "Whether the workspace is rebasing."
            },
            "truncated": {
              "description": "Whether more changes follow: give `cursor` to read them.",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "base",
            "head",
            "main",
            "behind_by",
            "state",
            "changes",
            "truncated"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A workspace: where it is and what it holds.",
      "properties": {
        "all": {
          "description": "Whether the whole tree is written out.",
          "type": "boolean"
        },
        "base": {
          "description": "The target's changeset its chain starts from.",
          "type": "string"
        },
        "created": {
          "default": false,
          "description": "Whether this request made it: false for one that existed.",
          "type": "boolean"
        },
        "head": {
          "description": "Its chain's last changeset; `base` when nothing is committed.",
          "type": "string"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "orphan": {
          "description": "Whether its directory is gone while its entry stays (`ws_list` with `check`).",
          "type": "boolean"
        },
        "path": {
          "description": "Its directory on the caller's host.",
          "type": "string"
        },
        "prefixes": {
          "description": "The repository paths written out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/WsStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "The status after the mutation; omitted when the request said `none`."
        }
      },
      "required": [
        "name",
        "path",
        "base",
        "head"
      ],
      "title": "WsInfo",
      "type": "object"
    },
    "WsInfoReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_info` (client-side): one workspace.",
      "properties": {
        "workspace": {
          "description": "The workspace, by name.",
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "title": "WsInfoReq",
      "type": "object"
    },
    "WsLandReq": {
      "$defs": {
        "LandMode": {
          "description": "How a workspace lands.",
          "oneOf": [
            {
              "const": "merge",
              "description": "Merge onto the target's head, wherever it has moved.",
              "type": "string"
            },
            {
              "const": "exact",
              "description": "Publish only onto the target's head the workspace was rebased onto, so that the landed\ntree is the rebased one.",
              "type": "string"
            }
          ]
        },
        "StatusAfter": {
          "description": "Whether a workspace mutation's response carries the workspace's status after it.",
          "oneOf": [
            {
              "const": "page",
              "description": "The first page of the status, up to 100 changes.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No status.",
              "type": "string"
            }
          ]
        },
        "WsCheckInput": {
          "description": "The check a workspace's land runs.",
          "properties": {
            "argv": {
              "description": "The command and its arguments, run without a shell in the workspace; when omitted, the\nrepository's `.swarmops/workspaces.json` `check.argv`.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "timeout_s": {
              "default": 900,
              "description": "The most seconds the command runs before it is killed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_land` (client-side): land a workspace's chain on its target; with a check, rebase, run\nthe check there, and publish only the tree the check ran on.",
      "properties": {
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/WsCheckInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "The check to run on the rebased tree before it lands."
        },
        "idempotency_key": {
          "description": "The land's key, a uuid v7; when omitted, the workspace makes one.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_attempts": {
          "default": 8,
          "description": "How many times to rebase, check and land before `E_CAS_RETRY_EXHAUSTED`: 1 to 32.",
          "format": "uint32",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        },
        "message": {
          "description": "The landed changeset's message, and the message to commit edits with first.",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/LandMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "`merge` or `exact`; when omitted, `exact` with a check and `merge` without."
        },
        "status_after": {
          "$ref": "#/$defs/StatusAfter",
          "default": "page",
          "description": "Whether the response carries the status after the mutation."
        },
        "target": {
          "description": "The ref to land on; the workspace's target when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "description": "The workspace, by name.",
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "title": "WsLandReq",
      "type": "object"
    },
    "WsLandResp": {
      "$defs": {
        "LandResp": {
          "description": "`land`: where the change landed. Ids are full.",
          "properties": {
            "attempts": {
              "description": "How many times the land tried to publish.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "auto_merged": {
              "description": "The paths both sides changed whose contents merged cleanly into a content neither side\nhad. Omitted when empty.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "base": {
              "description": "The changeset the change was taken from: what `head`'s first-parent chain added after it\nis what landed.",
              "type": "string"
            },
            "files_changed": {
              "description": "How many paths the landed changeset changes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "landed": {
              "description": "The landed changeset: the change squashed into one changeset on the target.",
              "type": "string"
            },
            "rebased_onto": {
              "description": "The target's head the change landed on: `landed`'s parent.",
              "type": "string"
            },
            "relocated": {
              "description": "The target moved after the land read it, and the publish put the change on the new head\nitself, without another attempt.",
              "type": "boolean"
            },
            "squashed_from": {
              "description": "The changesets the land squashed, oldest first: `head`'s first-parent chain after `base`,\nending at `head`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "status": {
              "$ref": "#/$defs/LandStatus",
              "description": "`landed`, or `replayed` when a land with the same `idempotency_key` had landed the change\nalready."
            },
            "target": {
              "description": "The ref it landed on.",
              "type": "string"
            },
            "warnings": {
              "description": "Problems found after the land became durable, such as failed housekeeping; the land\nitself succeeded. Omitted when empty.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "status",
            "landed",
            "rebased_onto",
            "target",
            "base",
            "attempts",
            "relocated",
            "files_changed",
            "squashed_from"
          ],
          "type": "object"
        },
        "LandStatus": {
          "description": "How a land ended.",
          "oneOf": [
            {
              "const": "landed",
              "description": "This request landed the change.",
              "type": "string"
            },
            {
              "const": "replayed",
              "description": "A land with the same `idempotency_key` had landed it already; nothing was written.",
              "type": "string"
            }
          ]
        },
        "WsChange": {
          "description": "One changed path of a workspace.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/WsChangeKind",
              "description": "What changed."
            },
            "path": {
              "description": "The repository path.",
              "type": "string"
            },
            "size": {
              "description": "The file's size now; omitted for a deleted path.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "kind"
          ],
          "type": "object"
        },
        "WsChangeKind": {
          "description": "What changed at a workspace path.",
          "oneOf": [
            {
              "const": "added",
              "description": "A file the head does not hold.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content changed.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is gone.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A file became a symlink, or the other way round.",
              "type": "string"
            },
            {
              "const": "mode_changed",
              "description": "Its executable bit changed.",
              "type": "string"
            }
          ]
        },
        "WsRebasing": {
          "description": "A workspace's rebase in progress.",
          "properties": {
            "conflicts": {
              "description": "The paths that still conflict.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "onto": {
              "description": "The target's head it rebases onto.",
              "type": "string"
            }
          },
          "required": [
            "onto",
            "conflicts"
          ],
          "type": "object"
        },
        "WsState": {
          "description": "A workspace's state.",
          "oneOf": [
            {
              "const": "clean",
              "description": "No rebase in progress.",
              "type": "string"
            },
            {
              "const": "rebasing",
              "description": "A rebase stopped on conflicts.",
              "type": "string"
            }
          ]
        },
        "WsStatus": {
          "description": "A workspace's status: its changes against its head, a page at a time, and how far its target\nhas moved since its base.",
          "properties": {
            "base": {
              "description": "The target's changeset its chain starts from.",
              "type": "string"
            },
            "behind_by": {
              "description": "How many changesets the target's first-parent history holds that `base`'s lacks: those\npast `base` when it is on that history; otherwise (a sync dropped it, or the target moved\nback) those before where the two histories meet, 0 when the target head is on `base`'s\nfirst-parent history fewer than 10,000 changesets behind `base`. At most 10,000.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "changes": {
              "description": "The changes, by path.",
              "items": {
                "$ref": "#/$defs/WsChange"
              },
              "type": "array"
            },
            "cursor": {
              "description": "Where this page stopped.",
              "type": [
                "string",
                "null"
              ]
            },
            "head": {
              "description": "Its chain's last changeset.",
              "type": "string"
            },
            "main": {
              "description": "The head of the workspace's target ref (`main`, or `release/<name>`), read first.",
              "type": "string"
            },
            "name": {
              "description": "The workspace's name.",
              "type": "string"
            },
            "rebasing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WsRebasing"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The rebase in progress, when `state` is `rebasing`."
            },
            "state": {
              "$ref": "#/$defs/WsState",
              "description": "Whether the workspace is rebasing."
            },
            "truncated": {
              "description": "Whether more changes follow: give `cursor` to read them.",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "base",
            "head",
            "main",
            "behind_by",
            "state",
            "changes",
            "truncated"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_land`: the land, and how many attempts it took.",
      "properties": {
        "attempts": {
          "description": "How many rebase, check and land attempts it took.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "land": {
          "$ref": "#/$defs/LandResp",
          "description": "The store's land."
        },
        "status_after": {
          "anyOf": [
