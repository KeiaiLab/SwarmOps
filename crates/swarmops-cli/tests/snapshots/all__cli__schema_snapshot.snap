      "type": "object"
    },
    "ChangesetSummary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One changeset of a log.",
      "properties": {
        "author_agent": {
          "description": "The agent that wrote it, as `show` gives `author.agent`.",
          "type": "string"
        },
        "created_at": {
          "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "The changeset's id.",
          "type": "string"
        },
        "parents": {
          "description": "The parents' ids, mainline parent first.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "description": "The message's first line.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "parents",
        "author_agent",
        "created_at",
        "title"
      ],
      "title": "ChangesetSummary",
      "type": "object"
    },
    "CloneReq": {
      "$defs": {
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
            {
              "const": "gitlinks",
              "description": "A submodule's entry (git mode 160000): dropped.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
              "type": "string"
            },
            {
              "const": "modes",
              "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
              "type": "string"
            },
            {
              "const": "tree_order",
              "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
              "type": "string"
            },
            {
              "const": "empty_trees",
              "description": "An entry naming an empty tree: dropped.",
              "type": "string"
            },
            {
              "const": "nonstandard",
              "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`clone`: a new store in a directory of the caller's host, holding a git remote's history,\nwith the remote recorded and its followed branch imported into `main`. It needs an\nidentity, as `git import` does: it moves `main`.",
      "properties": {
        "branch": {
          "description": "The remote branch `main` follows; by default the remote's default branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "lossy": {
          "default": [],
          "description": "The classes of content the import of this remote's commits may drop or normalize, as\n`git import`'s `lossy`.",
          "items": {
            "$ref": "#/$defs/LossyClass"
          },
          "type": "array"
        },
        "name": {
          "description": "The repository's name; by default the URL's last path component without `.git`.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The directory to create the store in, on the caller's host: absent or empty. A\ndirectory holding a store with this remote at this URL continues an interrupted clone.",
          "type": "string"
        },
        "remote": {
          "default": "origin",
          "description": "The name to record the remote under: `origin` by default.",
          "type": "string"
        },
        "token_env": {
          "description": "The environment variable that holds a token for the remote, by its name; the token is\nnever stored.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The remote's URL: `https://host/path`, `ssh://[user@]host/path` or the scp form\n`user@host:path`. A URL with a password, another scheme, or one that starts with `-` is\nrefused; plain `http://` only to a loopback address.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "path"
      ],
      "title": "CloneReq",
      "type": "object"
    },
    "CloneResp": {
      "$defs": {
        "BranchUpdate": {
          "description": "A remote branch a fetch saw move, appear or go.",
          "properties": {
            "branch": {
              "description": "The branch, by its short name.",
              "type": "string"
            },
            "new": {
              "description": "The commit it names now; omitted for a branch the remote deleted.",
              "type": [
                "string",
                "null"
              ]
            },
            "old": {
              "description": "The commit it named before; omitted for a branch that appeared.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "branch"
          ],
          "type": "object"
        },
        "FetchResp": {
          "description": "`fetch`: where the followed branch stands, and what moved.",
          "properties": {
            "branch": {
              "description": "The followed branch.",
              "type": "string"
            },
            "branches": {
              "description": "The remote branches that moved, appeared or went, at most 1,000.",
              "items": {
                "$ref": "#/$defs/BranchUpdate"
              },
              "type": "array"
            },
            "branches_truncated": {
              "description": "Whether more branches moved than `branches` lists.",
              "type": "boolean"
            },
            "head": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RemoteHead"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The followed branch's head after the fetch; omitted when the remote has no such branch."
            },
            "imported": {
              "description": "How many changesets the import of the followed branch added.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_head": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RemoteHead"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The followed branch's head as the last fetch saw it; omitted when none did."
            },
            "remote": {
              "description": "The remote, by its name.",
              "type": "string"
            },
            "tags_fetched": {
              "description": "How many tags the fetch brought into the mirror (they are never imported).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "warnings": {
              "description": "What the fetch has to say that did not stop it. Omitted when there is nothing.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "remote",
            "branch",
            "imported",
            "branches",
            "branches_truncated",
            "tags_fetched"
          ],
          "type": "object"
        },
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
            {
              "const": "gitlinks",
              "description": "A submodule's entry (git mode 160000): dropped.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
              "type": "string"
            },
            {
              "const": "modes",
              "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
              "type": "string"
            },
            {
              "const": "tree_order",
              "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
              "type": "string"
            },
            {
              "const": "empty_trees",
              "description": "An entry naming an empty tree: dropped.",
              "type": "string"
            },
            {
              "const": "nonstandard",
              "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
              "type": "string"
            }
          ]
        },
        "RemoteHead": {
          "description": "A remote branch's head: its commit, and the changeset that commit is in the store.",
          "properties": {
            "changeset": {
              "description": "The changeset id of that commit in the store.",
              "type": "string"
            },
            "sha": {
              "description": "The commit's git id, 40 lowercase hex digits.",
              "type": "string"
            }
          },
          "required": [
            "sha",
            "changeset"
          ],
          "type": "object"
        },
        "RemoteInfo": {
          "description": "A remote the store records.",
          "properties": {
            "branch": {
              "description": "The remote branch `main` follows.",
              "type": "string"
            },
            "lossy": {
              "description": "The classes of content the import of this remote's commits may drop or normalize.",
              "items": {
                "$ref": "#/$defs/LossyClass"
              },
              "type": "array"
            },
            "name": {
              "description": "The remote's name.",
              "type": "string"
            },
            "token_env": {
              "description": "The environment variable that holds a token for the remote, by its name; omitted when\nthe remote names none.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "description": "The remote's URL, as it was given.",
              "type": "string"
            },
            "warnings": {
              "description": "What adding the remote has to say that did not stop it, such as\n`default_branch_unknown` (the remote named no default branch, so `branch` is `main`).\nOmitted when there is nothing.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "url",
            "branch",
            "lossy"
          ],
          "type": "object"
        },
        "RepoInfo": {
          "description": "`init` and `info`: what the store is and holds.",
          "properties": {
            "changesets": {
              "description": "How many changesets the store holds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "main": {
              "description": "The changeset `main` points at; omitted until `main` exists.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "The name given at `init`.",
              "type": "string"
            },
            "refs": {
              "description": "How many refs the store holds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "repo_id": {
              "description": "The store's id, fixed at `init`.",
              "type": "string"
            },
            "store_version": {
              "description": "The store format version.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "repo_id",
            "name",
            "store_version",
            "changesets",
            "refs"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`clone`: the store made, the remote recorded, its fetch, and where `main` stands.",
      "properties": {
        "fetch": {
          "$ref": "#/$defs/FetchResp",
          "description": "The clone's fetch."
        },
        "imported": {
          "description": "How many changesets the import into `main` added.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "main": {
          "description": "The changeset `main` names; omitted when the remote is empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "$ref": "#/$defs/RemoteInfo",
          "description": "The remote recorded."
        },
        "repo": {
          "$ref": "#/$defs/RepoInfo",
          "description": "The new store."
        }
      },
      "required": [
        "repo",
        "remote",
        "fetch",
        "imported"
      ],
      "title": "CloneResp",
      "type": "object"
    },
    "CommitReq": {
      "$defs": {
        "ChangeInput": {
          "description": "One change of a commit.",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The new content, at most 512 MiB (more is `E_TOO_LARGE` with `scope` `put`); a `put` needs\nit, a `delete` takes none."
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModeInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The kind of entry a `put` writes; `file` when omitted."
            },
            "op": {
              "$ref": "#/$defs/ChangeOp",
              "description": "Whether to write the path or remove it."
            },
            "path": {
              "description": "The repository path: `/`-separated, relative to the root.",
              "type": "string"
            }
          },
          "required": [
            "path",
            "op"
          ],
          "type": "object"
        },
        "ChangeOp": {
          "description": "What a change does to its path, in a commit's change list and a changeset's changes alike.",
          "oneOf": [
            {
              "const": "put",
              "description": "Write the content at the path, creating or replacing the entry.",
              "type": "string"
            },
            {
              "const": "delete",
              "description": "Remove the path.",
              "type": "string"
            }
          ]
        },
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`commit`: record a changeset from an explicit change list. It moves no ref, unless\n`advance` names one.",
      "properties": {
        "advance": {
          "description": "Also move this ref (`main` or `release/<name>`) to the new changeset, in the same\ntransaction as the changeset itself, so that both are recorded or neither. The move\nhappens only if the ref still names the changeset's parent (for a root commit, only if the\nref does not exist yet): it is always a one-step fast-forward. Otherwise nothing is\nrecorded and the commit fails with `E_CAS_MISMATCH` (`details.committed: false`,\n`details.actual` what the ref names). Give as `parent` the full id the ref held when you\nread it: without `parent` the commit builds on the ref's head when it runs, so the move\ncatches a race from there on, not a change made since you read the ref (M1 has no\nmerge). `swarmops mcp` refuses `advance` without a full 64-hex `parent` (`E_INVALID_ARG`).\nA store that does not know this field ignores it and moves no ref: its response has no\n`advanced`.",
          "type": [
            "string",
            "null"
          ]
        },
        "allow_empty": {
          "default": false,
          "description": "Record the changeset even if it changes nothing.",
          "type": "boolean"
        },
        "changes": {
          "description": "What to change, relative to the parent. The contents hold at most 1 GiB together, by the\nsizes they declare (inline text's length, the bytes base64 decodes to, a client file's\nlength; a `blob` named by id counts nothing): more is `E_TOO_LARGE` with `scope`\n`commit`, refused before any content is read. Store large contents with `blob_put` first,\nand name them by id.",
          "items": {
            "$ref": "#/$defs/ChangeInput"
          },
          "type": "array"
        },
        "idempotency_key": {
          "description": "Makes a retry of this commit safe: a uuid v7 (anything else is `E_INVALID_ARG`). The\ncommit takes the key's time, to the second, as its signature time and records the key as\n`commit_key` metadata, so the same request on the same parent makes the same changeset,\nwhich the store holds already: the response says `replayed`, and nothing is written.\nWith `advance`, a ref whose head carries the key is a replay too. Give `parent` by its full\nid: without it, a retry after the head moved commits again, on the new head.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "The commit message.",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "The changeset to commit on top of. An explicit `parent` always wins; when it is omitted,\nthe current head of the ref `advance` names is used, else of `main`, if that ref exists,\nand otherwise the commit is a root commit. `null` is the same as omitting it. Once `main`\nexists, a root commit needs an `advance` naming a ref that does not exist yet (a known M1\nlimitation)."
        }
      },
      "required": [
        "changes",
        "message"
      ],
      "title": "CommitReq",
      "type": "object"
    },
    "CommitResp": {
      "$defs": {
        "Advanced": {
          "description": "`commit` with `advance`: the ref's move, made in the commit's own transaction.",
          "properties": {
            "already_applied": {
              "description": "The ref held the changeset already, from an identical request before, so nothing was\nwritten and a replay is safe.",
              "type": "boolean"
            },
            "name": {
              "description": "The ref.",
              "type": "string"
            },
            "new": {
              "description": "What it holds now: the changeset.",
              "type": "string"
            },
            "old": {
              "description": "What the ref held before: the changeset's parent; omitted for a root commit, whose move\ncreated the ref.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "new",
            "already_applied"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`commit`: the changeset that was recorded.",
      "properties": {
        "advanced": {
          "anyOf": [
            {
              "$ref": "#/$defs/Advanced"
            },
            {
              "type": "null"
            }
          ],
          "description": "The move of the ref the request's `advance` named: present exactly when the ref names\n`changeset` because of this request, or of an identical one before it\n(`already_applied`). A request with `advance` whose response lacks it went to a store\nthat ignores the field, and moved no ref."
        },
        "blobs_written": {
          "description": "How many blobs this commit's own writes placed in the object store; blobs that were there\nalready, or that a concurrent writer placed first, count 0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "changeset": {
          "description": "The new changeset's id.",
          "type": "string"
        },
        "files_changed": {
          "description": "How many paths the changeset changes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "description": "The changeset it was committed on top of; omitted for a root commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "replayed": {
          "default": false,
          "description": "The store held the changeset already, from an identical request before (a retry with the\nsame `idempotency_key`), so nothing was written. Always written; a response from a store\nthat does not know the field reads as `false`.",
          "type": "boolean"
        },
        "root": {
          "description": "The new root tree's id.",
          "type": "string"
        },
        "warnings": {
          "description": "Problems found after the commit became durable, such as failed housekeeping; the commit\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "changeset",
        "root",
        "files_changed",
        "blobs_written"
      ],
      "title": "CommitResp",
      "type": "object"
    },
    "ConflictKindOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What kind of conflict a file has. `ours` is the change, `theirs` the target.",
      "oneOf": [
        {
          "const": "content",
          "description": "Both sides edited the same lines of a text file, or lines next to each other.",
          "type": "string"
        },
        {
          "const": "binary",
          "description": "Both sides changed the content of a file that is not text, or of a symlink, differently.",
          "type": "string"
        },
        {
          "const": "delete_modify",
          "description": "The change deleted the file, and the target changed it.",
          "type": "string"
        },
        {
          "const": "modify_delete",
          "description": "The change changed the file, and the target deleted it.",
          "type": "string"
        },
        {
          "const": "add_add",
          "description": "Both sides added the file, with contents that do not merge.",
          "type": "string"
        },
        {
          "const": "mode",
          "description": "Both sides changed the file's kind (file, executable or symlink), differently.",
          "type": "string"
        },
        {
          "const": "type_change",
          "description": "One side has a file where the other has a directory, or the change deleted a file where\nthe target made a directory.",
          "type": "string"
        }
      ],
      "title": "ConflictKindOut"
    },
    "ConflictReport": {
      "$defs": {
        "ConflictKindOut": {
          "description": "What kind of conflict a file has. `ours` is the change, `theirs` the target.",
          "oneOf": [
            {
              "const": "content",
              "description": "Both sides edited the same lines of a text file, or lines next to each other.",
              "type": "string"
            },
            {
              "const": "binary",
              "description": "Both sides changed the content of a file that is not text, or of a symlink, differently.",
              "type": "string"
            },
            {
              "const": "delete_modify",
              "description": "The change deleted the file, and the target changed it.",
              "type": "string"
            },
            {
              "const": "modify_delete",
              "description": "The change changed the file, and the target deleted it.",
              "type": "string"
            },
            {
              "const": "add_add",
              "description": "Both sides added the file, with contents that do not merge.",
              "type": "string"
            },
            {
              "const": "mode",
              "description": "Both sides changed the file's kind (file, executable or symlink), differently.",
              "type": "string"
            },
            {
              "const": "type_change",
              "description": "One side has a file where the other has a directory, or the change deleted a file where\nthe target made a directory.",
              "type": "string"
            }
          ]
        },
        "FileConflictOut": {
          "description": "One conflicting file. Its blobs are the file's content on each side, which `read_file` reads\nat that side's changeset; a side without a file at the path (deleted, never added, or a\ndirectory there) has none.",
          "properties": {
            "base_blob": {
              "description": "Its blob at the merge base.",
              "type": [
                "string",
                "null"
              ]
            },
            "hunks": {
              "description": "The places where the two sides' edits of its lines meet, in file order: for a text file\nboth sides edited (`content` and `add_add`; contents not all text, or past the line\ndiff's bound of 49,152 lines or 8 MiB a side, conflict as `binary`, with no hunks).\nOmitted when there are none.",
              "items": {
                "$ref": "#/$defs/HunkOut"
              },
              "type": "array"
            },
            "kind": {
              "$ref": "#/$defs/ConflictKindOut",
              "description": "What kind of conflict it is."
            },
            "ours_blob": {
              "description": "Its blob in the change.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "The file's repository path.",
              "type": "string"
            },
            "theirs_agent": {
              "description": "The agent that wrote `theirs_changeset`.",
              "type": [
                "string",
                "null"
              ]
            },
            "theirs_blob": {
              "description": "Its blob on the target.",
              "type": [
                "string",
                "null"
              ]
            },
            "theirs_changeset": {
              "description": "The newest changeset on the target since the merge base that changed this path: what to\nread for the other side's edit.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "kind"
          ],
          "type": "object"
        },
        "HunkOut": {
          "description": "One place where the two sides' edits of a text file meet: each side's lines there. The lines\nare numbered from 1, and each side's range includes both ends, as `read_file` takes a range\nof lines.",
          "properties": {
            "base": {
              "$ref": "#/$defs/LinesOut",
              "description": "The lines at the merge base."
            },
            "id": {
              "description": "Its number in the file, from 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "ours": {
              "$ref": "#/$defs/LinesOut",
              "description": "The change's lines."
            },
            "theirs": {
              "$ref": "#/$defs/LinesOut",
              "description": "The target's lines."
            }
          },
          "required": [
            "id",
            "base",
            "ours",
            "theirs"
          ],
          "type": "object"
        },
        "LinesOut": {
          "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
          "properties": {
            "first": {
              "description": "The first line.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "last": {
              "description": "The last line; `first` minus one when the side has none.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "The lines' text; omitted from the first hunk whose texts would pass the report's\n`max_conflict_bytes`, and on the hunk that spans the first file's hunks past the\nreport's bound (`truncated`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Why a land could not merge its change onto the target, file by file, or could not apply its\nresolutions to it (operations spec §3): the report `E_CONFLICT` carries in `details.report`.\n`ours` is the change, `theirs` the target. Ids are full.",
      "properties": {
        "auto_merged": {
          "description": "The paths both sides changed whose contents merged cleanly into a content neither side\nhad. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "base": {
          "description": "The merge base: the changeset the change starts from.",
          "type": "string"
        },
        "files": {
          "description": "The files that conflict, in path order, while their entries stay within 24 KiB as JSON,\ntexts aside: the first file always, with at least its first hunk, its hunks past the bound\nas one hunk that spans them, without texts; a later file whole, or else left out with\nevery file after it (`truncated`). The error's message counts every conflicting path.",
          "items": {
            "$ref": "#/$defs/FileConflictOut"
          },
          "type": "array"
        },
        "kinds": {
          "description": "The kinds of conflict in `files`, each once.",
          "items": {
            "$ref": "#/$defs/ConflictKindOut"
          },
          "type": "array"
        },
        "ours": {
          "description": "The change's head.",
          "type": "string"
        },
        "stale": {
          "description": "The paths whose resolutions did not apply, since the target holds there what their\n`against` did not: the target changed them after the report the resolutions answered.\nRead them at `theirs` and resolve them again, against it. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "theirs": {
          "description": "The target's head the change was merged with.",
          "type": "string"
        },
        "truncated": {
          "description": "Whether the report left something out: hunk texts, to stay within the request's\n`max_conflict_bytes`, or files and hunks, to stay within the bound of `files`.",
          "type": "boolean"
        }
      },
      "required": [
        "base",
        "ours",
        "theirs",
        "files",
        "kinds",
        "truncated"
      ],
      "title": "ConflictReport",
      "type": "object"
    },
    "ContentEncoding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How `FileContent.content` encodes bytes.",
      "oneOf": [
        {
          "const": "utf8",
          "description": "The bytes are UTF-8 text, and `content` is that text.",
          "type": "string"
        },
        {
          "const": "base64",
          "description": "`content` is the bytes in standard, padded base64.",
          "type": "string"
        }
      ],
      "title": "ContentEncoding"
    },
    "ContentInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A `put`'s content, as an object with one key.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "UTF-8 text, verbatim.",
          "properties": {
            "inline": {
              "type": "string"
            }
          },
          "required": [
            "inline"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Bytes in standard, padded base64.",
          "properties": {
            "base64": {
              "type": "string"
            }
          },
          "required": [
            "base64"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
          "properties": {
            "blob": {
              "type": "string"
            }
          },
          "required": [
            "blob"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      ],
      "title": "ContentInput"
    },
    "DeriveReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`derive`: derive ahead of any reader the eager derived values (storage spec §5: each\nchangeset's first-parent skip list) of the changesets the journal records after a frame, so\nthat reads find them stored. It writes only the store's cache of derived values, so it takes\nno identity.",
      "properties": {
        "after": {
          "description": "Go on after this journal frame: a previous call's `next`. From the journal's first frame\nwhen omitted. A frame past the journal's last is `E_INVALID_ARG`.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "default": 1000,
          "description": "The most journal frames to read; a frame is one transaction, a commit or a ref's move. 0\nreads none and derives nothing: `next` is then the journal's last frame, from where the\nnext calls derive only what is recorded later.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "DeriveReq",
      "type": "object"
    },
    "DeriveResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`derive`: how many values one call derived, how many the store held already, and where to\ngo on.",
      "properties": {
        "cached": {
          "description": "How many of those values the store held already.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "derived": {
          "description": "How many values it derived: of each eager derivation, one for each changeset its frames\nrecord whose value the store lacked. Values those needed on the way, an older\nchangeset's, are derived too and not counted.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "next": {
          "description": "The last frame it read: pass it as the next call's `after` to go on, through a journal\nlonger than `limit` frames or through the frames recorded since. Omitted when it read no\nframe, as none follows `after`, the journal's last frame: it is at the journal's end (an\n`after` past that is `E_INVALID_ARG`). With `limit` 0, the journal's last frame, omitted\nwhile the journal holds none.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "derived",
        "cached"
      ],
      "title": "DeriveResp",
      "type": "object"
    },
    "Diff": {
      "$defs": {
        "DiffHunk": {
          "description": "A hunk of a unified diff: one or more changes and the unchanged lines around them, with the\nnumbers of its header, `@@ -old_start,old_lines +new_start,new_lines @@`.",
          "properties": {
            "lines": {
              "description": "Its lines, in order; each change's removed lines come before its added lines.",
              "items": {
                "$ref": "#/$defs/DiffLineOut"
              },
              "type": "array"
            },
            "new_lines": {
              "description": "How many new lines it holds: its context and added lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "new_start": {
              "description": "The first new line it holds, counted as `old_start` is.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_lines": {
              "description": "How many old lines it holds: its context and removed lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_start": {
              "description": "The first old line it holds, counted from 1; when it holds none, the line before where\nthey would be (0 at the top), as git prints it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "old_start",
            "old_lines",
            "new_start",
            "new_lines",
            "lines"
          ],
          "type": "object"
        },
        "DiffLineOut": {
          "description": "One line of a hunk.",
          "properties": {
            "op": {
              "$ref": "#/$defs/LineOp",
              "description": "Whether both sides have it, only the new one, or only the old one."
            },
            "text": {
              "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ],
          "type": "object"
        },
        "DiffStatus": {
          "description": "What happened to a file between the two revisions.",
          "oneOf": [
            {
              "const": "added",
              "description": "It is in `to` only: in `from`, nothing or a directory is there.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is in `from` only.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content or its exec bit changed: a file or an executable on both sides, or a\nsymlink on both sides.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A symlink on one side, a file or an executable on the other.",
              "type": "string"
            }
          ]
        },
        "FileDiff": {
          "description": "One file that differs: a file, an executable or a symlink whose content or kind changed, or\nthat is on one side only. A directory never is one: a file that becomes a directory is that\nfile deleted and the directory's files added. No rename is detected: a file that moved is\none deleted and one added. Which fields follow `status` depends on the request's `format`,\nand a field that says nothing is omitted.",
          "properties": {
            "binary": {
              "description": "`stat` and `unified`: whether it is binary, which gets no line counts and no hunks: a side\nthat is not UTF-8, or holds a NUL in its first 8,000 bytes.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "deletions": {
              "description": "`stat` and `unified`, for text within the line diff's bound: the lines the change\ndeletes.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "hunks": {
              "description": "`unified`, for text: the hunks, in order; empty when only the exec bit or the kind\nchanged.",
              "items": {
                "$ref": "#/$defs/DiffHunk"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "hunks_truncated": {
              "description": "`stat` and `unified`: true for text past the line diff's bound (49,152 lines or 8 MiB a\nside), which gets no `insertions`, `deletions` or hunks (`hunks` empty for `unified`);\nand for `unified`, when `hunks` stops before the file's last hunk, to keep the page within\n`max_bytes`, `insertions` and `deletions` counting every line all the same. Omitted\notherwise.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "insertions": {
              "description": "`stat` and `unified`, for text within the line diff's bound: the lines the change\ninserts.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "new_blob": {
              "description": "`unified`: its blob id in `to`; omitted for a deleted file.",
              "type": [
                "string",
                "null"
              ]
            },
            "new_kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FileKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`unified`: its kind in `to`; omitted for a deleted file."
            },
            "old_blob": {
              "description": "`unified`: its blob id in `from`; omitted for an added file.",
              "type": [
                "string",
                "null"
              ]
            },
            "old_kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FileKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`unified`: its kind in `from`; omitted for an added file."
            },
            "path": {
              "description": "The repository path.",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/DiffStatus",
              "description": "What happened to it."
            }
          },
          "required": [
            "path",
            "status"
          ],
          "type": "object"
        },
        "FileKind": {
          "description": "What a file is; never a directory.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            }
          ]
        },
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`diff`: a page of the files that differ between two revisions, in path order (by bytes).",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page starts. Opaque: pass it back as given, as the next\nrequest's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "The files.",
          "items": {
            "$ref": "#/$defs/FileDiff"
          },
          "type": "array"
        },
        "from": {
          "description": "The changeset `from` named.",
          "type": "string"
        },
        "to": {
          "description": "The changeset `to` named.",
          "type": "string"
        },
        "truncated": {
          "description": "Whether more files follow this page.",
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to",
        "files",
        "truncated"
      ],
      "title": "Diff",
      "type": "object"
    },
    "DiffFormat": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What `diff` says of each file.",
      "oneOf": [
        {
          "const": "names",
          "description": "Its path and status.",
          "type": "string"
        },
        {
          "const": "stat",
          "description": "Also whether it is binary and, for text, the lines it inserts and deletes.",
          "type": "string"
        },
        {
          "const": "unified",
          "description": "Also its kinds, its blobs and, for text, its hunks.",
          "type": "string"
        }
      ],
      "title": "DiffFormat"
    },
    "DiffHunk": {
      "$defs": {
        "DiffLineOut": {
          "description": "One line of a hunk.",
          "properties": {
            "op": {
              "$ref": "#/$defs/LineOp",
              "description": "Whether both sides have it, only the new one, or only the old one."
            },
            "text": {
              "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ],
          "type": "object"
        },
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A hunk of a unified diff: one or more changes and the unchanged lines around them, with the\nnumbers of its header, `@@ -old_start,old_lines +new_start,new_lines @@`.",
      "properties": {
        "lines": {
          "description": "Its lines, in order; each change's removed lines come before its added lines.",
          "items": {
            "$ref": "#/$defs/DiffLineOut"
          },
          "type": "array"
        },
        "new_lines": {
          "description": "How many new lines it holds: its context and added lines.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "new_start": {
          "description": "The first new line it holds, counted as `old_start` is.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_lines": {
          "description": "How many old lines it holds: its context and removed lines.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_start": {
          "description": "The first old line it holds, counted from 1; when it holds none, the line before where\nthey would be (0 at the top), as git prints it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "old_start",
        "old_lines",
        "new_start",
        "new_lines",
        "lines"
      ],
      "title": "DiffHunk",
      "type": "object"
    },
    "DiffLineOut": {
      "$defs": {
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One line of a hunk.",
      "properties": {
        "op": {
          "$ref": "#/$defs/LineOp",
          "description": "Whether both sides have it, only the new one, or only the old one."
        },
        "text": {
          "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
          "type": "string"
        }
      },
      "required": [
        "op",
        "text"
      ],
      "title": "DiffLineOut",
      "type": "object"
    },
    "DiffReq": {
      "$defs": {
        "DiffFormat": {
          "description": "What `diff` says of each file.",
          "oneOf": [
            {
              "const": "names",
              "description": "Its path and status.",
              "type": "string"
            },
            {
              "const": "stat",
              "description": "Also whether it is binary and, for text, the lines it inserts and deletes.",
              "type": "string"
            },
            {
              "const": "unified",
              "description": "Also its kinds, its blobs and, for text, its hunks.",
              "type": "string"
            }
          ]
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`diff`: the files that differ between two revisions, in path order, a page at a time.",
      "properties": {
        "context": {
          "default": 3,
          "description": "The unchanged lines around each change in a `unified` hunk.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cursor": {
          "description": "Resume a diff: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page starts after the file it names. It pins no\nrevision: give the first page's `from` and `to`, full ids, as `from` and `to`, or a ref\nthat moved since pages another diff, with no error.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "$ref": "#/$defs/DiffFormat",
          "default": "names",
          "description": "What to say of each file: `names` its path and status; `stat` also whether it is binary\nand, for text, the lines it inserts and deletes; `unified` also its kinds, its blobs and,\nfor text, its hunks."
        },
        "from": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to diff from: the old side."
        },
        "limit": {
          "default": 500,
          "description": "The most files to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_bytes": {
          "default": 32768,
          "description": "The most bytes a `unified` page's files take, as the JSON array `files` they print as: at\nleast 1 (0 is `E_INVALID_ARG`). The page stops before the first file that would take it\npast this, but always holds one file, whose hunks are cut to the first ones that fit\n(`hunks_truncated`) when they alone would pass it. A `names` or `stat` page is held by\n`limit` alone.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "paths": {
          "description": "Only the files at or below these repository paths (a file's path takes that file; one\ntrailing `/` is taken); every file when empty or omitted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "to": {
          "$ref": "#/$defs/Rev",
          "description": "The revision to diff to: the new side."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DiffReq",
      "type": "object"
    },
    "DiffStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What happened to a file between the two revisions.",
      "oneOf": [
        {
          "const": "added",
          "description": "It is in `to` only: in `from`, nothing or a directory is there.",
          "type": "string"
        },
        {
          "const": "deleted",
          "description": "It is in `from` only.",
          "type": "string"
        },
        {
          "const": "modified",
          "description": "Its content or its exec bit changed: a file or an executable on both sides, or a\nsymlink on both sides.",
          "type": "string"
        },
        {
          "const": "type_changed",
          "description": "A symlink on one side, a file or an executable on the other.",
          "type": "string"
        }
      ],
      "title": "DiffStatus"
    },
    "DropReason": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How a sync found that the remote holds a change already.",
      "oneOf": [
        {
          "const": "trailer",
          "description": "A commit the remote's head reaches names it in a `SwarmOps-Changeset`,\n`SwarmOps-Squashed-From` or `SwarmOps-Land-Key` line.",
          "type": "string"
        },
        {
          "const": "no_op",
          "description": "It merges onto the remote's head as no change.",
          "type": "string"
        }
      ],
      "title": "DropReason"
    },
    "DroppedChange": {
      "$defs": {
        "DropReason": {
          "description": "How a sync found that the remote holds a change already.",
          "oneOf": [
            {
              "const": "trailer",
              "description": "A commit the remote's head reaches names it in a `SwarmOps-Changeset`,\n`SwarmOps-Squashed-From` or `SwarmOps-Land-Key` line.",
              "type": "string"
            },
            {
              "const": "no_op",
              "description": "It merges onto the remote's head as no change.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "An unpublished change a sync dropped, since the remote holds it already. It stays in the\nstore; `main` moves only forward, so to bring it back there, land a change that restores it.",
      "properties": {
        "by": {
          "$ref": "#/$defs/DropReason",
          "description": "How the sync found it on the remote."
        },
        "changeset": {
          "description": "The change.",
          "type": "string"
        }
      },
      "required": [
        "changeset",
        "by"
      ],
      "title": "DroppedChange",
      "type": "object"
    },
    "EntryKindOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a tree entry is.",
      "oneOf": [
        {
          "const": "file",
          "description": "A regular file.",
          "type": "string"
        },
        {
          "const": "exec",
          "description": "An executable file.",
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink.",
          "type": "string"
        },
        {
          "const": "dir",
          "description": "A directory.",
          "type": "string"
        }
      ],
      "title": "EntryKindOut"
    },
    "Envelope": {
      "$defs": {
        "LogCutOut": {
          "description": "Where the journal was cut (`meta.recovered.log_cut`).",
          "properties": {
            "at": {
              "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "How many bytes were cut, to where the journal ended.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "at",
            "bytes"
          ],
          "type": "object"
        },
        "Meta": {
          "description": "What the envelope reports besides the outcome.",
          "properties": {
            "auth": {
              "description": "The store's authentication mode (`trust` in M1), not how this caller was identified.",
              "type": "string"
            },
            "elapsed_ms": {
              "description": "How long the command took, in milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "recovered": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RecoveredOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the command's write repaired before its own work, of what earlier writers left when\nthey crashed or failed after their commit point; omitted when there was nothing to repair,\nand for a command that writes nothing. `commit`, `ref_set`, `ref_delete`, `undo`,\n`git_import`, `git_export`, `fetch`, `push` and `sync` report it on success; `commit`,\n`land`, `ref_set`, `ref_delete` and `undo` on `E_CAS_MISMATCH` too, and `undo` on\n`E_OP_NOT_FOUND` and `E_NOTHING_TO_UNDO`; any other failure loses it. Whoever writes next\ngets it, not the agent whose process crashed, and it is no failure: `warnings` still names\nonly the steps after this command's own commit point that failed."
            },
            "repo": {
              "description": "The store as the user named it, for display; omitted when the command used no store.",
              "type": [
                "string",
                "null"
              ]
            },
            "resolved": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Every revision the command resolved: the string given and the full changeset id it named.",
              "type": "object"
            }
          },
          "required": [
            "elapsed_ms",
            "resolved",
            "auth"
          ],
          "type": "object"
        },
        "OpError": {
          "description": "A failed operation: the envelope's `error` object.\n\n`code`, `exit` and `retryable` come from one `ErrorCode`. `code` stays a string so a client\ncan read codes newer than its own table.",
          "properties": {
            "code": {
              "description": "The `E_*` code.",
              "type": "string"
            },
            "details": {
              "additionalProperties": true,
              "default": {},
              "description": "Machine-readable context, such as `actual` for `E_CAS_MISMATCH`; `{}` when there is none.",
              "type": "object"
            },
            "exit": {
              "description": "The exit code of the CLI.",
              "format": "int32",
              "type": "integer"
            },
            "hint": {
              "description": "The next command to run when there is an obvious one, else null.",
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "description": "What went wrong.",
              "type": "string"
            },
            "retryable": {
              "description": "Whether the operation can succeed when it is run again: as it is after a transient\nfailure, or, after a lost compare-and-swap, with what the error names re-read (the\nmessage says how; the `hint` reads it).",
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "exit",
            "details",
            "hint"
          ],
          "type": "object"
        },
        "RecoveredOut": {
          "description": "What a write's recovery repaired (`meta.recovered`), as offsets and counts in the store's\nmetadata files, with no paths: the storage spec (§2 rule 3, §3) says what each repair is.",
          "properties": {
            "frames_listed": {
              "description": "The journal frames listed that their writer never listed: transactions that committed,\ntheir writer having crashed between the frame's sync and its listing, or failed to list\nit (a warning then); and frames listed again whose entries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "frames_rewritten": {
              "description": "Of those, the frames written to the journal afresh first, because the sync that would\nhave made them durable failed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "index_records_dropped": {
              "description": "The changeset index records cut, counted in its longest column: records a crash left torn,\nor a power loss emptied.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "log_cut": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LogCutOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The torn tail cut off the end of the journal, if there was one: the bytes of a transaction\nthat never reached its commit point; omitted when nothing was cut."
            },
            "off_bytes_dropped": {
              "description": "The bytes dropped from the end of the journal's list of frames: part of an entry, or\nentries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "records_replayed": {
              "description": "The changesets replayed from the journal into the index.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "refs_replayed": {
              "description": "The ref files replayed from the journal: replaced, or removed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "views_rebuilt": {
              "description": "Whether a compaction of the changeset index that a crash interrupted was finished.",
              "type": "boolean"
            }
          },
          "required": [
            "frames_listed",
            "frames_rewritten",
            "off_bytes_dropped",
            "index_records_dropped",
            "views_rebuilt",
            "records_replayed",
            "refs_replayed"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One command's output: `result` on success, `error` on failure, `meta` either way.\n\nExactly one of `result` and `error` is present; the other is omitted, never written as null.",
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "properties": {
        "api": {
          "description": "The API version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "$ref": "#/$defs/OpError",
          "description": "The failure; present exactly when not `ok`."
        },
        "meta": {
          "$ref": "#/$defs/Meta",
          "description": "Context for either outcome."
        },
        "ok": {
          "description": "Whether the operation succeeded.",
          "type": "boolean"
        },
        "op": {
          "description": "The operation's name, such as `commit`.",
          "type": "string"
        },
        "result": {
          "description": "The operation's response; present exactly when `ok`."
        }
      },
      "required": [
        "ok",
        "op",
        "api",
        "meta"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "ErrorCode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Why an operation failed: a stable code with a fixed exit code and retry advice.\n\nSerialized as its `E_*` string, which `OpError.code` carries too, so a client can read\ncodes newer than its copy of this enum.",
      "oneOf": [
        {
          "const": "E_EXISTS",
          "description": "`init` found a store at the target path already.",
          "type": "string"
        },
        {
          "const": "E_NOT_A_REPO",
          "description": "No store at the given path, or no store was named.",
          "type": "string"
        },
        {
          "const": "E_IDENTITY_REQUIRED",
          "description": "A mutation was asked for without an identity.",
          "type": "string"
        },
        {
          "const": "E_REV_NOT_FOUND",
          "description": "A revision names no changeset.",
          "type": "string"
        },
        {
          "const": "E_AMBIGUOUS_ID",
          "description": "An id prefix matches more than one changeset; give more digits.",
          "type": "string"
        },
        {
          "const": "E_PATH_NOT_FOUND",
          "description": "The path does not exist at that revision.",
          "type": "string"
        },
        {
          "const": "E_IS_DIR",
          "description": "A file operation named a directory.",
          "type": "string"
        },
        {
          "const": "E_TOO_LARGE",
          "description": "The content is larger than the operation allows. `details` has one of four shapes:\n`{size, limit, scope}` for a limit of SwarmOps (`scope` `put` for one content, `commit`\nfor a commit's contents together, `request` for a request's text, with the flag that\nnamed it as `changes` or `resolve`), where a commit adds the change's `index` and `path`,\nand `file` for a client file; `{scope, size, limit, remote}` for a push past a remote's\nlimit (`scope` `remote_file`, which adds `path`, or `remote_push`); `{store_limit, max,\ngot}` for an object longer than an object holds (`store_limit` `object_bytes`); and from\n`git import`, `{commit, path, size, max}` for a blob and `{object, kind, size, max}` for a\ncommit, a tree or a tag.",
          "type": "string"
        },
        {
          "const": "E_EMPTY_COMMIT",
          "description": "The commit changes nothing and `allow_empty` is off.",
          "type": "string"
        },
        {
          "const": "E_TYPE_CONFLICT",
          "description": "A change puts an entry below a file, or a file onto a directory.",
          "type": "string"
        },
        {
          "const": "E_UNKNOWN_PARENT",
          "description": "The parent changeset is not in the store.",
          "type": "string"
        },
        {
          "const": "E_CAS_MISMATCH",
          "description": "The ref no longer holds the expected target (or, with `create`, exists at another one);\n`details.actual` holds what it does, `null` when the ref does not exist.",
          "type": "string"
        },
        {
          "const": "E_REF_NOT_FOUND",
          "description": "No ref by that name.",
          "type": "string"
        },
        {
          "const": "E_REF_NAME_INVALID",
          "description": "The ref name is one no store format takes, or one the operation does not move:\n`details.reason` is `reserved` for a `remote/` name, which only a fetch writes, and `tag`\nfor a tag named as the target of a land or a commit's `advance`.",
          "type": "string"
        },
        {
          "const": "E_STORE_CORRUPT",
          "description": "Stored data failed verification. A metadata file that does not parse also names\n`details.fs_op` and `details.store_file`.",
          "type": "string"
        },
        {
          "const": "E_INVALID_ARG",
          "description": "A malformed argument or request, including a command-line usage error.",
          "type": "string"
        },
        {
          "const": "E_UNSUPPORTED_FS",
          "description": "The store path is not on a native Linux filesystem (for example WSL's `/mnt/*`).",
          "type": "string"
        },
        {
          "const": "E_IO",
          "description": "The filesystem refused an operation: `details.fs_op` names it, and `details.store_file`\nthe file of the store it was on, relative to the store's root. A journal append it\nrefused for want of permission or as a read-only filesystem also says\n`details.committed: false`: nothing was committed, and running the same operation again\nfails the same way until the hint's cause is fixed. `git import` also gives it for a\nframe that committed but failed after its commit point, with `details.committed: true`,\n`details.warnings` and no `fs_op`: the import stopped there, `details.imported` and\n`details.last_commit` say what it recorded, and the hint is to run it again, which\ncontinues after them.",
          "type": "string"
        },
        {
          "const": "E_IO_TRANSIENT",
          "description": "A journal append failed, and the store cut what it wrote back off the journal\n(`details.committed` is `false`): nothing was committed, so running the same operation\nagain is safe. A failure after the commit point is no error: the operation succeeds,\nwith a warning (but in `git import`, which stops there: `E_IO`). `details.fs_op` and `details.store_file` name the append that failed.",
          "type": "string"
        },
        {
          "const": "E_BUSY",
          "description": "Another writer held the store's metadata lock for the whole wait, or commits landed during\nevery one of a read's attempts to take a snapshot; nothing was committed (a commit's\nflushed objects may remain, for GC), and running the operation again can succeed.",
          "type": "string"
        },
        {
          "const": "E_INTERNAL",
          "description": "A bug in SwarmOps, such as a caught panic.",
          "type": "string"
        },
        {
          "const": "E_CONFLICT",
          "description": "The change conflicts with the target: `details.report` lists each conflicting file with\nits kind, its hunks and who changed it on the target. Nothing was recorded; resolve the\nconflicts, then land again (the `hint` says how).",
          "type": "string"
        },
        {
          "const": "E_CAS_RETRY_EXHAUSTED",
          "description": "The target moved before every one of the land's attempts could publish; nothing was\nrecorded, and running the land again can succeed.",
          "type": "string"
        },
        {
          "const": "E_NOTHING_TO_LAND",
          "description": "The land has nothing to add to the target: its head is on the target already, or its\nchange is (`details.reason` says which).",
          "type": "string"
        },
        {
          "const": "E_NOTHING_TO_UNDO",
          "description": "The operation moved no ref, so there is nothing to restore.",
          "type": "string"
        },
        {
          "const": "E_OP_NOT_FOUND",
          "description": "The store has no operation with that id.",
          "type": "string"
        },
        {
          "const": "E_AUTH",
          "description": "The serving entry could not name the caller, or no grant of the store's access file\nnames it.",
          "type": "string"
        },
        {
          "const": "E_POLICY_DENIED",
          "description": "The store's access file grants this identity no such action.",
          "type": "string"
        },
        {
          "const": "E_MAINTENANCE_BUSY",
          "description": "Another gc, repair or upgrade holds the store's maintenance lease; nothing was done, and\nrunning the operation again once it is done can succeed.",
          "type": "string"
        },
        {
          "const": "E_FORMAT_REQUIRED",
          "description": "The ref name is one the store's format does not take but a later one does: `details`\nnames `name`, `needs` (the format that takes it) and `store` (the store's); `swarmops\nupgrade` moves the store to it.",
          "type": "string"
        },
        {
          "const": "E_TAG_IMMUTABLE",
          "description": "A tag was asked to move from one target to another: a tag is created and deleted, never\nmoved (`details.name`). Nothing was written.",
          "type": "string"
        },
        {
          "const": "E_REF_PROTECTED",
          "description": "`main` was asked to be deleted, or moved off its first-parent history by `ref set` or\n`op undo`: it is never deleted, and moves only forward (`details.name`). A move adds\n`changeset` (the head it would drop) and `target`; an undo adds `op` and `id`. Nothing was\nwritten; to take `main` back, land a change that reverts it.",
          "type": "string"
        },
        {
          "const": "E_GIT_NOT_A_REPO",
          "description": "`git import` found no git repository it can open at `git_path` (`details.git_path`).",
          "type": "string"
        },
        {
          "const": "E_GIT_REF_NOT_FOUND",
          "description": "`git import`: the source repository has no `git_ref`, or it names no commit\n(`details.git_ref`; `details.kind` the object it names instead, such as a tree).",
          "type": "string"
        },
        {
          "const": "E_GIT_IMPORT_DIVERGED",
          "description": "`git import`: the target ref's head is not the import of `git_ref`'s commit or of an\nancestor of it, because the source was rewritten, `git_ref` is behind the commit the\nhead holds, or a native changeset was committed on the target, so nothing was written; there is no silent merge. `details` names\n`target_ref`, `target_head`, `git_head` and `base`, the git commit the head stands for\n(the one it holds, or for a native head the one it exports to); and `external_id`\n(`commit`, `changeset`) where the import passed over an external id entry whose changeset\nstands for another commit, which `verify --deep` reports.",
          "type": "string"
        },
        {
          "const": "E_GIT_IMPORT_LOSSY",
          "description": "`git import`: a commit holds content a changeset cannot keep as git has it; `details`\nnames the `commit`, the `path` (also as `path_base64` when it is not UTF-8) and the\nlossy `class`, which the request's `lossy` can allow. The import stops before that\ncommit, and the target ref does not move.",
          "type": "string"
        },
        {
          "const": "E_GIT_UNSUPPORTED",
          "description": "`git import` does not read the source: a SHA-256 repository, reftable refs, a shallow\nclone, a FIFO, a socket or a device where it reads a file of the git directory, a file it\nreads whole there that is longer than 16 MiB, a commit of more than 255 distinct parents\n(a parent listed twice counts once), or an\nentry whose mode is no kind of entry; `details.reason` says which (`object_format`,\n`ref_storage`, `shallow`, `special_file`, `file_too_long`, `parents`, `mode`),\n`details.file` names the file of `special_file` and `file_too_long` by its path in the git\ndirectory (`details.size` and `details.max` give the long one's length and the limit), and\n`details.commit` names the commit of `parents` and `mode`.",
          "type": "string"
        },
        {
          "const": "E_GIT_READ",
          "description": "`git import` could not read the source: an object is missing (as in a partial clone),\ndoes not hash to its id or does not parse, or the filesystem refused a read\n(`details.reason`; `details.object` names the object when there is one).",
          "type": "string"
        },
        {
          "const": "E_GIT_EXPORT_DIVERGED",
          "description": "`git export`: the branch holds commits that are not the export of the source ref's head\nor of an ancestor of it, so the branch did not move; there is no silent merge, and the\nrequest's `force` moves it anyway. `details.reason` says why: `branch_ahead` (commits\nmade in git on top of the export of the head itself, which `git import` brings in),\n`both_moved` (commits made in git on top of an older export, while the source ref moved\ntoo), `branch_moved` (the branch names a commit that is no export of this history),\n`source_moved_back` (the source ref's head is behind the export the branch holds, after\nan `undo` or a `ref set` backwards), `lossy_history` (the branch holds the original\ncommits of a history imported lossily, which the export would replace) or\n`moved_during_export` (another writer moved the branch while this export wrote; running\nthe export again settles it, and what it wrote stays). The first five are found before\nanything is written. `details` also names `branch`, `git_head` (the commit the branch\nholds), `head_changeset` and, when the branch holds the export of a changeset,\n`exported_changeset`.",
          "type": "string"
        },
        {
          "const": "E_GIT_WRITE",
          "description": "`git export` could not write the repository; `details.reason` says what failed: `io` (the\nfilesystem refused a write; `details.path` names the file, relative to the git\ndirectory), `ref_locked` (the branch's lock file, `refs/heads/<branch>.lock`, exists:\nanother git process holds it, or an earlier export died holding it, and git itself says\nto remove it once no git process runs; `details.path` names it) or `ref_name_conflict`\n(an existing ref stands where the branch's name needs a directory, or the other way\nround; `details.branch`). Running the export again after the cause is gone writes what\nis still missing.",
          "type": "string"
        },
        {
          "const": "E_REMOTE_DIVERGED",
          "description": "A push or a sync found the remote branch elsewhere than it can move from: `details.reason`\nsays why (`remote_moved`: it moved since the last fetch, and the push's compare-and-swap\nsent nothing; `not_fast_forward`; `behind`: the store ref is behind the remote;\n`diverged`; `lossy_history`; `no_common_base`: the sync found no changeset both hold),\nwith `remote`, `branch` and, where known, `expected` and `main_moved`. Nothing was sent;\nthe hint names the fetch or the sync to run.",
          "type": "string"
        },
        {
          "const": "E_REMOTE_REJECTED",
          "description": "The remote or git refused: `details.reason` is `auth`, `not_found`, `declined` (a hook or\na rule of the remote's), `bad_objects` (a fetch received an object git's fsck refuses, or\none its refs reach is missing; no tracking ref moved) or `unclassified` (a failure git's\nmessages do not explain, never retried), with `remote` and what git said (`refs`,\n`remote_messages`, `git_exit`, `stderr_tail`, the token redacted).",
          "type": "string"
        },
        {
          "const": "E_REMOTE_UNREACHABLE",
          "description": "The network or the remote's host did not answer: `details.phase` (`fetch`, `push`,\n`ls_remote`) and `details.cause` (`dns`, `connect`, `timeout`, `tls`, `disconnected`,\n`ssh`). Nothing changed in the store; running the command again can succeed.",
          "type": "string"
        },
        {
          "const": "E_REMOTE_NOT_FOUND",
          "description": "The store records no remote of that name (`details.remote`).",
          "type": "string"
        },
        {
          "const": "E_WS_EXISTS",
          "description": "`ws create` found a workspace of that name already, made by other arguments\n(`details.name`, `details.path` of the existing one).",
          "type": "string"
        },
        {
          "const": "E_WS_NOT_FOUND",
          "description": "No workspace by that name, or at that path (`details.name` when named).",
          "type": "string"
        },
        {
          "const": "E_WS_LOCKED",
          "description": "Another mutation held the workspace's lock for the whole wait (`details.holder`, when it\nis known); running the operation again can succeed.",
          "type": "string"
        },
        {
          "const": "E_WS_DIRTY",
          "description": "The workspace holds edits the operation would overwrite or lose (`details.paths`, the\nfirst 20); the hint names the command that commits or discards them.",
          "type": "string"
        },
        {
          "const": "E_PATH_NOT_EMPTY",
          "description": "`ws create` was given a directory that holds something already (`details.path`).",
          "type": "string"
        },
        {
          "const": "E_UNRESOLVED_CONFLICTS",
          "description": "A rebase still has conflicting paths no one resolved (`details.paths`).",
          "type": "string"
        },
        {
          "const": "E_MARKERS_PRESENT",
          "description": "`ws resolve` found a conflict marker line still in a file (`details.paths`).",
          "type": "string"
        },
        {
          "const": "E_WS_UNPORTABLE",
          "description": "The tree holds paths the workspace's volume cannot hold: `details.reason` says why\n(`case_collision`, `windows_name`, `reserved_name`: a path component named `.swarmws` at\nany depth, in any ASCII case) and `details.paths` names them. Nothing was written.",
          "type": "string"
        },
        {
          "const": "E_WS_OUTSIDE_PREFIXES",
          "description": "A sparse workspace's `ws commit` or `ws land` met edits outside its prefixes\n(`details.paths`, sorted, the first 20). Nothing changed; the hint names\n`swarmops ws materialize <path>`, which widens the prefixes.",
          "type": "string"
        },
        {
          "const": "E_WS_STALE",
          "description": "`ws land` found the workspace's base gone from its target's history\n(`details.target`, `base`, `head`; `base_op`, the operation that moved the target to\nthe base; `moved_op`, the latest that moved it to `head`, or null when not found).\nNothing changed; the hint names `swarmops ws rebase`.",
          "type": "string"
        },
        {
          "const": "E_CHECK_FAILED",
          "description": "A workspace's check or bootstrap command failed or ran past its time\n(`details.stage`: `check` or `bootstrap`; `exit_code`, `timed_out`, the tails of its\noutput, `log`, `changeset`). Nothing was landed.",
          "type": "string"
        }
      ],
      "title": "ErrorCode"
    },
    "FetchReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`fetch`: bring a remote's branches and tags into the store's mirror, and its followed\nbranch's commits into the store as changesets. No ref of the store moves, so it needs no\nidentity.",
      "properties": {
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "title": "FetchReq",
      "type": "object"
    },
    "FetchResp": {
      "$defs": {
        "BranchUpdate": {
          "description": "A remote branch a fetch saw move, appear or go.",
          "properties": {
            "branch": {
              "description": "The branch, by its short name.",
              "type": "string"
            },
            "new": {
              "description": "The commit it names now; omitted for a branch the remote deleted.",
              "type": [
                "string",
                "null"
              ]
            },
            "old": {
              "description": "The commit it named before; omitted for a branch that appeared.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "branch"
          ],
          "type": "object"
        },
        "RemoteHead": {
          "description": "A remote branch's head: its commit, and the changeset that commit is in the store.",
          "properties": {
            "changeset": {
              "description": "The changeset id of that commit in the store.",
              "type": "string"
            },
            "sha": {
              "description": "The commit's git id, 40 lowercase hex digits.",
              "type": "string"
            }
          },
          "required": [
            "sha",
            "changeset"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`fetch`: where the followed branch stands, and what moved.",
      "properties": {
        "branch": {
          "description": "The followed branch.",
          "type": "string"
        },
        "branches": {
          "description": "The remote branches that moved, appeared or went, at most 1,000.",
          "items": {
            "$ref": "#/$defs/BranchUpdate"
          },
          "type": "array"
        },
        "branches_truncated": {
          "description": "Whether more branches moved than `branches` lists.",
          "type": "boolean"
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteHead"
            },
            {
              "type": "null"
            }
          ],
          "description": "The followed branch's head after the fetch; omitted when the remote has no such branch."
        },
        "imported": {
          "description": "How many changesets the import of the followed branch added.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_head": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteHead"
            },
            {
              "type": "null"
            }
          ],
          "description": "The followed branch's head as the last fetch saw it; omitted when none did."
        },
        "remote": {
          "description": "The remote, by its name.",
          "type": "string"
        },
        "tags_fetched": {
          "description": "How many tags the fetch brought into the mirror (they are never imported).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "description": "What the fetch has to say that did not stop it. Omitted when there is nothing.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "remote",
        "branch",
        "imported",
        "branches",
        "branches_truncated",
        "tags_fetched"
      ],
      "title": "FetchResp",
      "type": "object"
    },
    "FileConflictOut": {
      "$defs": {
        "ConflictKindOut": {
          "description": "What kind of conflict a file has. `ours` is the change, `theirs` the target.",
          "oneOf": [
            {
              "const": "content",
              "description": "Both sides edited the same lines of a text file, or lines next to each other.",
              "type": "string"
            },
            {
              "const": "binary",
              "description": "Both sides changed the content of a file that is not text, or of a symlink, differently.",
              "type": "string"
            },
            {
              "const": "delete_modify",
              "description": "The change deleted the file, and the target changed it.",
              "type": "string"
            },
            {
              "const": "modify_delete",
              "description": "The change changed the file, and the target deleted it.",
              "type": "string"
            },
            {
              "const": "add_add",
              "description": "Both sides added the file, with contents that do not merge.",
              "type": "string"
            },
            {
              "const": "mode",
              "description": "Both sides changed the file's kind (file, executable or symlink), differently.",
              "type": "string"
            },
            {
              "const": "type_change",
              "description": "One side has a file where the other has a directory, or the change deleted a file where\nthe target made a directory.",
              "type": "string"
            }
          ]
        },
        "HunkOut": {
          "description": "One place where the two sides' edits of a text file meet: each side's lines there. The lines\nare numbered from 1, and each side's range includes both ends, as `read_file` takes a range\nof lines.",
          "properties": {
            "base": {
              "$ref": "#/$defs/LinesOut",
              "description": "The lines at the merge base."
            },
            "id": {
              "description": "Its number in the file, from 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "ours": {
              "$ref": "#/$defs/LinesOut",
              "description": "The change's lines."
            },
            "theirs": {
              "$ref": "#/$defs/LinesOut",
              "description": "The target's lines."
            }
          },
          "required": [
            "id",
            "base",
            "ours",
            "theirs"
          ],
          "type": "object"
        },
        "LinesOut": {
          "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
          "properties": {
            "first": {
              "description": "The first line.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "last": {
              "description": "The last line; `first` minus one when the side has none.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "The lines' text; omitted from the first hunk whose texts would pass the report's\n`max_conflict_bytes`, and on the hunk that spans the first file's hunks past the\nreport's bound (`truncated`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One conflicting file. Its blobs are the file's content on each side, which `read_file` reads\nat that side's changeset; a side without a file at the path (deleted, never added, or a\ndirectory there) has none.",
      "properties": {
        "base_blob": {
          "description": "Its blob at the merge base.",
          "type": [
            "string",
            "null"
          ]
        },
        "hunks": {
          "description": "The places where the two sides' edits of its lines meet, in file order: for a text file\nboth sides edited (`content` and `add_add`; contents not all text, or past the line\ndiff's bound of 49,152 lines or 8 MiB a side, conflict as `binary`, with no hunks).\nOmitted when there are none.",
          "items": {
            "$ref": "#/$defs/HunkOut"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ConflictKindOut",
          "description": "What kind of conflict it is."
        },
        "ours_blob": {
          "description": "Its blob in the change.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The file's repository path.",
          "type": "string"
        },
        "theirs_agent": {
          "description": "The agent that wrote `theirs_changeset`.",
          "type": [
            "string",
            "null"
          ]
        },
        "theirs_blob": {
          "description": "Its blob on the target.",
          "type": [
            "string",
            "null"
          ]
        },
        "theirs_changeset": {
          "description": "The newest changeset on the target since the merge base that changed this path: what to\nread for the other side's edit.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "FileConflictOut",
      "type": "object"
    },
    "FileContent": {
      "$defs": {
        "ContentEncoding": {
          "description": "How `FileContent.content` encodes bytes.",
          "oneOf": [
            {
              "const": "utf8",
              "description": "The bytes are UTF-8 text, and `content` is that text.",
              "type": "string"
            },
            {
              "const": "base64",
              "description": "`content` is the bytes in standard, padded base64.",
              "type": "string"
            }
          ]
        },
        "FileKind": {
          "description": "What a file is; never a directory.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            }
          ]
        },
        "LineRange": {
          "description": "A range of a file's lines, numbered from 1: `first` to `last`, both included.",
          "properties": {
            "first": {
              "description": "The range's first line: at least 1.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "last": {
              "description": "The range's last line: at least `first`.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`read_file` (CLI `cat`): a file's content, or the part of it the request names.",
      "properties": {
        "blob": {
          "description": "The blob's id.",
          "type": "string"
        },
        "content": {
          "description": "The bytes returned: those from `offset`, or the requested lines, at most `max_bytes` of\nthem. A cut keeps text as text: it falls where a character starts, so text may stop up to\n3 bytes short of `max_bytes`, while bytes that are not text stop at exactly `max_bytes`.",
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "description": "How `content` encodes the bytes it returns: `utf8` when they are text, `base64` when they\nare not (as when `offset` falls inside a character)."
        },
        "kind": {
          "$ref": "#/$defs/FileKind",
          "description": "The file's kind."
        },
        "lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a request by `lines`: the lines of its range that exist, which `content` holds (the\nstart of them when `truncated`); omitted when none does."
        },
        "next_offset": {
          "description": "When `truncated`: where `content` stops, the `offset` that reads on from there, to the\nfile's end: a `lines` range is not kept. It pins no revision: read on at the full id the\nfirst read resolved (the envelope's `meta.resolved`), or a ref that moved since gives\nanother file's bytes, with no error. A cut text holds whole characters, so a `max_bytes`\nunder 4 can stop before a longer character at the `offset` it started from.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "description": "Where `content` starts in the file, in bytes: the request's `offset`, or where the first\nof its `lines` that exists starts (the file's size when none does); omitted when that is\nthe file's start.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "description": "The whole blob's size in bytes, also when `content` is part of it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Whether `content` stops before the end of what was asked for: the file, from `offset`; or\nthe requested lines that exist.",
          "type": "boolean"
        }
      },
      "required": [
        "blob",
        "size",
        "kind",
        "encoding",
        "content",
        "truncated"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "FileDiff": {
      "$defs": {
        "DiffHunk": {
          "description": "A hunk of a unified diff: one or more changes and the unchanged lines around them, with the\nnumbers of its header, `@@ -old_start,old_lines +new_start,new_lines @@`.",
          "properties": {
            "lines": {
              "description": "Its lines, in order; each change's removed lines come before its added lines.",
              "items": {
                "$ref": "#/$defs/DiffLineOut"
              },
              "type": "array"
            },
            "new_lines": {
              "description": "How many new lines it holds: its context and added lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "new_start": {
              "description": "The first new line it holds, counted as `old_start` is.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_lines": {
              "description": "How many old lines it holds: its context and removed lines.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "old_start": {
              "description": "The first old line it holds, counted from 1; when it holds none, the line before where\nthey would be (0 at the top), as git prints it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "old_start",
            "old_lines",
            "new_start",
            "new_lines",
            "lines"
          ],
          "type": "object"
        },
        "DiffLineOut": {
          "description": "One line of a hunk.",
          "properties": {
            "op": {
              "$ref": "#/$defs/LineOp",
              "description": "Whether both sides have it, only the new one, or only the old one."
            },
            "text": {
              "description": "The line with its line break, a carriage return before it kept; a file's last line has\nnone when the file does not end in one.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ],
          "type": "object"
        },
        "DiffStatus": {
          "description": "What happened to a file between the two revisions.",
          "oneOf": [
            {
              "const": "added",
              "description": "It is in `to` only: in `from`, nothing or a directory is there.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is in `from` only.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content or its exec bit changed: a file or an executable on both sides, or a\nsymlink on both sides.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A symlink on one side, a file or an executable on the other.",
              "type": "string"
            }
          ]
        },
        "FileKind": {
          "description": "What a file is; never a directory.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            }
          ]
        },
        "LineOp": {
          "description": "Which side of a diff a hunk's line is on.",
          "oneOf": [
            {
              "const": "context",
              "description": "Both: an unchanged line around a change.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "The new side only.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "The old side only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One file that differs: a file, an executable or a symlink whose content or kind changed, or\nthat is on one side only. A directory never is one: a file that becomes a directory is that\nfile deleted and the directory's files added. No rename is detected: a file that moved is\none deleted and one added. Which fields follow `status` depends on the request's `format`,\nand a field that says nothing is omitted.",
      "properties": {
        "binary": {
          "description": "`stat` and `unified`: whether it is binary, which gets no line counts and no hunks: a side\nthat is not UTF-8, or holds a NUL in its first 8,000 bytes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "deletions": {
          "description": "`stat` and `unified`, for text within the line diff's bound: the lines the change\ndeletes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hunks": {
          "description": "`unified`, for text: the hunks, in order; empty when only the exec bit or the kind\nchanged.",
          "items": {
            "$ref": "#/$defs/DiffHunk"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "hunks_truncated": {
          "description": "`stat` and `unified`: true for text past the line diff's bound (49,152 lines or 8 MiB a\nside), which gets no `insertions`, `deletions` or hunks (`hunks` empty for `unified`);\nand for `unified`, when `hunks` stops before the file's last hunk, to keep the page within\n`max_bytes`, `insertions` and `deletions` counting every line all the same. Omitted\notherwise.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "insertions": {
          "description": "`stat` and `unified`, for text within the line diff's bound: the lines the change\ninserts.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "new_blob": {
          "description": "`unified`: its blob id in `to`; omitted for a deleted file.",
          "type": [
            "string",
            "null"
          ]
        },
        "new_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "`unified`: its kind in `to`; omitted for a deleted file."
        },
        "old_blob": {
          "description": "`unified`: its blob id in `from`; omitted for an added file.",
          "type": [
            "string",
            "null"
          ]
        },
        "old_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "`unified`: its kind in `from`; omitted for an added file."
        },
        "path": {
          "description": "The repository path.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DiffStatus",
          "description": "What happened to it."
        }
      },
      "required": [
        "path",
        "status"
      ],
      "title": "FileDiff",
      "type": "object"
    },
    "FileKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a file is; never a directory.",
      "oneOf": [
        {
          "const": "file",
          "description": "A regular file.",
          "type": "string"
        },
        {
          "const": "exec",
          "description": "An executable file.",
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink.",
          "type": "string"
        }
      ],
      "title": "FileKind"
    },
    "GcCount": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`gc`: how many leftovers of one kind.",
      "properties": {
        "count": {
          "description": "How many.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "`object_temp`, `derived_temp`, `meta_staging`, `derived_version` or `upgrade_residue`.\nA string, as `OpError.code` is, so that a client can read kinds newer than its own list.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "count"
      ],
      "title": "GcCount",
      "type": "object"
    },
    "GcReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`gc`: remove the store's leftovers (temp files past a day, a crashed create's staging,\nderived values of older versions, what an upgrade left of the format before). It removes no\nobject and no changeset.",
      "properties": {
        "dry_run": {
          "default": false,
          "description": "List what it would remove, and remove nothing.",
          "type": "boolean"
        }
      },
      "title": "GcReq",
      "type": "object"
    },
    "GcResp": {
      "$defs": {
        "GcCount": {
          "description": "`gc`: how many leftovers of one kind.",
          "properties": {
            "count": {
              "description": "How many.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "description": "`object_temp`, `derived_temp`, `meta_staging`, `derived_version` or `upgrade_residue`.\nA string, as `OpError.code` is, so that a client can read kinds newer than its own list.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "count"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`gc`: what it removed, or would remove for a dry run.",
      "properties": {
        "bytes": {
          "description": "The bytes of their files.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "orphan_objects": {
          "description": "How many object files no changeset of the store reaches: counted, never removed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "description": "How many leftovers of each kind; kinds with none are omitted.",
          "items": {
            "$ref": "#/$defs/GcCount"
          },
          "type": "array"
        }
      },
      "required": [
        "removed",
        "bytes",
        "orphan_objects"
      ],
      "title": "GcResp",
      "type": "object"
    },
    "GitExportReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`git export`: write the history behind a store ref into a branch of a git repository. Every\ncommit that the branch's last export does not reach is written, parents first: a changeset\nthat was imported from git keeps the commit it came from, and one made in the store becomes a\ncommit with its own signatures and `SwarmOps-*` trailers. The branch moves to the export of\nthe ref's head by compare-and-swap, and only once everything it reaches is durable. It runs\non the caller's host, as `git import` does: no server receives this request, and it is no MCP\ntool. It derives the export oids it compares the branch with, names as parents and moves the\nbranch to, and takes or refuses memos, as `git import` does: with the store's memo key, a\nmemo whose MAC checks stops the walk of the history below it.",
      "properties": {
        "branch": {
          "default": "main",
          "description": "The git branch to write, by its short name (`main`, the default, or `stable`; the\nrepository's `refs/heads/<branch>`), created if it does not exist. If it does, its commit\nmust be the export of `source_ref`'s head or of an ancestor of it, and only the commits\nafter that export are written; a branch at any other commit is `E_GIT_EXPORT_DIVERGED`,\nand nothing is written. In a repository with a work tree, the branch that `HEAD` names is\nrefused (`E_INVALID_ARG`, with `details.reason` `checked_out`), as `git push` refuses it\nby default.",
          "type": "string"
        },
        "force": {
          "default": false,
          "description": "Move the branch although it diverged: to the export of `source_ref`'s head, by\ncompare-and-swap against the commit the export read, so that a branch another writer\nmoves meanwhile still stops it. It does not override a checked-out branch. Off by default.",
          "type": "boolean"
        },
        "git_path": {
          "description": "The git repository to write, on the caller's host: its directory, absolute or relative to\nthe caller's working directory (a bare repository, or a work tree with its `.git`). It\nexists already: `git init --bare` makes one. The caller reads and writes it; no store or\nserver is ever asked to read or write a path.",
          "type": "string"
        },
        "source_ref": {
          "default": "main",
          "description": "The store ref whose history to export: `main` (the default) or `release/<name>`. Its head\nis the commit the branch ends at.",
          "type": "string"
        }
      },
      "required": [
        "git_path"
      ],
      "title": "GitExportReq",
      "type": "object"
    },
    "GitExportResp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`git export`: what the export wrote, and where the branch stands.",
      "properties": {
        "branch": {
          "description": "The branch the export wrote, by its short name.",
          "type": "string"
        },
        "branch_moved": {
          "description": "Whether this export moved the branch, or created it; `false` when the branch named\n`head_sha` already, after an earlier export of the same head or a concurrent one.",
          "type": "boolean"
        },
        "exported": {
          "description": "How many commits this export wrote to the repository: the commits of the ref's history\nthat the branch's last export did not reach and the repository did not hold. A branch that\nis up to date exports 0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "head_changeset": {
          "description": "The changeset at `source_ref`'s head, which `head_sha` is the export of.",
          "type": "string"
        },
        "head_sha": {
          "description": "The commit the branch names now, the export of `head_changeset`: its git id, 40 lowercase\nhex digits.",
          "type": "string"
        },
        "incremental": {
          "description": "Whether the branch held an earlier export that this one continued, so that only the\ncommits after it were written; `false` for a branch the export created, or one that\n`force` moved from a history that was no export of this one.",
          "type": "boolean"
        },
        "objects_written": {
          "description": "How many git objects (commits, trees and blobs) this export wrote to the repository.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_sha": {
          "description": "The commit the branch named when the export started; omitted when the branch did not\nexist, and the export created it.",
          "type": [
            "string",
            "null"
          ]
        },
        "rewritten": {
          "description": "How many of the exported commits have another id than the commit they were imported from:\na commit the import took lossily (`git.lossy`) renders to other bytes than the git commit\nit came from, and so does every commit above it, whose parent has another id now; their\nsignature headers no longer verify. Commits made in the store were never imported and are\nnot counted.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "description": "What the export has to say that did not stop it, such as how many of its commits it\nrewrote (`rewritten`). Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "exported",
        "objects_written",
        "head_changeset",
        "head_sha",
        "branch",
        "branch_moved",
        "incremental",
        "rewritten"
      ],
      "title": "GitExportResp",
      "type": "object"
    },
    "GitImportReq": {
      "$defs": {
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
            {
              "const": "gitlinks",
              "description": "A submodule's entry (git mode 160000): dropped.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
              "type": "string"
            },
            {
              "const": "modes",
              "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
              "type": "string"
            },
            {
              "const": "tree_order",
              "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
              "type": "string"
            },
            {
              "const": "empty_trees",
              "description": "An entry naming an empty tree: dropped.",
              "type": "string"
            },
            {
              "const": "nonstandard",
              "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`git import`: bring a git repository's history into the store. Every commit that `git_ref`\nreaches and the store does not hold yet becomes a changeset, parents first, and\n`target_ref` moves to the changeset of `git_ref`'s commit. It runs on the caller's host, as\n`init` does: no server receives this request, and it is no MCP tool. The git oids it takes\nfor the target's head, its trees and its blobs are derived from the store's objects, and\neach memo it meets is checked against them; with the store's memo key, which the CLI keeps\noutside the store, a memo whose MAC checks is taken, and nothing below it read. A memo that\ndisagrees, or whose MAC does not check, is `E_STORE_CORRUPT`, with nothing written.",
      "properties": {
        "git_path": {
          "description": "The git repository to read, on the caller's host: its directory, absolute or relative to\nthe caller's working directory (a bare repository, or a work tree with its `.git`). The\ncaller reads it; no store or server is ever asked to read a path.",
          "type": "string"
        },
        "git_ref": {
          "default": "HEAD",
          "description": "The commit to import, with every commit it reaches: `HEAD` (the default), a ref name,\nshort or full (`stable`, `refs/heads/stable`), looked up in git's order, or a commit id\nof 40 hex digits; a tag is peeled to its commit. There is no revision syntax such as\n`main~3`.",
          "type": "string"
        },
        "lossy": {
          "default": [],
          "description": "The classes of content the import may drop or normalize; a changeset that loses any\nnames them in its `git.lossy` metadata. Empty by default: a commit the import converts\nthat holds any class is refused with `E_GIT_IMPORT_LOSSY`, which names the commit, the\npath and the class. A commit the store holds already is reused as it is, even one an\nearlier import took with a loss.",
          "items": {
            "$ref": "#/$defs/LossyClass"
          },
          "type": "array"
        },
        "target_ref": {
          "default": "main",
          "description": "The ref to move to that commit's changeset: `main` (the default) or `release/<name>`,\ncreated if it does not exist. If it does, its head must be the import of that commit or\nof an ancestor of it, and only the commits after that head are imported; any other head\n(the source was rewritten, or a native changeset was committed on the ref) is\n`E_GIT_IMPORT_DIVERGED`, and nothing is written.",
          "type": "string"
        }
      },
      "required": [
        "git_path"
      ],
      "title": "GitImportReq",
      "type": "object"
    },
    "GitImportResp": {
      "$defs": {
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
            {
              "const": "gitlinks",
              "description": "A submodule's entry (git mode 160000): dropped.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
              "type": "string"
            },
            {
              "const": "modes",
              "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
              "type": "string"
            },
            {
              "const": "tree_order",
              "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
              "type": "string"
            },
            {
              "const": "empty_trees",
              "description": "An entry naming an empty tree: dropped.",
              "type": "string"
            },
            {
              "const": "nonstandard",
              "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
              "type": "string"
            }
          ]
        },
        "LossyCommitOut": {
          "description": "`git import`: a commit taken lossily, and what it lost.",
          "properties": {
            "changeset": {
              "description": "The changeset made of it, whose `git.lossy` metadata names the same classes.",
              "type": "string"
            },
            "classes": {
              "description": "The classes dropped or normalized in it, ordered by name, as `git.lossy` lists them.",
              "items": {
                "$ref": "#/$defs/LossyClass"
              },
              "type": "array"
            },
            "commit": {
              "description": "The git commit: its id, 40 lowercase hex digits.",
              "type": "string"
            }
          },
          "required": [
            "commit",
            "changeset",
            "classes"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`git import`: what the import brought in, and where the target ref stands.",
      "properties": {
        "git_head_sha": {
          "description": "`git_ref`'s commit: its git id, 40 lowercase hex digits.",
          "type": "string"
        },
        "head_changeset": {
          "description": "The changeset of `git_ref`'s commit, which `target_ref` names now.",
          "type": "string"
        },
        "imported": {
          "description": "How many commits became changesets in this import.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "lossy": {
          "description": "The commits this import took lossily, as the request's `lossy` allowed: the first 100,\nin the order imported. `lossy_total` counts them all.",
          "items": {
            "$ref": "#/$defs/LossyCommitOut"
          },
          "type": "array"
        },
        "lossy_total": {
          "description": "How many commits this import took lossily, the ones past the first 100 included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_head": {
          "description": "What `target_ref` named when the import started; omitted when it did not exist, and the\nimport created it.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref_moved": {
          "description": "Whether this import moved `target_ref`, or created it; `false` when the ref named\n`head_changeset` already, after an earlier import of the same commit or a concurrent one.",
          "type": "boolean"
        },
        "skipped": {
          "description": "How many commits the import found in the store already, where its walk stopped: the\ncommit of the target's head, or commits an earlier import made. Importing the commit the\ntarget names already imports 0 and skips 1.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "target_ref": {
          "description": "The ref the import moved, or found at `head_changeset` already.",
          "type": "string"
        },
        "warnings": {
          "description": "Problems the import met that did not stop it, such as failed housekeeping after the\ntarget's move became durable; the import itself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "imported",
        "skipped",
        "head_changeset",
        "git_head_sha",
        "target_ref",
        "ref_moved",
        "lossy",
        "lossy_total"
      ],
      "title": "GitImportResp",
      "type": "object"
    },
    "HeadMove": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A head before and after a sync.",
      "properties": {
        "new": {
          "description": "What it names now.",
          "type": "string"
        },
        "old": {
          "description": "What it named before; omitted when it did not exist.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "new"
      ],
      "title": "HeadMove",
      "type": "object"
    },
    "HunkOut": {
      "$defs": {
        "LinesOut": {
          "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
          "properties": {
            "first": {
              "description": "The first line.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "last": {
              "description": "The last line; `first` minus one when the side has none.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "The lines' text; omitted from the first hunk whose texts would pass the report's\n`max_conflict_bytes`, and on the hunk that spans the first file's hunks past the\nreport's bound (`truncated`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "first",
            "last"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One place where the two sides' edits of a text file meet: each side's lines there. The lines\nare numbered from 1, and each side's range includes both ends, as `read_file` takes a range\nof lines.",
      "properties": {
        "base": {
          "$ref": "#/$defs/LinesOut",
          "description": "The lines at the merge base."
        },
        "id": {
          "description": "Its number in the file, from 0.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ours": {
          "$ref": "#/$defs/LinesOut",
          "description": "The change's lines."
        },
        "theirs": {
          "$ref": "#/$defs/LinesOut",
          "description": "The target's lines."
        }
      },
      "required": [
        "id",
        "base",
        "ours",
        "theirs"
      ],
      "title": "HunkOut",
      "type": "object"
    },
    "Identity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The caller of a mutation: an agent name `<family>/<instance>` (`agent/worker-17`,\n`human/purple`) and an optional run id. M1 trusts the name as claimed.\n\nThe agent name always follows the grammar below, also in an identity read from JSON.",
      "properties": {
        "agent": {
          "description": "`<family>/<instance>`, exactly as the schema's `pattern` and `maxLength` give it.",
          "maxLength": 255,
          "pattern": "^[a-z0-9-]+/[A-Za-z0-9_-][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "run_id": {
          "description": "The run the agent acts in, when it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent"
      ],
      "title": "Identity",
      "type": "object"
    },
    "IdentityInfo": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`whoami`: the identity the caller's mutations carry.",
      "properties": {
        "agent": {
          "description": "`<family>/<instance>`; omitted for an anonymous caller.",
          "type": [
            "string",
            "null"
          ]
        },
        "auth": {
          "description": "How this caller's identity was established: `trust` (claimed, not verified) or\n`anonymous`.",
          "type": "string"
        },
        "run_id": {
          "description": "The run the agent acts in, when it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "auth"
      ],
      "title": "IdentityInfo",
      "type": "object"
    },
    "InfoReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`info`: describe the store. It has no options yet.",
      "title": "InfoReq",
      "type": "object"
    },
    "InitReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`init`: create a store.",
      "properties": {
        "format": {
          "description": "The store format to create, 1 or 2; omitted for this build's default. A format this\nbuild does not create is `E_INVALID_ARG`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "The repository's name: at most 255 bytes of UTF-8.",
          "type": "string"
        },
        "path": {
          "description": "The directory to create the store in.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "name"
      ],
      "title": "InitReq",
      "type": "object"
    },
    "LandMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How a workspace lands.",
      "oneOf": [
        {
          "const": "merge",
          "description": "Merge onto the target's head, wherever it has moved.",
          "type": "string"
        },
        {
          "const": "exact",
          "description": "Publish only onto the target's head the workspace was rebased onto, so that the landed\ntree is the rebased one.",
          "type": "string"
        }
      ],
      "title": "LandMode"
    },
    "LandReq": {
      "$defs": {
        "ContentInput": {
          "description": "A `put`'s content, as an object with one key.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "UTF-8 text, verbatim.",
              "properties": {
                "inline": {
                  "type": "string"
                }
              },
              "required": [
                "inline"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Bytes in standard, padded base64.",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A blob the store holds already, by its id (64 hex digits), as `blob_put` returns it: the\ncommit neither sends nor reads its bytes. An id the store holds no blob under (none, or\na tree's or a changeset's) is `E_INVALID_ARG`, and nothing is written. `blob_put` takes\nthe other forms only.",
              "properties": {
                "blob": {
                  "type": "string"
                }
              },
              "required": [
                "blob"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
              "properties": {
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            }
          ]
        },
        "ModeInput": {
          "description": "The kind of entry a `put` writes.",
          "oneOf": [
            {
              "const": "file",
              "description": "A regular file (git mode 100644).",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file (git mode 100755).",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink; the content is the link's target.",
              "type": "string"
            }
          ]
        },
        "ResolutionInput": {
          "description": "What a land makes of one path, and of every path below it: exactly one of `take`, `content`\nand `delete` (anything else is `E_INVALID_ARG`, a rule the server checks), the rest of the\nmerge as it merged.",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One file of new content, given as a commit's change gives it (inline, base64, a client\nfile, or a stored blob by id), within a commit's limits; nothing below it."
            },
            "delete": {
              "description": "Nothing there: no file at the path, nor below it.",
              "type": "boolean"
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModeInput"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The kind of the file `content` makes, only beside it; when omitted, the kind of the file\nours holds there, else theirs', else a regular file."
            },
            "take": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Side"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What one side holds there: `ours`, the change's head, or `theirs`, the target's head."
            }
          },
          "type": "object"
        },
        "ResolutionsInput": {
          "description": "A land's resolutions (`land --resolve`): what to make of some paths of the merge of the change\nonto the target, decided against one of the target's heads.",
          "properties": {
            "against": {
              "$ref": "#/$defs/Rev",
              "description": "The target's head the resolutions were decided against: the conflict report's `theirs`,\nby its full 64-hex id. A resolution applies while the target holds its path as this\nchangeset does (the same file, the same directory, or nothing)."
            },
            "files": {
              "additionalProperties": {
                "$ref": "#/$defs/ResolutionInput"
              },
              "description": "What to make of each path, by its repository path.",
              "type": "object"
            }
          },
          "required": [
            "against",
            "files"
          ],
          "type": "object"
        },
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        },
        "Side": {
          "description": "One side of a land's merge.",
          "oneOf": [
            {
              "const": "ours",
              "description": "The change: its head.",
              "type": "string"
            },
            {
              "const": "theirs",
              "description": "The target: its head when the land merges.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`land`: merge a change three-way onto a target ref and publish it there as one new\nchangeset, in one transaction (operations spec §3). The change is `head` with its\nfirst-parent chain after `base`, squashed: the landed changeset's parent is the target's\nhead, so the target stays linear. A conflict is the error `E_CONFLICT`, with the report in\n`details.report`; nothing is recorded then.",
      "properties": {
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the change starts: a first-parent ancestor of `head`, whose own changes are not part\nof it (anything else is `E_INVALID_ARG`). It need not be on the target. When omitted, the\nmerge base of `head` and the target's head, along first parents."
        },
        "expect_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Publish only while the target names this changeset (M5): one attempt, and a target that\nnames another is `E_CAS_MISMATCH`, nothing written; `max_attempts` does not apply. With a\n`head` rebased onto it, the landed tree is the rebased tree. `swarmops mcp` refuses one\nthat is not a full 64-hex id (`E_INVALID_ARG`)."
        },
        "head": {
          "$ref": "#/$defs/Rev",
          "description": "The changeset to land: the change's head."
        },
        "idempotency_key": {
          "description": "Makes a retry of this land safe: 1 to 64 letters, digits and `-`, such as a uuid v7. A land\nwith a key first looks down the target's first parents, to `base`, for a changeset that\nlanded with the same key: one squashed from this `head` is the replay, which writes\nnothing (`status` is `replayed`); one from another head is `E_INVALID_ARG`, a key used\nfor another change.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_attempts": {
          "default": 8,
          "description": "How many times to try to publish before failing with `E_CAS_RETRY_EXHAUSTED`: 1 to 32.",
          "format": "uint32",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        },
        "max_conflict_bytes": {
          "default": 32768,
          "description": "The most bytes of hunk text an `E_CONFLICT` report carries: from the first hunk whose\ntexts would pass it, no hunk carries its texts (`truncated`), and the hunks' line\npositions and the blob ids stay. The report's files are bounded apart from it, as\n`ConflictReport.files` says.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "description": "The landed changeset's message; `head`'s when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolutions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionsInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "What to make of the paths an `E_CONFLICT` report named, decided without a checkout\n(operations spec §3, resolution path (b)). Each resolution applies to its path while the\ntarget holds there what `against` held, whether the path conflicts or not; a path the\ntarget changed since is stale, and the land fails `E_CONFLICT` again, with a fresh report\nthat names it in `stale`. Conflicts left unresolved fail it too. `swarmops mcp` refuses\nan `against` that is not a full 64-hex id (`E_INVALID_ARG`)."
        },
        "target": {
          "default": "main",
          "description": "The ref to land on: `main` or `release/<name>`, which must exist.",
          "type": "string"
        }
      },
      "required": [
        "head"
      ],
      "title": "LandReq",
      "type": "object"
    },
    "LandResp": {
      "$defs": {
        "LandStatus": {
          "description": "How a land ended.",
          "oneOf": [
            {
              "const": "landed",
              "description": "This request landed the change.",
              "type": "string"
            },
            {
              "const": "replayed",
              "description": "A land with the same `idempotency_key` had landed it already; nothing was written.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`land`: where the change landed. Ids are full.",
      "properties": {
        "attempts": {
          "description": "How many times the land tried to publish.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "auto_merged": {
          "description": "The paths both sides changed whose contents merged cleanly into a content neither side\nhad. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "base": {
          "description": "The changeset the change was taken from: what `head`'s first-parent chain added after it\nis what landed.",
          "type": "string"
        },
        "files_changed": {
          "description": "How many paths the landed changeset changes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "landed": {
          "description": "The landed changeset: the change squashed into one changeset on the target.",
          "type": "string"
        },
        "rebased_onto": {
          "description": "The target's head the change landed on: `landed`'s parent.",
          "type": "string"
        },
        "relocated": {
          "description": "The target moved after the land read it, and the publish put the change on the new head\nitself, without another attempt.",
          "type": "boolean"
        },
        "squashed_from": {
          "description": "The changesets the land squashed, oldest first: `head`'s first-parent chain after `base`,\nending at `head`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/LandStatus",
          "description": "`landed`, or `replayed` when a land with the same `idempotency_key` had landed the change\nalready."
        },
        "target": {
          "description": "The ref it landed on.",
          "type": "string"
        },
        "warnings": {
          "description": "Problems found after the land became durable, such as failed housekeeping; the land\nitself succeeded. Omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "landed",
        "rebased_onto",
        "target",
        "base",
        "attempts",
        "relocated",
        "files_changed",
        "squashed_from"
      ],
      "title": "LandResp",
      "type": "object"
    },
    "LandStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "How a land ended.",
      "oneOf": [
        {
          "const": "landed",
          "description": "This request landed the change.",
          "type": "string"
        },
        {
          "const": "replayed",
          "description": "A land with the same `idempotency_key` had landed it already; nothing was written.",
          "type": "string"
        }
      ],
      "title": "LandStatus"
    },
    "LineOp": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Which side of a diff a hunk's line is on.",
      "oneOf": [
        {
          "const": "context",
          "description": "Both: an unchanged line around a change.",
          "type": "string"
        },
        {
          "const": "add",
          "description": "The new side only.",
          "type": "string"
        },
        {
          "const": "remove",
          "description": "The old side only.",
          "type": "string"
        }
      ],
      "title": "LineOp"
    },
    "LineRange": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A range of a file's lines, numbered from 1: `first` to `last`, both included.",
      "properties": {
        "first": {
          "description": "The range's first line: at least 1.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "last": {
          "description": "The range's last line: at least `first`.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "first",
        "last"
      ],
      "title": "LineRange",
      "type": "object"
    },
    "LinesOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One side's lines of a hunk: `first` to `last`, numbered from 1, both included. A side without\nlines there has `last` one less than `first`: its place is before line `first`.",
      "properties": {
        "first": {
          "description": "The first line.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "last": {
          "description": "The last line; `first` minus one when the side has none.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "The lines' text; omitted from the first hunk whose texts would pass the report's\n`max_conflict_bytes`, and on the hunk that spans the first file's hunks past the\nreport's bound (`truncated`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "first",
        "last"
      ],
      "title": "LinesOut",
      "type": "object"
    },
    "LogCutOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Where the journal was cut (`meta.recovered.log_cut`).",
      "properties": {
        "at": {
          "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bytes": {
          "description": "How many bytes were cut, to where the journal ended.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "bytes"
      ],
      "title": "LogCutOut",
      "type": "object"
    },
    "LogPage": {
      "$defs": {
        "ChangesetSummary": {
          "description": "One changeset of a log.",
          "properties": {
            "author_agent": {
              "description": "The agent that wrote it, as `show` gives `author.agent`.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "The changeset's id.",
              "type": "string"
            },
            "parents": {
              "description": "The parents' ids, mainline parent first.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "description": "The message's first line.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "parents",
            "author_agent",
            "created_at",
            "title"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`log`: a page of changesets, newest first, following first parents.",
      "properties": {
        "cursor": {
          "description": "When `truncated`: where the next page continues. Opaque: pass it back as given, as the\nnext request's `cursor`.",
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "description": "The changesets.",
          "items": {
            "$ref": "#/$defs/ChangesetSummary"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Whether older history follows this page.",
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "truncated"
      ],
      "title": "LogPage",
      "type": "object"
    },
    "LogReq": {
      "$defs": {
        "Rev": {
          "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`log`: history along first parents, a page at a time.",
      "properties": {
        "cursor": {
          "description": "Resume a log: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page continues from the first parent of the\nchangeset it names, and `rev` is not used.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "paths": {
          "description": "Only the changesets that change one of these paths: a file (its content or kind, or\nwhether it is there), or a directory and anything below it; one trailing `/` is taken.\nOmitted or empty for every changeset.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to start; `main` when omitted."
        }
      },
      "title": "LogReq",
      "type": "object"
    },
    "LossyClass": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
      "oneOf": [
        {
          "const": "gitlinks",
          "description": "A submodule's entry (git mode 160000): dropped.",
          "type": "string"
        },
        {
          "const": "paths",
          "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
          "type": "string"
        },
        {
          "const": "modes",
          "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
          "type": "string"
        },
        {
          "const": "tree_order",
          "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
          "type": "string"
        },
        {
          "const": "empty_trees",
          "description": "An entry naming an empty tree: dropped.",
          "type": "string"
        },
        {
          "const": "nonstandard",
          "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
          "type": "string"
        }
      ],
      "title": "LossyClass"
    },
    "LossyCommitOut": {
      "$defs": {
        "LossyClass": {
          "description": "A class of git content that a changeset cannot hold as git has it (storage spec §7). A\ncommit holding one is refused unless the import's `lossy` allows its class; an allowed class\nis dropped or normalized, a directory a drop leaves empty is dropped with it, and the\nchangeset's `git.lossy` metadata names the classes, since it no longer renders back to the\ncommit's own git id.",
          "oneOf": [
            {
              "const": "gitlinks",
              "description": "A submodule's entry (git mode 160000): dropped.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "A name that is no path component: not UTF-8, `.`, `..`, empty, or holding a `/`:\ndropped.",
              "type": "string"
            },
            {
              "const": "modes",
              "description": "A mode written other than git's own `100644`, `100755`, `120000` and `40000`, such as\n`100664` or a zero-padded `040000`: a regular file's becomes a file or an executable by\nits owner's execute bit, and `040000` a directory.",
              "type": "string"
            },
            {
              "const": "tree_order",
              "description": "A tree whose entries are not in git's order, or that names one entry twice: put in order,\nthe first of a name kept.",
              "type": "string"
            },
            {
              "const": "empty_trees",
              "description": "An entry naming an empty tree: dropped.",
              "type": "string"
            },
            {
              "const": "nonstandard",
              "description": "A commit whose bytes the changeset cannot keep: a signature line, time or header line that\nrenders back differently, no blank line before the message, or a parent listed twice\n(kept once).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`git import`: a commit taken lossily, and what it lost.",
      "properties": {
        "changeset": {
          "description": "The changeset made of it, whose `git.lossy` metadata names the same classes.",
          "type": "string"
        },
        "classes": {
          "description": "The classes dropped or normalized in it, ordered by name, as `git.lossy` lists them.",
          "items": {
            "$ref": "#/$defs/LossyClass"
          },
          "type": "array"
        },
        "commit": {
          "description": "The git commit: its id, 40 lowercase hex digits.",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "changeset",
        "classes"
      ],
      "title": "LossyCommitOut",
      "type": "object"
    },
    "Meta": {
      "$defs": {
        "LogCutOut": {
          "description": "Where the journal was cut (`meta.recovered.log_cut`).",
          "properties": {
            "at": {
              "description": "The journal's byte offset where the torn tail started, and where the journal ends now.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "How many bytes were cut, to where the journal ended.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "at",
            "bytes"
          ],
          "type": "object"
        },
        "RecoveredOut": {
          "description": "What a write's recovery repaired (`meta.recovered`), as offsets and counts in the store's\nmetadata files, with no paths: the storage spec (§2 rule 3, §3) says what each repair is.",
          "properties": {
            "frames_listed": {
              "description": "The journal frames listed that their writer never listed: transactions that committed,\ntheir writer having crashed between the frame's sync and its listing, or failed to list\nit (a warning then); and frames listed again whose entries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "frames_rewritten": {
              "description": "Of those, the frames written to the journal afresh first, because the sync that would\nhave made them durable failed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "index_records_dropped": {
              "description": "The changeset index records cut, counted in its longest column: records a crash left torn,\nor a power loss emptied.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "log_cut": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LogCutOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The torn tail cut off the end of the journal, if there was one: the bytes of a transaction\nthat never reached its commit point; omitted when nothing was cut."
            },
            "off_bytes_dropped": {
              "description": "The bytes dropped from the end of the journal's list of frames: part of an entry, or\nentries a power loss zeroed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "records_replayed": {
              "description": "The changesets replayed from the journal into the index.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "refs_replayed": {
              "description": "The ref files replayed from the journal: replaced, or removed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "views_rebuilt": {
              "description": "Whether a compaction of the changeset index that a crash interrupted was finished.",
              "type": "boolean"
            }
          },
          "required": [
            "frames_listed",
            "frames_rewritten",
            "off_bytes_dropped",
            "index_records_dropped",
            "views_rebuilt",
            "records_replayed",
            "refs_replayed"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What the envelope reports besides the outcome.",
      "properties": {
        "auth": {
          "description": "The store's authentication mode (`trust` in M1), not how this caller was identified.",
          "type": "string"
        },
        "elapsed_ms": {
          "description": "How long the command took, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recovered": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveredOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the command's write repaired before its own work, of what earlier writers left when\nthey crashed or failed after their commit point; omitted when there was nothing to repair,\nand for a command that writes nothing. `commit`, `ref_set`, `ref_delete`, `undo`,\n`git_import`, `git_export`, `fetch`, `push` and `sync` report it on success; `commit`,\n`land`, `ref_set`, `ref_delete` and `undo` on `E_CAS_MISMATCH` too, and `undo` on\n`E_OP_NOT_FOUND` and `E_NOTHING_TO_UNDO`; any other failure loses it. Whoever writes next\ngets it, not the agent whose process crashed, and it is no failure: `warnings` still names\nonly the steps after this command's own commit point that failed."
        },
        "repo": {
          "description": "The store as the user named it, for display; omitted when the command used no store.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolved": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Every revision the command resolved: the string given and the full changeset id it named.",
          "type": "object"
        }
      },
      "required": [
        "elapsed_ms",
        "resolved",
        "auth"
      ],
      "title": "Meta",
      "type": "object"
    },
    "ModeInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The kind of entry a `put` writes.",
      "oneOf": [
        {
          "const": "file",
          "description": "A regular file (git mode 100644).",
          "type": "string"
        },
        {
          "const": "exec",
          "description": "An executable file (git mode 100755).",
          "type": "string"
        },
        {
          "const": "symlink",
          "description": "A symlink; the content is the link's target.",
          "type": "string"
        }
      ],
      "title": "ModeInput"
    },
    "OpChangesetOut": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A changeset an operation recorded.",
      "properties": {
        "agent": {
          "description": "The agent that wrote it, as `show` gives `author.agent`.",
          "type": "string"
        },
        "created_at": {
          "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Its id.",
          "type": "string"
        },
        "land_key": {
          "description": "The idempotency key of the land that made it, when it had one.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "The message's first line.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent",
        "created_at",
        "title"
      ],
      "title": "OpChangesetOut",
      "type": "object"
    },
    "OpError": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A failed operation: the envelope's `error` object.\n\n`code`, `exit` and `retryable` come from one `ErrorCode`. `code` stays a string so a client\ncan read codes newer than its own table.",
      "properties": {
        "code": {
          "description": "The `E_*` code.",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "description": "Machine-readable context, such as `actual` for `E_CAS_MISMATCH`; `{}` when there is none.",
          "type": "object"
        },
        "exit": {
          "description": "The exit code of the CLI.",
          "format": "int32",
          "type": "integer"
        },
        "hint": {
          "description": "The next command to run when there is an obvious one, else null.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "What went wrong.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the operation can succeed when it is run again: as it is after a transient\nfailure, or, after a lost compare-and-swap, with what the error names re-read (the\nmessage says how; the `hint` reads it).",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "exit",
        "details",
        "hint"
      ],
      "title": "OpError",
      "type": "object"
    },
    "OpLogPage": {
      "$defs": {
        "OpChangesetOut": {
          "description": "A changeset an operation recorded.",
          "properties": {
            "agent": {
              "description": "The agent that wrote it, as `show` gives `author.agent`.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "Its id.",
              "type": "string"
            },
            "land_key": {
              "description": "The idempotency key of the land that made it, when it had one.",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "description": "The message's first line.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "agent",
            "created_at",
            "title"
          ],
          "type": "object"
        },
        "OperationKind": {
          "description": "What an operation did, read from what it recorded.",
          "oneOf": [
            {
              "const": "commit",
              "description": "It recorded changesets and moved no ref (`commit`).",
              "type": "string"
            },
            {
              "const": "publish",
              "description": "It recorded one changeset and moved a ref to it (`commit` with `advance`).",
              "type": "string"
            },
            {
              "const": "land",
              "description": "It recorded one changeset that names a lander and moved a ref to it (`land`).",
              "type": "string"
            },
            {
              "const": "ref_move",
              "description": "It moved refs and recorded no changeset (`ref set`, `ref delete`, `undo`).",
              "type": "string"
            },
            {
              "const": "compaction",
              "description": "It recorded a compaction of the changeset index, and nothing else.",
              "type": "string"
            },
            {
              "const": "mixed",
              "description": "Any other mix of changesets, ref moves and compactions.",
              "type": "string"
            }
          ]
        },
        "OperationOut": {
          "description": "One operation: a write transaction, as the journal recorded it.",
          "properties": {
            "changesets": {
              "description": "The changesets it recorded, in its order: at most the request's `max_changesets`.",
              "items": {
                "$ref": "#/$defs/OpChangesetOut"
              },
              "type": "array"
            },
            "changesets_total": {
              "description": "How many changesets it recorded in all, also past `max_changesets`.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "Its id, which `undo` takes: `<op>:<crc>`, the number and its frame's payload CRC-32 as 8\nlowercase hex digits (`4:[crc]`). An operation that took the number of one a failed\nsync took back has another id.",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/OperationKind",
              "description": "What it did, read from what it recorded."
            },
            "op": {
              "description": "Its number: its journal frame's, from 0 in commit order. `before` pages on from it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "ref_moves": {
              "description": "The ref moves it made, in its order.",
              "items": {
                "$ref": "#/$defs/RefMoveOut"
              },
              "type": "array"
            }
          },
          "required": [
            "op",
            "id",
            "kind",
            "changesets",
            "changesets_total",
            "ref_moves"
          ],
          "type": "object"
        },
        "RefMoveOut": {
          "description": "A move of a ref, as the journal recorded it.",
          "properties": {
            "actor": {
              "description": "Who moved it.",
              "type": "string"
            },
            "at": {
              "description": "When it moved, in Unix seconds, as its writer recorded it.",
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "The ref.",
              "type": "string"
            },
            "new": {
              "description": "What it names after; omitted for the move that deleted it.",
              "type": [
                "string",
                "null"
              ]
            },
            "old": {
              "description": "What it named before; omitted for the move that created it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "actor",
            "at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`op_log` (CLI `op log`): a page of operations, newest first.",
      "properties": {
        "ops": {
          "description": "The operations.",
          "items": {
            "$ref": "#/$defs/OperationOut"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Whether older operations follow this page: give the last one's `op` as `before` to read\nthem.",
          "type": "boolean"
        }
      },
      "required": [
        "ops",
        "truncated"
      ],
      "title": "OpLogPage",
      "type": "object"
    },
    "OpLogReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`op_log` (CLI `op log`): the store's operations, newest first, a page at a time. An operation\nis one write transaction: a frame of the journal, numbered from 0 in commit order.",
      "properties": {
        "before": {
          "description": "Start below this operation: the page holds the ones numbered less than it, so the last\n`op` of a page reads on from there. When omitted, from the newest.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "description": "The most operations to return: at least 1 (0 is `E_INVALID_ARG`).",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_changesets": {
          "default": 20,
          "description": "The most changesets to list for each operation; `changesets_total` counts them all.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "OpLogReq",
      "type": "object"
    },
    "OperationKind": {
