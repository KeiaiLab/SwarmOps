          "oneOf": [
            {
              "const": "file",
              "description": "A regular file.",
              "type": "string"
            },
            {
              "const": "exec",
              "description": "An executable file.",
              "type": "string"
            },
            {
              "const": "symlink",
              "description": "A symlink.",
              "type": "string"
            },
            {
              "const": "dir",
              "description": "A directory.",
              "type": "string"
            }
          ]
        },
        "PathHistoryEntry": {
          "description": "One changeset of a path's history, and what the path holds after it.",
          "properties": {
            "author_agent": {
              "description": "The agent that wrote the changeset, as `log` gives it.",
              "type": "string"
            },
            "changeset": {
              "description": "The changeset's id.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was recorded: the committer signature's time, in Unix milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "A blob id for a file, an executable or a symlink; a tree id for a directory; omitted after\na `delete`.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EntryKindOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What is at the path after it; omitted after a `delete`."
            },
            "op": {
              "$ref": "#/$defs/ChangeOp",
