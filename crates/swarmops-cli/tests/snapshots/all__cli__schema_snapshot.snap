          },
          "type": "array"
        }
      },
      "required": [
        "workspaces"
      ],
      "title": "WsList",
      "type": "object"
    },
    "WsListReq": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_list` (client-side): the store's workspaces, from its registry.",
      "properties": {
        "check": {
          "description": "Also open each workspace, and report one whose directory is gone as an orphan.",
          "type": "boolean"
        }
      },
      "title": "WsListReq",
      "type": "object"
    },
    "WsMaterializeReq": {
      "$defs": {
        "StatusAfter": {
          "description": "Whether a workspace mutation's response carries the workspace's status after it.",
          "oneOf": [
            {
              "const": "page",
              "description": "The first page of the status, up to 100 changes.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No status.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_materialize` (client-side): write out more of the tree.",
      "properties": {
        "paths": {
          "description": "The repository paths to add to its prefixes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status_after": {
          "$ref": "#/$defs/StatusAfter",
          "default": "page",
          "description": "Whether the response carries the status after the mutation."
        },
        "workspace": {
          "description": "The workspace, by name.",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "paths"
      ],
      "title": "WsMaterializeReq",
      "type": "object"
    },
    "WsMaterializeResp": {
      "$defs": {
        "WsChange": {
          "description": "One changed path of a workspace.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/WsChangeKind",
              "description": "What changed."
            },
            "path": {
              "description": "The repository path.",
              "type": "string"
            },
            "size": {
              "description": "The file's size now; omitted for a deleted path.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "kind"
          ],
          "type": "object"
        },
        "WsChangeKind": {
          "description": "What changed at a workspace path.",
          "oneOf": [
            {
              "const": "added",
              "description": "A file the head does not hold.",
              "type": "string"
            },
            {
              "const": "modified",
              "description": "Its content changed.",
              "type": "string"
            },
            {
              "const": "deleted",
              "description": "It is gone.",
              "type": "string"
            },
            {
              "const": "type_changed",
              "description": "A file became a symlink, or the other way round.",
              "type": "string"
            },
            {
              "const": "mode_changed",
              "description": "Its executable bit changed.",
              "type": "string"
            }
          ]
        },
        "WsRebasing": {
          "description": "A workspace's rebase in progress.",
          "properties": {
            "conflicts": {
              "description": "The paths that still conflict.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "onto": {
              "description": "The target's head it rebases onto.",
              "type": "string"
            }
          },
          "required": [
            "onto",
            "conflicts"
          ],
          "type": "object"
        },
        "WsState": {
          "description": "A workspace's state.",
          "oneOf": [
            {
              "const": "clean",
              "description": "No rebase in progress.",
              "type": "string"
            },
            {
              "const": "rebasing",
              "description": "A rebase stopped on conflicts.",
              "type": "string"
            }
          ]
        },
        "WsStatus": {
          "description": "A workspace's status: its changes against its head, a page at a time, and how far its target\nhas moved since its base.",
          "properties": {
            "base": {
              "description": "The target's changeset its chain starts from.",
              "type": "string"
            },
            "behind_by": {
              "description": "How many changesets the target's first-parent history holds that `base`'s lacks: those\npast `base` when it is on that history; otherwise (a sync dropped it, or the target moved\nback) those before where the two histories meet, 0 when the target head is on `base`'s\nfirst-parent history fewer than 10,000 changesets behind `base`. At most 10,000.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "changes": {
              "description": "The changes, by path.",
              "items": {
                "$ref": "#/$defs/WsChange"
              },
              "type": "array"
            },
            "cursor": {
              "description": "Where this page stopped.",
              "type": [
                "string",
                "null"
              ]
            },
            "head": {
              "description": "Its chain's last changeset.",
              "type": "string"
            },
            "main": {
              "description": "The head of the workspace's target ref (`main`, or `release/<name>`), read first.",
              "type": "string"
            },
            "name": {
              "description": "The workspace's name.",
              "type": "string"
            },
            "rebasing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WsRebasing"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The rebase in progress, when `state` is `rebasing`."
            },
            "state": {
              "$ref": "#/$defs/WsState",
              "description": "Whether the workspace is rebasing."
            },
            "truncated": {
              "description": "Whether more changes follow: give `cursor` to read them.",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "base",
            "head",
            "main",
            "behind_by",
            "state",
            "changes",
            "truncated"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`ws_materialize`: what was written.",
      "properties": {
        "bytes": {
          "description": "How many bytes were written.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "materialized": {
          "description": "The prefixes added.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/WsStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "The status after the mutation; omitted when the request said `none`."
        }
      },
      "required": [
        "materialized",
        "bytes"
      ],
      "title": "WsMaterializeResp",
      "type": "object"
    },
    "WsRebaseAction": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What a workspace's rebase does.",
      "oneOf": [
        {
          "const": "start",
          "description": "Rebase the workspace's chain onto the target's head.",
          "type": "string"
        },
        {
          "const": "continue",
          "description": "Rebase again with the resolved conflicts.",
          "type": "string"
        },
        {
          "const": "abort",
          "description": "Leave the rebase: restore the conflicting paths from the head.",
          "type": "string"
        }
      ],
      "title": "WsRebaseAction"
    },
