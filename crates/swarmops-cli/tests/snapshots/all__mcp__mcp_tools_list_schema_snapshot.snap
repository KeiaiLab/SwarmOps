---
source: crates/swarmops-cli/tests/mcp.rs
expression: listed
---
{
  "_meta": {
    "io.modelcontextprotocol/serverInfo": {
      "name": "swarmops",
      "title": "SwarmOps",
      "version": "[version]"
    }
  },
  "cacheScope": "public",
  "resultType": "complete",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "What the store is and holds: its id and name, the changeset main points at, and how many changesets and refs it has.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`info`: describe the store. It has no options yet.",
        "title": "InfoReq",
        "type": "object"
      },
      "name": "repo_info",
      "title": "Describe the store"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Reads one file at a revision, without a checkout, as UTF-8 text or base64; pass max_bytes of 32768 or less (less for a binary file), since clients cut long tool results and this one holds the content twice.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`read_file` (CLI `cat`): read one file at a revision, without a checkout.",
        "properties": {
          "max_bytes": {
            "default": 1048576,
            "description": "The most content bytes to return; a longer file comes back truncated.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "The file's repository path.",
            "type": "string"
          },
          "rev": {
            "description": "The revision to read at. A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
            "type": "string"
          }
        },
        "required": [
          "rev",
          "path"
        ],
        "title": "ReadFileReq",
        "type": "object"
      },
      "name": "read_file",
      "title": "Read a file"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Lists one directory at a revision, without a checkout, a page of entries at a time; pass a limit of 100 or less and page on with the cursor, since clients cut long tool results.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`read_tree` (CLI `ls`): list one directory at a revision, without a checkout, a page at a\ntime.",
        "properties": {
          "cursor": {
            "description": "Resume a listing: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page starts after the entry it names.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": 500,
            "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
            "format": "uint",
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "The directory's repository path; omitted for the root.",
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "description": "The revision to read at. A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
            "type": "string"
          }
        },
        "required": [
          "rev"
        ],
        "title": "ReadTreeReq",
        "type": "object"
      },
      "name": "read_tree",
      "title": "List a directory"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "One changeset in full: its parents, author, message, changes and signatures; pass max_changes of 100 or less, since clients cut long tool results.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`show`: one changeset in full.",
        "properties": {
          "max_changes": {
            "default": 400,
            "description": "The most entries of `changes` to return: at least 1 (0 is `E_INVALID_ARG`).",
            "format": "uint",
            "minimum": 1,
            "type": "integer"
          },
          "rev": {
            "description": "The changeset to show. A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
            "type": "string"
          }
        },
        "required": [
          "rev"
        ],
        "title": "ShowReq",
        "type": "object"
      },
      "name": "show",
      "title": "Show a changeset"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "History along first parents, newest first, from main unless rev says otherwise; pass a limit of 100 or less and page on with the cursor, since clients cut long tool results.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`log`: history along first parents, a page at a time.",
        "properties": {
          "cursor": {
            "description": "Resume a log: the previous page's `cursor`. Pass it back exactly as returned; do not\nconstruct it (cursors are opaque). This page continues from the first parent of the\nchangeset it names, and `rev` is not used.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": 50,
            "description": "The most entries to return: at least 1 (0 is `E_INVALID_ARG`).",
            "format": "uint",
            "minimum": 1,
            "type": "integer"
          },
          "rev": {
            "anyOf": [
              {
                "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where to start; `main` when omitted."
          }
        },
        "title": "LogReq",
        "type": "object"
      },
      "name": "log",
      "title": "List history"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Every ref, the changeset it points at, and how many moves it has had.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`ref list`: list every ref. It has no options yet.",
        "title": "RefListReq",
        "type": "object"
      },
      "name": "ref_list",
      "title": "List refs"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Moves a ref, or creates one, by compare-and-swap: give create, or expected_old, the full 64-hex changeset id the ref held when you read it; a ref name, a relative revision or an id prefix is refused, since it is read when the call runs instead of pinning the id you read.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`ref set`: move a ref, or create one, by compare-and-swap. Give exactly one of\n`expected_old` and `create`; both or neither is `E_INVALID_ARG`.",
        "properties": {
          "create": {
            "default": false,
            "description": "To create the ref; if it exists already, the move fails with `E_CAS_MISMATCH`. Give this\nor `expected_old`, not both.",
            "type": "boolean"
          },
          "expected_old": {
            "anyOf": [
              {
                "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "To move an existing ref: the target the caller last saw, by its full changeset id; if the\nref holds another, the move fails with `E_CAS_MISMATCH`. A ref name, a relative revision\nor an id prefix is read from the store when the move runs instead of pinning the id the\ncaller read: the ref's own name always matches, so the compare-and-swap protects nothing,\nand `main~1` on `main` never matches. `swarmops mcp` refuses one (`E_INVALID_ARG`), and\nthe CLI's `--expect` help warns against it. Give this or `create`, not both."
          },
          "name": {
            "description": "The ref: `main` or `release/<name>`.",
            "type": "string"
          },
          "new": {
            "description": "The revision to point it at. A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "new"
        ],
        "title": "RefSetReq",
        "type": "object"
      },
      "name": "ref_set",
      "title": "Move a ref"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Removes a ref by compare-and-swap, if it still holds expected_old, the full 64-hex changeset id it held when you read it; a ref name, a relative revision or an id prefix is refused, since it is read when the call runs instead of pinning the id you read.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`ref delete`: remove a ref by compare-and-swap.",
        "properties": {
          "expected_old": {
            "description": "The target the caller last saw, by its full changeset id; if the ref holds another, the\ndelete fails with `E_CAS_MISMATCH`. A ref name, a relative revision or an id prefix is\nread from the store when the delete runs instead of pinning the id the caller read: the\nref's own name always matches, so the compare-and-swap protects nothing, and `main~1` on\n`main` never matches. `swarmops mcp` refuses one (`E_INVALID_ARG`), and the CLI's\n`--expect` help warns against it. A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
            "type": "string"
          },
          "name": {
            "description": "The ref.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "expected_old"
        ],
        "title": "RefDeleteReq",
        "type": "object"
      },
      "name": "ref_delete",
      "title": "Delete a ref"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Records a changeset from an explicit change list, on parent or else on main's head; it moves no ref.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`commit`: record a changeset from an explicit change list. It moves no ref.",
        "properties": {
          "allow_empty": {
            "default": false,
            "description": "Record the changeset even if it changes nothing.",
            "type": "boolean"
          },
          "changes": {
            "description": "What to change, relative to the parent.",
            "items": {
              "description": "One change of a commit.",
              "properties": {
                "content": {
                  "anyOf": [
                    {
                      "description": "A `put`'s content, as an object with one key.",
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "description": "UTF-8 text, verbatim.",
                          "properties": {
                            "inline": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "inline"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "Bytes in standard, padded base64.",
                          "properties": {
                            "base64": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "base64"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "A file on the client's machine. The client reads it and sends its bytes, so the store is\nnever asked to read a path.",
                          "properties": {
                            "file": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "file"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The new content, at most 512 MiB (more is `E_TOO_LARGE`); a `put` needs it, a `delete`\ntakes none."
                },
                "mode": {
                  "anyOf": [
                    {
                      "description": "The kind of entry a `put` writes.",
                      "oneOf": [
                        {
                          "const": "file",
                          "description": "A regular file (git mode 100644).",
                          "type": "string"
                        },
                        {
                          "const": "exec",
                          "description": "An executable file (git mode 100755).",
                          "type": "string"
                        },
                        {
                          "const": "symlink",
                          "description": "A symlink; the content is the link's target.",
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The kind of entry a `put` writes; `file` when omitted."
                },
                "op": {
                  "description": "Whether to write the path or remove it. What a change does to its path, in a commit's change list and a changeset's changes alike.",
                  "oneOf": [
                    {
                      "const": "put",
                      "description": "Write the content at the path, creating or replacing the entry.",
                      "type": "string"
                    },
                    {
                      "const": "delete",
                      "description": "Remove the path.",
                      "type": "string"
                    }
                  ]
                },
                "path": {
                  "description": "The repository path: `/`-separated, relative to the root.",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "op"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "message": {
            "description": "The commit message.",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "description": "A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The changeset to commit on top of. An explicit `parent` always wins; when it is omitted,\nthe current head of `main` is used if `main` exists, and otherwise the commit is a root\ncommit. `null` is the same as omitting it. Once `main` exists, this API cannot express a\nroot commit (a known M1 limitation)."
          }
        },
        "required": [
          "changes",
          "message"
        ],
        "title": "CommitReq",
        "type": "object"
      },
      "name": "commit",
      "title": "Commit a changeset"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Checks the whole store's consistency; deep re-hashes every object too.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`verify`: check the whole store's consistency.",
        "properties": {
          "deep": {
            "default": false,
            "description": "Re-hash every object. When `false`, verify checks structure only: parents, that\nreferenced objects exist, the index against the journal, and refs.",
            "type": "boolean"
          }
        },
        "title": "VerifyReq",
        "type": "object"
      },
      "name": "verify",
      "title": "Verify the store"
    }
  ],
  "ttlMs": 3600000
}
