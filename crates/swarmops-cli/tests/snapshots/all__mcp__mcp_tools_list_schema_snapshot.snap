          "base": {
            "default": "main",
            "description": "The changeset whose tree it holds. A revision as the caller wrote it, for the store to resolve: a ref name (`main`,\n`release/1.2`), a full 64-hex changeset id or a unique prefix of at least 12 hex digits,\noptionally followed by `~N` for the N-th first-parent ancestor.",
            "type": "string"
          },
          "from": {
            "description": "A directory on the caller's host whose `.worktreeinclude` names files to copy in; when\nomitted, nothing is copied.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The workspace's name: 1 to 64 of `a-z`, `0-9`, `.`, `_` and `-`, not starting with `.`.",
            "type": "string"
          },
          "path": {
            "description": "The directory to make it in, on the caller's host; when omitted, one named after it in the\nworking directory of the process that serves the call.",
            "type": [
              "string",
              "null"
            ]
          },
          "prefixes": {
            "description": "The repository paths whose subtrees are written out.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "session": {
            "description": "The hook's session, 16 hex digits; set by the Claude Code hook only.",
            "type": [
              "string",
              "null"
            ]
          },
          "status_after": {
            "default": "page",
            "description": "Whether the response carries the status after the mutation. Whether a workspace mutation's response carries the workspace's status after it.",
            "oneOf": [
              {
                "const": "page",
                "description": "The first page of the status, up to 100 changes.",
                "type": "string"
              },
              {
                "const": "none",
                "description": "No status.",
                "type": "string"
              }
            ]
          }
