[Unit]
Description=SwarmOps backup: every store, the settings and the secrets, encrypted and shipped
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/swarmops-server/jobs/backup
User=so
Group=so
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
