[Unit]
Description=SwarmOps rehearsal check: alert when no restore drill passed within the period
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/swarmops-server/jobs/rehearsal-check
User=so
Group=so
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
