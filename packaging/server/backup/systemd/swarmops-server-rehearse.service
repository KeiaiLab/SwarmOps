[Unit]
Description=SwarmOps restore drill: the newest backup restored onto an empty directory
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A new directory under this unit's own /tmp, removed with it: every run restores onto an
# empty disk. $$ is systemd's escape for one dollar sign.
ExecStart=/bin/sh -c 'exec /usr/sbin/so-backup rehearse "$$(mktemp -d)"'
User=so
Group=so
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
