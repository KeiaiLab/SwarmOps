[Unit]
Description=SwarmOps CGI runner: swarmops serve per HTTPS request
Requires=swarmops-fcgiwrap.socket
After=swarmops-fcgiwrap.socket

[Service]
ExecStart=/usr/sbin/fcgiwrap
User=so
Group=so
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/so /var/lib/swarmops-server

[Install]
Also=swarmops-fcgiwrap.socket
